/-- The initial row restricts the earlier lower bound to budget 500. -/
theorem primeSeed331_base_eq :
    ∀ h ≤ 500, primeSeed331Row0.getD h 0 = primeSeed281Row14.getD h 0 := by decide +kernel

/-- The restricted initial row remains a lower bound for the count. -/
theorem primeSeed331_base_lower :
    ∀ h ≤ 500, primeSeed331Row0.getD h 0 ≤ weightedPrimeCount id primeSeed281Weights h := by
  intro h hh
  rw [primeSeed331_base_eq h hh]
  exact primeSeed281_count_lower h (hh.trans (by decide))

/-- The kernel verifies update row 1 through budget 500. -/
theorem primeSeed331Check1 :
    weightedPrimeRowCheck 57 500 primeSeed331Row0 primeSeed331Row1 = true := by decide +kernel

/-- The kernel verifies update row 2 through budget 500. -/
