/-- The kernel verifies update row 7 through budget 500. -/
theorem primeSeed331Check7 :
    weightedPrimeRowCheck 59 500 primeSeed331Row6 primeSeed331Row7 = true := by decide +kernel

/-- Seven checked updates extend the weighted-count lower bound to the new
prime labels through 331 and budgets through 500. -/
theorem primeSeed331_lower :
    ∀ h ≤ 500,
      primeSeed331Row7.getD h 0 ≤
        weightedPrimeCount id ([59, 58, 58, 58, 58, 57, 57] ++ primeSeed281Weights) h := by
  have h0 := primeSeed331_base_lower
  have h1 :=
    weightedPrimeRow_lower 57 500 (primeSeed281Weights) primeSeed331Row0 primeSeed331Row1
      primeSeed331Check1 h0
  have h2 :=
    weightedPrimeRow_lower 57 500 (57 :: primeSeed281Weights) primeSeed331Row1 primeSeed331Row2
      primeSeed331Check2 h1
  have h3 :=
    weightedPrimeRow_lower 58 500 (57 :: 57 :: primeSeed281Weights) primeSeed331Row2
      primeSeed331Row3 primeSeed331Check3 h2
  have h4 :=
    weightedPrimeRow_lower 58 500 (58 :: 57 :: 57 :: primeSeed281Weights) primeSeed331Row3
      primeSeed331Row4 primeSeed331Check4 h3
  have h5 :=
    weightedPrimeRow_lower 58 500 (58 :: 58 :: 57 :: 57 :: primeSeed281Weights) primeSeed331Row4
      primeSeed331Row5 primeSeed331Check5 h4
  have h6 :=
    weightedPrimeRow_lower 58 500 (58 :: 58 :: 58 :: 57 :: 57 :: primeSeed281Weights)
      primeSeed331Row5 primeSeed331Row6 primeSeed331Check6 h5
  have h7 :=
    weightedPrimeRow_lower 59 500 (58 :: 58 :: 58 :: 58 :: 57 :: 57 :: primeSeed281Weights)
      primeSeed331Row6 primeSeed331Row7 primeSeed331Check7 h6
  exact h7

