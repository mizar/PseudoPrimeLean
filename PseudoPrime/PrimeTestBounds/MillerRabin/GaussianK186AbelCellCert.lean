/-- All three fixed intervals in the far Abel residual have certified
integral caps, using the midpoint affine rows and analytic decay. -/
public theorem k186_abel_finite_caps :
    let B := HighGaussianKernel.k186.realProfile
    let Q := Polynomial.C (9 / 4 : ℝ) * B - B.derivative
    let D := Polynomial.C (9 / 4 : ℝ) * Q - Q.derivative
    let f := fun v ↦ Real.exp (-(11 / 4 : ℝ) * v) * |D.eval v|
    (∫ v in (35 : ℝ)..65, f v) ≤ 2299 ∧
      (∫ v in (5 : ℝ)..35, f v) ≤ 59000 ∧ (∫ v in (0 : ℝ)..5, f v) ≤ 67000 := by
  exact
    ⟨abel_interval_35_65.trans (by norm_num only), abel_interval_5_35.trans (by norm_num only),
      abel_interval_0_5.trans (by norm_num only)⟩

