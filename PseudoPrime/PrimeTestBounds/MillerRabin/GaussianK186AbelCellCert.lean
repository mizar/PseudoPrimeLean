/-- Check the integer integral cap on the cell from 13 to 17. -/
private theorem abel_cell_13_17 : (∫ v in (13 : ℝ)..17, abelWeight v) ≤ 28 := by
  have hc : abelCellCheck 13 17 35 28 := by decide +kernel
