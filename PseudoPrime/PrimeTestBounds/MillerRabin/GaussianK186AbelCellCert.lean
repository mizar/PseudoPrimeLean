/-- The integer second-derivative identity connects the numerical row to
the physical Abel polynomial without reconstructing the physical profile. -/
private theorem abel_d_row_poly :
    (abelDRow.poly 83).map (Rat.castHom ℝ) =
      Polynomial.C ((9 / 4 : ℝ) ^ 2) * HighGaussianKernel.k186.realProfile -
          Polynomial.C (9 / 2 : ℝ) * HighGaussianKernel.k186.realProfile.derivative +
        HighGaussianKernel.k186.realProfile.derivative.derivative := by
  have hm : baseRow.secondMatches 83 9 4 abelDRow = true := by decide +kernel
  have h :=
    MiddleIntRow.poly_of_secondMatches (p := baseRow) (q := abelDRow) (by decide)
      (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) hm
  rw [base_row_poly] at h
  rw [h]
  simp only [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C,
    ← Polynomial.derivative_map, high_comp_profile_map, Rat.coe_castHom, Rat.cast_div, Rat.cast_mul,
    Rat.cast_pow, Rat.cast_ofNat, Int.cast_ofNat, show (2 : ℝ) * (9 / 4) = 9 / 2 by norm_num only]

/-- One integer comparison checks the affine coefficient sum and
the exponential factor `(10/27) ^ e` for a cell. -/
private def abelCellCheck (l u e : ℕ) (cap : ℤ) : Prop :=
  let A := abelDRow.affine 83 ((l : ℤ) + u) ((u : ℤ) - l) 2
  ((u : ℤ) - l) * (∑ i ∈ Finset.range 84, |A.num i|) * 10 ^ e ≤ cap * A.den * 27 ^ e

private instance (l u e : ℕ) (cap : ℤ) : Decidable (abelCellCheck l u e cap) := by
  unfold abelCellCheck
  infer_instance

/-- The second-order profile used by the Abel remainder integrals. -/
private noncomputable def abelWeight (v : ℝ) : ℝ :=
  let B := HighGaussianKernel.k186.realProfile
  let Q := Polynomial.C (9 / 4 : ℝ) * B - B.derivative
  let D := Polynomial.C (9 / 4 : ℝ) * Q - Q.derivative
  Real.exp (-(11 / 4 : ℝ) * v) * |D.eval v|

/-- Interpret one successful integer comparison as an integral cap. -/
private theorem abel_cell_le {l u e : ℕ} {cap : ℤ} (hlu : l < u) (he : (e : ℝ) ≤ (11 / 4 : ℝ) * l)
    (hc : abelCellCheck l u e cap) : (∫ v in (l : ℝ)..(u : ℝ), abelWeight v) ≤ (cap : ℝ) := by
  let B := HighGaussianKernel.k186.realProfile
  let Q := Polynomial.C (9 / 4 : ℝ) * B - B.derivative
  let D := Polynomial.C (9 / 4 : ℝ) * Q - Q.derivative
  have h :=
    abel_int_cell_of_check abelDRow 83 (l := (l : ℤ)) (u := (u : ℤ)) (e := e) (s := 11 / 4)
      (by decide +kernel) (Int.ofNat_lt.mpr hlu) (by norm_num only)
      (by simpa only [Int.cast_natCast] using he) hc
  dsimp only at h
  have hD : (abelDRow.poly 83).map (Rat.castHom ℝ) = D := by
    rw [abel_d_row_poly]
    simp only [D, Q, Polynomial.derivative_sub, Polynomial.derivative_C_mul, mul_sub, ← mul_assoc,
      ← Polynomial.C_mul]
    rw [show (9 / 4 : ℝ) ^ 2 = (9 / 4) * (9 / 4) by ring,
      show (9 / 2 : ℝ) = 9 / 4 + 9 / 4 by norm_num only, Polynomial.C_add, add_mul]
    abel
  rw [hD] at h
  simpa only [Int.cast_natCast, abelWeight, B, Q, D] using h

/-- Adjacent weighted integral caps add. -/
private theorem abel_join {a b c A C : ℝ} (hA : (∫ v in a..b, abelWeight v) ≤ A)
    (hC : (∫ v in b..c, abelWeight v) ≤ C) : (∫ v in a..c, abelWeight v) ≤ A + C := by
  have h : Continuous abelWeight :=
    (Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
      (Polynomial.continuous _).abs
  rw [←
    intervalIntegral.integral_add_adjacent_intervals (h.intervalIntegrable a b)
      (h.intervalIntegrable b c)]
  exact add_le_add hA hC

/-- Check the integer integral cap on the cell from 0 to 2. -/
private theorem abel_cell_0_2 : (∫ v in (0 : ℝ)..2, abelWeight v) ≤ 2188 := by
  have hc : abelCellCheck 0 2 0 2188 := by decide +kernel
  simpa only [Nat.cast_zero, Nat.cast_ofNat, Int.cast_ofNat] using
    abel_cell_le (by decide) (by norm_num only) hc

/-- Check the integer integral cap on the cell from 2 to 5. -/
private theorem abel_cell_2_5 : (∫ v in (2 : ℝ)..5, abelWeight v) ≤ 14004 := by
  have hc : abelCellCheck 2 5 5 14004 := by decide +kernel
  simpa only [Nat.cast_zero, Nat.cast_ofNat, Int.cast_ofNat] using
    abel_cell_le (by decide) (by norm_num only) hc

/-- Sum the checked cells on the full interval from 0 to 5. -/
private theorem abel_interval_0_5 : (∫ v in (0 : ℝ)..5, abelWeight v) ≤ 16192 := by
  have h := abel_join (abel_cell_0_2) abel_cell_2_5
  norm_num only at h
  exact h

/-- Check the integer integral cap on the cell from 5 to 9. -/
private theorem abel_cell_5_9 : (∫ v in (5 : ℝ)..9, abelWeight v) ≤ 19424 := by
  have hc : abelCellCheck 5 9 13 19424 := by decide +kernel
  simpa only [Nat.cast_zero, Nat.cast_ofNat, Int.cast_ofNat] using
    abel_cell_le (by decide) (by norm_num only) hc

/-- Check the integer integral cap on the cell from 9 to 13. -/
private theorem abel_cell_9_13 : (∫ v in (9 : ℝ)..13, abelWeight v) ≤ 257 := by
  have hc : abelCellCheck 9 13 24 257 := by decide +kernel
  simpa only [Nat.cast_zero, Nat.cast_ofNat, Int.cast_ofNat] using
