-- Check that the retained indices agree with the established fixed power set.
/-- The checked power mass at radius 330 is at least the sum of its integer credits. -/
theorem quarter_power_gain_330 :
    (143227796 / 1000000000 : ℝ) ≤
      ∑ k ∈ fixedPowers663,
        4 * (quarterKernel656.summand (1 : DirichletCharacter ℂ 1) ((330 : ℝ) ^ 2) k).re := by
  let rows := powers330.toFinset
  have hL :=
    (Analysis.rationalLogIntervalCheck_sound (N := 330) (j := 8) (n := 27) (lo :=
        5799092652 / 1000000000) (hi := 5799092657 / 1000000000) (by decide +kernel)).1
  simp only [Rat.cast_ofNat] at hL
  have h :=
    Finset.sum_le_sum (s := rows)
      (fun a ha ↦
        PowerRow656.sound a (by norm_num only : (0 : ℝ) < (330 : ℕ)) hL
          (powers330_valid a (List.mem_toFinset.mp ha)))
  rw [← Finset.sum_div, ← Nat.cast_sum] at h
  have hc : (∑ a ∈ rows, a.credit) = 143227796 := by decide +kernel
  rw [hc, Nat.cast_ofNat] at h
  have hset : rows.image (fun a ↦ a.p ^ a.k) = fixedPowers663 := by decide +kernel
  have hcard : (rows.image (fun a ↦ a.p ^ a.k)).card = rows.card := by decide +kernel
  have hinj := Finset.injOn_of_card_image_eq hcard
  rw [← hset, Finset.sum_image (fun _ ha _ hb hab ↦ hinj ha hb hab)]
  norm_num only at h ⊢
  exact h

/-- The fixed power set including the square of 331 stays strictly above
the cutoff through radius 330 and within the supported range. -/
theorem quarter_bridge_power_support_660 {r : ℝ} (hr : r ∈ Set.Icc 329 330) {n : ℕ}
    (hn : n ∈ fixedPowers656 true) : r ^ 2 < (n : ℝ) ∧ Real.log ((n : ℝ) / r ^ 2) ≤ 21 / 8 := by
  have hn' : ∀ k ∈ fixedPowers656 true, 108900 < k := by decide +kernel
  have hlo : (108900 : ℝ) < n := by exact_mod_cast hn' n hn
  have hr₀ := (by norm_num only : (0 : ℝ) < 329).trans_le hr.1
  have hpow := pow_le_pow_left₀ hr₀.le hr.2 2
  have hcut : r ^ 2 < (n : ℝ) := by linarith only [hpow, hlo]
  have hs :=
    fixed_power_support_656 true (r := 325)
      (by norm_num only [ite_true, Set.mem_Icc, le_refl, true_and]) hn
  have hden : (325 : ℝ) ^ 2 ≤ r ^ 2 :=
    pow_le_pow_left₀ (by norm_num only) ((by norm_num only : (325 : ℝ) ≤ 329).trans hr.1) 2
  have hn₀ := (sq_nonneg r).trans_lt hcut
  exact
    ⟨hcut,
      (Real.log_le_log (div_pos hn₀ (sq_pos_of_pos hr₀))
            (div_le_div_of_nonneg_left hn₀.le (by norm_num only) hden)).trans
        hs.2.le⟩

private theorem bridge_power_transfer {K : Finset ℕ} {l r C : ℝ} (hl : 0 < l) (hr : l ≤ r)
    (hcut : ∀ n ∈ K, r ^ 2 < (n : ℝ)) (hs : ∀ n ∈ K, Real.log ((n : ℝ) / l ^ 2) ≤ 21 / 8)
    (hc : C ≤ ∑ n ∈ K, 4 * (quarterKernel656.summand (1 : DirichletCharacter ℂ 1) (l ^ 2) n).re) :
    C ≤ ∑ n ∈ K, 4 * (ArithmeticFunction.vonMangoldt n * quarterWeight656 (r ^ 2) n) := by
  refine hc.trans (Finset.sum_le_sum fun n hn ↦ ?_)
  rw [quarter_summand_656 (sq_pos_of_pos hl) (Nat.cast_pos.mp ((sq_nonneg r).trans_lt (hcut n hn)))
      (hs n hn),
    mul_comm (quarterWeight656 (l ^ 2) n)]
  exact
    mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left (weight_radius_mono hl hr (hcut n hn).le (hs n hn))
        ArithmeticFunction.vonMangoldt_nonneg)
      (by norm_num only)

/-- Transfer the radius-329 power credit throughout the second bridge cell. -/
theorem quarter_bridge_power_gain_660 {r : ℝ} (hr : r ∈ Set.Icc 329 330) :
    (148471687 / 1000000000 : ℝ) ≤
      ∑ n ∈ fixedPowers656 true,
        4 * (ArithmeticFunction.vonMangoldt n * quarterWeight656 (r ^ 2) n) :=
  bridge_power_transfer (by norm_num only) hr.1
    (fun _ hn ↦ (quarter_bridge_power_support_660 hr hn).1)
    (fun _ hn ↦ (quarter_bridge_power_support_660 ⟨le_rfl, by norm_num only⟩ hn).2)
    quarter_power_gain_329

/-- Transfer the radius-330 power credit throughout the last bridge cell. -/
theorem quarter_bridge_power_gain_663 {r : ℝ} (hr : r ∈ Set.Icc 330 (663 / 2)) :
    (143227796 / 1000000000 : ℝ) ≤
      ∑ n ∈ fixedPowers663, 4 * (ArithmeticFunction.vonMangoldt n * quarterWeight656 (r ^ 2) n) :=
  bridge_power_transfer (by norm_num only) hr.1
    (fun _ hn ↦ (fixed_power_support_663 ⟨by linarith only [hr.1], hr.2⟩ hn).1)
    (fun _ hn ↦ (fixed_power_support_663 (r := 330) ⟨by norm_num only, by norm_num only⟩ hn).2.le)
    quarter_power_gain_330

