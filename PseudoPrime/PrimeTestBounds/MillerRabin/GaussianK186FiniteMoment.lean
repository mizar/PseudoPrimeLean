/-- The recurrence checks all coefficients against the existing profile row. -/
private theorem finite_moment_matches : baseRow.momentMatches 83 9 4 finiteMomentRow = true := by
  decide +kernel

/-- The checked row represents the signed Laplace factors for the prefix. -/
private theorem finite_moment_poly :
    finiteMomentRow.poly 83 = middleMomentPoly HighGaussianKernel.k186.ratProfile (9 / 4) 0 := by
  have h :=
    MiddleIntRow.poly_of_momentMatches (p := baseRow) (m := finiteMomentRow) (by decide) (by decide)
      (by decide +kernel) (by decide +kernel) (by decide +kernel) finite_moment_matches
  rw [base_row_poly] at h
  simpa only [Int.cast_ofNat] using h

/-- Directed Horner bounds at the two endpoints suffice for the prefix. -/
private theorem finite_moment_caps :
    let M := middleMomentPoly HighGaussianKernel.k186.ratProfile (9 / 4) 0
    (5500 : ℝ) ≤ (M.eval 0 : ℚ) ∧ (M.eval 35 : ℚ) ≤ (74 * 10 ^ 36 : ℝ) := by
  let M := middleMomentPoly HighGaussianKernel.k186.ratProfile (9 / 4) 0
  have hden : 0 < finiteMomentRow.den := by decide +kernel
  have ha := (finiteMomentRow.eval_interval_contains 83 0 1 hden (by decide)).1
  have hb := (finiteMomentRow.eval_interval_contains 83 35 1 hden (by decide)).2
  rw [finite_moment_poly] at ha hb
  norm_num only [Int.cast_zero, Int.cast_ofNat, Int.cast_one, div_one] at ha hb
  have hzero := Polynomial.eval_map_apply (p := M) (Rat.castHom ℝ) (0 : ℚ)
  have hval := Polynomial.eval_map_apply (p := M) (Rat.castHom ℝ) (35 : ℚ)
  norm_num only [Rat.coe_castHom, Rat.cast_zero, Rat.cast_ofNat] at hzero hval
  rw [hzero] at ha
  rw [hval] at hb
  have hlo :
    (5500 : ℚ) ≤ ((finiteMomentRow.evalInterval 83 0 1).lower : ℚ) / finiteMomentRow.den := by
    decide +kernel
  have hhi :
    ((finiteMomentRow.evalInterval 83 35 1).upper : ℚ) / finiteMomentRow.den ≤
      (74 * 10 ^ 36 : ℚ) := by
    decide +kernel
  refine ⟨?_, ?_⟩
  · have h :
      (5500 : ℝ) ≤ ((finiteMomentRow.evalInterval 83 0 1).lower : ℝ) / finiteMomentRow.den := by
      simpa only [Rat.cast_div, Rat.cast_intCast, Rat.cast_ofNat] using
        (Rat.cast_le (K := ℝ)).mpr hlo
    exact h.trans ha
  · exact
      hb.trans
        (by
          simpa only [Rat.cast_div, Rat.cast_intCast, Rat.cast_mul, Rat.cast_pow,
            Rat.cast_ofNat] using (Rat.cast_le (K := ℝ)).mpr hhi)

/-- The endpoint exponential has a small rational upper bound. -/
private theorem finite_moment_exp_le : Real.exp (-(9 / 4 : ℝ) * 35) ≤ 7 / 10 ^ 35 := by
  have h := negative_endpoint_exp_upper_valid (by norm_num only : (0 : ℚ) ≤ 315 / 4)
  have hc : negativeEndpointExpUpper (315 / 4) ≤ 7 / 10 ^ 35 := by decide +kernel
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he : -(9 / 4 : ℝ) * 35 = -(315 / 4 : ℝ) := by norm_num only
  rw [he]
  exact
    h.trans
      (by
        simpa only [Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using (Rat.cast_le (K := ℝ)).mpr hc)

/-- The rate-nine-quarters prefix convolution at 35 is nonnegative.
The two signed tails use Horner evaluations of a single verified row. -/
public theorem k186_gamma_j_prefix_nonneg :
    0 ≤
      ∫ t in (0 : ℝ)..35,
        HighGaussianKernel.k186.realProfile.eval t * Real.exp (-(9 / 4 : ℝ) * t) := by
  let P := HighGaussianKernel.k186.ratProfile
  let B := HighGaussianKernel.k186.realProfile
  let f := fun t : ℝ ↦ B.eval t * Real.exp (-(9 / 4 : ℝ) * t)
  have hf : MeasureTheory.IntegrableOn f (Set.Ioi (0 : ℝ)) := by
    apply
      (abs_laplace_integrable_and_le B (by norm_num only : (0 : ℝ) < 9 / 4)).1.mono'
        (B.continuous.mul
            (Real.continuous_exp.comp (continuous_const.mul continuous_id))).aestronglyMeasurable
    exact
      Filter.Eventually.of_forall fun t ↦ by
        change ‖B.eval t * Real.exp (-(9 / 4 : ℝ) * t)‖ ≤ _
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (Real.exp_nonneg _), mul_comm]
  have ha := signed_tail_factor_eq P (s := 9 / 4) (by norm_num only) 0
  have hb := signed_tail_factor_eq P (s := 9 / 4) (by norm_num only) 35
  simp only [signed_tail_factor_moment, P, high_comp_profile_map, Rat.cast_div, Rat.cast_zero,
    Rat.cast_ofNat, mul_zero, Real.exp_zero, one_mul] at ha hb
  have ht := intervalIntegral.integral_Ioi_sub_Ioi hf (by norm_num only : (0 : ℝ) ≤ 35)
  have hcap := finite_moment_caps
  dsimp only at hcap
  have hU : Real.exp (-(9 / 4 : ℝ) * 35) * ((middleMomentPoly P (9 / 4) 0).eval 35 : ℚ) ≤ 5180 := by
    refine (mul_le_mul_of_nonneg_left hcap.2 (Real.exp_nonneg _)).trans ?_
    exact
      (mul_le_mul_of_nonneg_right finite_moment_exp_le
            (by norm_num only : (0 : ℝ) ≤ 74 * 10 ^ 36)).trans_eq
        (by norm_num only)
  dsimp only [f, B, P] at ht hU
  linarith only [ha, hb, ht, hcap.1, hU]

end PseudoPrime.PrimeTestBounds.MillerRabin
