/-- Sum the rounded contributions after verifying that the rows give
each index in the selected set exactly once. -/
private theorem power_rows_sum (right : Bool) (rows : Finset PowerRow656) {r : ℕ} {L : ℚ}
    (hr : 0 < (r : ℝ)) (hL : (L : ℝ) ≤ Real.log r) (hrows : ∀ a ∈ rows, a.Valid r L)
    (hset : rows.image (fun a ↦ a.p ^ a.k) ⊆ fixedPowers656 right)
    (hcard : (rows.image (fun a ↦ a.p ^ a.k)).card = rows.card) :
    ((∑ a ∈ rows, a.credit : ℕ) : ℝ) / 1000000000 ≤ fixedPowerGain656 right r := by
  have hinj := Finset.injOn_of_card_image_eq hcard
  have h := Finset.sum_le_sum (fun a ha ↦ PowerRow656.sound a hr hL (hrows a ha))
  rw [← Finset.sum_div, ← Nat.cast_sum] at h
  unfold fixedPowerGain656
  rw [Finset.mul_sum]
  have hb :=
    Finset.sum_le_sum_of_subset_of_nonneg hset (f := fun m ↦
      4 * (quarterKernel656.summand (1 : DirichletCharacter ℂ 1) ((r : ℝ) ^ 2) m).re)
      (fun m _ _ ↦
        mul_nonneg (by norm_num only)
          (quarterKernel656.principal_summand_re_nonneg (sq_pos_of_pos hr) m))
  rw [Finset.sum_image (fun _ ha _ hb he ↦ hinj ha hb he)] at hb
  exact h.trans hb

