import all PseudoPrime.PrimeTestBounds.MillerRabin.QuarterPowerSupport656

/-! # Certified endpoint sums of fixed prime powers in section 132 -/

public section

namespace PseudoPrime.PrimeTestBounds.MillerRabin

/-- Fixed-point data for the logarithm, profile argument, exponential, square
root and contribution of one prime power at the chosen endpoint. -/
private structure PowerRow656 where
  p : ℕ
  k : ℕ
  shift : ℕ
  logLo : ℕ
  logHi : ℕ
  argLo : ℕ
  expLo : ℕ
  rootHi : ℕ
  credit : ℕ
  deriving DecidableEq

/-- Check all of the rational inequalities needed for a single endpoint row. -/
private def PowerRow656.Valid (r : ℕ) (L : ℚ) (a : PowerRow656) : Prop :=
  a.p.Prime ∧
    a.k ≠ 0 ∧
      r ^ 2 ≤ a.p ^ a.k ∧
        Analysis.rationalLogIntervalCheck a.p a.shift 27 (a.logLo / 1000000000)
              (a.logHi / 1000000000) =
            true ∧
          let z : ℚ := a.argLo / 1000000000
          let e : ℚ := a.expLo / 1000000000
          let s : ℚ := a.rootHi / 1000
          (a.p ^ a.k : ℕ) ≤ s ^ 2 ∧
            z ≤ (11 / 10) * (21 / 8 - (a.k * (a.logHi / 1000000000) - 2 * L)) ∧
            z / 17 ≤ 1 / 2 ∧
            e *
                ((∑ i ∈ Finset.range 16, z ^ i / (i.factorial : ℚ)) +
                  z ^ 16 / ((16 : ℕ).factorial : ℚ) * 2) ≤
              1 ∧
            (a.credit : ℚ) / 1000000000 ≤ 4 * ((a.logLo / 1000000000) / s) * (z ^ 5 * e / 120)

private instance (r : ℕ) (L : ℚ) (a : PowerRow656) : Decidable (a.Valid r L) := by
  unfold PowerRow656.Valid
  infer_instance

/-- Interpret a checked rational row as a lower bound on its principal summand. -/
private theorem PowerRow656.sound {r : ℕ} {L : ℚ} (a : PowerRow656) (hr : 0 < (r : ℝ))
    (hL : (L : ℝ) ≤ Real.log r) (h : a.Valid r L) :
    (a.credit : ℝ) / 1000000000 ≤
      4 * (quarterKernel656.summand (1 : DirichletCharacter ℂ 1) ((r : ℝ) ^ 2) (a.p ^ a.k)).re := by
  obtain ⟨hp, hk, hcut, hlog, hroot, harg, ht, he, hc⟩ := h
  have h :=
    quarter_power_rational_lower_656 hp hk hr (by exact_mod_cast hcut) hL hlog (by positivity)
      (by positivity) (by positivity) hroot harg ht he hc
  simpa only [Rat.cast_div, Rat.cast_natCast, Rat.cast_ofNat] using h

