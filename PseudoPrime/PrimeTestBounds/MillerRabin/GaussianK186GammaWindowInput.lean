/-- Check the stored row against the exact integer translation. -/
private theorem gamma_window_nums_eq : gammaWindowRow.nums = gammaWindowNumerators := by
  decide +kernel

/-- The shared denominator of the translated integer coefficients. -/
public def k186WindowDen : ℤ :=
  gammaWindowRow.den

/-- The integer numerator at a single index of the translated K186 profile. -/
public def k186WindowCoeff (i : ℕ) : ℤ :=
  gammaWindowNumerators[i]?.getD 0

/-- The common scale of the translated profile is positive. -/
public theorem k186_window_den_pos : 0 < k186WindowDen := by
  change 0 < baseRow.den * (1 : ℤ) ^ 83
  exact mul_pos (by decide +kernel) (pow_pos zero_lt_one _)

/-- The integer window row represents the translated physical profile. -/
private theorem gamma_window_row_eq :
    (gammaWindowRow.poly 83).map (Rat.castHom ℝ) =
      HighGaussianKernel.k186.realProfile.comp (Polynomial.X + Polynomial.C 35) := by
  have h := baseRow.poly_shift 83 35 1 (by decide +kernel) (by decide)
  rw [base_row_poly] at h
  simp only [Int.cast_ofNat, Int.cast_one, div_one] at h
  rw [gammaWindowRow, h, Polynomial.map_comp, high_comp_profile_map]
  simp only [Polynomial.map_add, Polynomial.map_X, Polynomial.map_C, Rat.coe_castHom,
    Rat.cast_ofNat]

/-- A scalar coefficient of the real translated profile equals the checked
integer numerator divided by the shared denominator. -/
public theorem k186_window_coeff_eq {i : ℕ} (hi : i ≤ 83) :
    (HighGaussianKernel.k186.realProfile.comp (Polynomial.X + Polynomial.C 35)).coeff i =
      (k186WindowCoeff i : ℝ) / k186WindowDen := by
  rw [← gamma_window_row_eq, Polynomial.coeff_map, gammaWindowRow.poly_coeff hi]
  simp only [Rat.coe_castHom, Rat.cast_div, Rat.cast_intCast, k186WindowCoeff, k186WindowDen,
    MiddleIntRow.num, gamma_window_nums_eq]

end PseudoPrime.PrimeTestBounds.MillerRabin
