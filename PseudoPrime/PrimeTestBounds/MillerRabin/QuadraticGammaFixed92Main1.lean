/-- A rational lower cap for the finite main sum through 919. -/
def gammaFixed92Main71Lower : ℚ :=
  19212827 / 1000000

set_option maxRecDepth 8192 in
/-- Every rounded endpoint is valid for its corresponding prime-power row.
The list checker also proves that the endpoint and support lengths agree. -/
theorem gammaFixed92Main71_exp_check :
    gammaMainListCheck gammaMainCell92Scale (centerRowsBelow 919) gammaFixed92Main71Exp = true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The rational weighted aggregate of the checked endpoints exceeds its cap.
Kernel reduction verifies the finite sum for cutoff 919. -/
theorem gammaFixed92Main71_sum_check :
    gammaFixed92Main71Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell92Radius) (centerRowsBelow 919)
          gammaFixed92Main71Exp).sum := by
  decide +kernel

/-- The actual normalized main sum exceeds the checked rational cap at the
fixed scale. The support and row soundness transfer each verified endpoint. -/
theorem gammaFixed92Main71_actual_lower :
    (gammaFixed92Main71Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 919,
        Real.exp (-(n : ℝ) / (gammaMainCell92Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell92Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 919 ≤ 50000) gammaFixed92Main71Exp
      gammaMainCell92_scale_check.1 gammaMainCell92_scale_check.2.1 gammaMainCell92_scale_check.2.2
      (gammaMainListCheck_sound gammaFixed92Main71_exp_check) gammaFixed92Main71_sum_check

