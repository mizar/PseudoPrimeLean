import Mathlib.Tactic.NormNum

/-! # Cutoff scales for the 166 compressed Gaussian intervals -/

public section

namespace PseudoPrime.PrimeTestBounds.MillerRabin

private structure CutoffRow where
  leftNum : ℕ
  leftDen : ℕ
  rightNum : ℕ
  rightDen : ℕ
  scaleNum : ℕ
  scaleDen : ℕ
  terms : List ℕ

private def CutoffRow.term (row : CutoffRow) (j : ℕ) : ℕ :=
  row.terms[j]?.getD 0

private def CutoffRow.Valid (row : CutoffRow) : Prop :=
  0 < row.leftDen ∧ 0 < row.rightDen ∧ 0 < row.scaleDen ∧
    663 * row.leftDen ≤ row.leftNum ∧ row.term 0 = 1000000000000000000 ∧
    (∀ j : Fin 6, (11000 * row.leftDen) ^ 2 * (j.val + 1) * row.term (j.val + 1) ≤
      row.leftNum ^ 2 * row.term j.val) ∧
    (let S := ∑ j ∈ Finset.range 7, row.term j
     row.scaleNum ^ 2 * 33659 * row.leftNum * S +
       53 * 33659 * row.scaleDen ^ 2 * row.leftDen * 1000000000000000000 ≤
       36360 * row.scaleDen ^ 2 * row.leftNum * S)

private instance (row : CutoffRow) : Decidable row.Valid :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))

