private def rows : List CutoffRow :=
  rowsPart0 ++ rowsPart1 ++ rowsPart2 ++ rowsPart3 ++ rowsPart4 ++ rowsPart5 ++ rowsPart6

private theorem rows_length : rows.length = 166 := by decide +kernel

private theorem rows_part0_valid : rowsPart0.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part1_valid : rowsPart1.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part2_valid : rowsPart2.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part3_valid : rowsPart3.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part4_valid : rowsPart4.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part5_valid : rowsPart5.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

private theorem rows_part6_valid : rowsPart6.all (fun row ↦ decide row.Valid) = true := by
  decide +kernel

/-- Each checked group contributes valid cutoff rows. -/
private theorem rows_valid : rows.all (fun row ↦ decide row.Valid) = true := by
  simp only [rows, List.all_append, rows_part0_valid, rows_part1_valid, rows_part2_valid,
    rows_part3_valid, rows_part4_valid, rows_part5_valid, rows_part6_valid, Bool.and_self]

private def rowAt (i : Fin 166) : CutoffRow :=
  rows.get ⟨i.val, i.isLt.trans_eq rows_length.symm⟩

/-- The left endpoint of the indexed interval in the compressed Gaussian prefix. -/
noncomputable def gaussianCompressedLeft (i : Fin 166) : ℝ :=
  (rowAt i).leftNum / ((rowAt i).leftDen : ℝ)

/-- The right endpoint of the indexed interval in the compressed Gaussian prefix. -/
noncomputable def gaussianCompressedRight (i : Fin 166) : ℝ :=
  (rowAt i).rightNum / ((rowAt i).rightDen : ℝ)

/-- The rational multiplier of the half-logarithm on the indexed interval. -/
noncomputable def gaussianCompressedScale (i : Fin 166) : ℝ :=
  (rowAt i).scaleNum / ((rowAt i).scaleDen : ℝ)

/-- Every saved multiplier in the compressed Gaussian prefix gives a
squared cutoff at most the Gaussian witness cutoff from its left endpoint on. -/
theorem gaussian_compressed_cutoff (i : Fin 166) {L : ℝ} (hL : gaussianCompressedLeft i ≤ L) :
    (gaussianCompressedScale i * L / 2) ^ 2 ≤ gaussianWitnessCutoff L := by
  have hm : rowAt i ∈ rows := List.get_mem rows _
  have h := of_decide_eq_true (List.all_eq_true.mp rows_valid _ hm)
  have ha : (663 : ℝ) ≤ gaussianCompressedLeft i := by
    apply (le_div_iff₀ (Nat.cast_pos.mpr h.1)).mpr
    exact_mod_cast h.2.2.2.1
  exact
    gaussian_cutoff_of_mul_cert (rowAt i).term h.1 h.2.2.1 (by decide) h.2.2.2.2.1
      (fun j hj ↦ h.2.2.2.2.2.1 ⟨j, hj⟩) h.2.2.2.2.2.2 ha hL

/-- The consecutive endpoints agree in both numerator and denominator. -/
private def rowJoin (p : CutoffRow × CutoffRow) : Bool :=
  p.1.rightNum == p.2.leftNum && p.1.rightDen == p.2.leftDen

/-- Check the adjacent rows by traversing the compressed table once. -/
private theorem rows_join_check : (rows.zip rows.tail).all rowJoin = true := by decide +kernel

private theorem rows_join (i : Fin 165) :
    let a := rowAt ⟨i.val, i.isLt.trans (by decide)⟩
    let b := rowAt ⟨i.val + 1, Nat.succ_lt_succ i.isLt⟩
    a.rightNum = b.leftNum ∧ a.rightDen = b.leftDen := by
  have hi : i.val < (rows.zip rows.tail).length := by
    simpa only [List.length_zip, List.length_tail, rows_length, Nat.reduceSub, min_def,
      Nat.reduceLeDiff, ite_false] using i.isLt
  have h := List.all_eq_true.mp rows_join_check _ (List.getElem_mem hi)
  rw [List.getElem_zip, List.getElem_tail] at h
  simpa only [rowJoin, Bool.and_eq_true, beq_iff_eq, rowAt, List.get_eq_getElem] using h

private theorem compressed_join (i : ℕ) (hi : i < 165) :
    gaussianCompressedRight ⟨i, hi.trans (by decide)⟩ =
      gaussianCompressedLeft ⟨i + 1, Nat.succ_lt_succ hi⟩ := by
  obtain ⟨hn, hd⟩ := rows_join ⟨i, hi⟩
  unfold gaussianCompressedRight gaussianCompressedLeft
  rw [hn, hd]

private theorem compressed_cover_to {L : ℝ} (hL : 663 ≤ L) (k : ℕ) (hk : k < 166)
    (hR : L ≤ gaussianCompressedRight ⟨k, hk⟩) :
    ∃ i, gaussianCompressedLeft i ≤ L ∧ L ≤ gaussianCompressedRight i := by
  induction k with
  | zero =>
    refine ⟨⟨0, hk⟩, ?_, hR⟩
    change ((663 : ℕ) : ℝ) / ((1 : ℕ) : ℝ) ≤ L
    simpa only [Nat.cast_ofNat, Nat.cast_one, div_one] using hL
  | succ k ih =>
    have hk' : k < 165 := Nat.lt_of_succ_lt_succ hk
    by_cases h : L ≤ gaussianCompressedRight ⟨k, hk'.trans (by decide)⟩
    · exact ih _ h
    · exact ⟨⟨k + 1, hk⟩, (compressed_join k hk') ▸ le_of_not_ge h, hR⟩

/-- Every logarithm in the compressed Gaussian prefix belongs to a certified
cell. The first and last endpoints and all adjacent joins are checked exactly. -/
theorem gaussian_compressed_cover {L : ℝ} (hL : 663 ≤ L) (hR : L ≤ 9055 / 4) :
    ∃ i, gaussianCompressedLeft i ≤ L ∧ L ≤ gaussianCompressedRight i := by
  exact compressed_cover_to hL 165 (by decide) hR

/-- Every logarithm in the compressed prefix admits a covering interval whose
squared witness scale fits below the Gaussian cutoff. -/
theorem gaussian_compressed_scale_exists {L : ℝ} (hL : 663 ≤ L) (hR : L ≤ 9055 / 4) :
    ∃ i,
      gaussianCompressedLeft i ≤ L ∧
        L ≤ gaussianCompressedRight i ∧
        (gaussianCompressedScale i * L / 2) ^ 2 ≤ gaussianWitnessCutoff L := by
  obtain ⟨i, ha, hb⟩ := gaussian_compressed_cover hL hR
  exact ⟨i, ha, hb, gaussian_compressed_cutoff i ha⟩

end PseudoPrime.PrimeTestBounds.MillerRabin
