-- Reduction checks the weighted recurrence for fifteen labels and 181 budgets.
set_option maxRecDepth 65536 in
set_option maxHeartbeats 0 in
-- The complete finite table contains sixteen arrays of 181 entries.
/-- The rational weighted count table satisfies the exact recurrence. -/
theorem target028_fine47_checked :
    weightedPrimeTableCheck 180 target028Fine47Weights (target028Fine47Row :: target028Fine47Tail) =
      true := by
  decide +kernel

/-- The prime labels are distinct and carry the listed positive weights. -/
theorem target028_fine47_labels :
    target028FifteenPrimes.Nodup ∧
      target028FifteenPrimes.map target028Fine47Weight = target028Fine47Weights ∧
      ∀ p ∈ target028FifteenPrimes, 0 < target028Fine47Weight p := by
  decide +kernel

-- Eleven logarithm intervals are checked by the finite Taylor criterion.
set_option maxRecDepth 65536 in
/-- Each refined weight is an upper bound for twenty times the prime logarithm. -/
theorem target028_fine47_log_check :
    ∀ p ∈ target028FifteenPrimes,
      Analysis.rationalLogIntervalCheck p (Nat.log2 p + 1) 24 0
          ((target028Fine47Weight p : ℚ) / 20) =
        true := by
  decide +kernel

/-- Each refined label is a prime at most 31 and satisfies its logarithmic
weight bound. The existing primality evidence and the checked logarithm
interval provide the hypotheses for weighted semiprime counting. -/
theorem target028_fine47_supply (p : ℕ) (hp : p ∈ target028FifteenPrimes) :
    p.Prime ∧ p ≤ 47 ∧ Real.log p ≤ (target028Fine47Weight p : ℝ) / 20 := by
  have h := Analysis.rationalLogIntervalCheck_sound (target028_fine47_log_check p hp)
  have hprime : p.Prime ∧ p ≤ 47 := by
    have hc : ∀ p ∈ target028FifteenPrimes, p.Prime ∧ p ≤ 47 := by decide +kernel
    exact hc p hp
  simp only [Rat.cast_natCast, Rat.cast_div, Rat.cast_ofNat] at h
  exact ⟨hprime.1, hprime.2, h.2⟩

/-- The checked recurrence gives the exact weighted-family cardinality for
every budget through 180. The count-to-family theorem transfers the table. -/
theorem target028_fine47_card (H : ℕ) (hH : H ≤ 180) :
    (weightedPrimeFamily target028FifteenPrimes.toFinset target028Fine47Weight H).card =
      target028Fine47Row.getD H 0 :=
  (weightedPrimeCount_weights_eq_card target028Fine47Weight H target028FifteenPrimes
        target028Fine47Weights target028_fine47_labels.1 target028_fine47_labels.2.2
        target028_fine47_labels.2.1).symm.trans
    ((weightedPrimeTableCheck_sound 180 target028Fine47Weights target028Fine47Row
        target028Fine47Tail target028_fine47_checked H hH).symm)

end PseudoPrime.PrimeTestBounds.MillerRabin
