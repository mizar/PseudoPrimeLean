/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell9_exp_check :
    gammaMainListCheck gammaMainCell9Scale (centerRowsBelow 523) gammaMainCell9Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell9Lower : ℚ :=
  (361130511 / 25000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell9_sum_check :
    gammaMainCell9Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell9Radius) (centerRowsBelow 523)
          gammaMainCell9Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell9_scale_check :
    0 < gammaMainCell9Scale ∧
      0 < gammaMainCell9Radius ∧ gammaMainCell9Scale ≤ gammaMainCell9Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell9_actual_lower :
    (gammaMainCell9Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 523,
        Real.exp (-(n : ℝ) / (gammaMainCell9Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell9Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 523 ≤ 50000) gammaMainCell9Exp
    gammaMainCell9_scale_check.1 gammaMainCell9_scale_check.2.1 gammaMainCell9_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell9_exp_check) gammaMainCell9_sum_check

