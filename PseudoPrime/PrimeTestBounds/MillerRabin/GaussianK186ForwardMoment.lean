/-- The first-order Laplace coefficient recurrence checks the entire row. -/
private theorem forward_moment_matches : baseRow.momentMatches 83 13 4 forwardMomentRow = true := by
  decide +kernel

/-- The checked row represents the moment polynomial used in the forward integral. -/
private theorem forward_moment_poly :
    forwardMomentRow.poly 83 =
      middleMomentPoly HighGaussianKernel.k186.ratProfile (HighGaussianKernel.k186.pole + 1 / 2)
        0 := by
  have h :=
    MiddleIntRow.poly_of_momentMatches (p := baseRow) (m := forwardMomentRow) (by decide)
      (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel) forward_moment_matches
  rw [base_row_poly] at h
  have hs : HighGaussianKernel.k186.pole + 1 / 2 = (13 : ℚ) / 4 := by
    norm_num only [HighGaussianKernel.pole]
  simpa only [hs, Int.cast_ofNat] using h

/-- A single accepted integer row supplies both outward-rounded values needed
by the K186 forward coefficient comparison. -/
public theorem k186_forward_moment_caps :
    let M :=
      (middleMomentPoly HighGaussianKernel.k186.ratProfile (HighGaussianKernel.k186.pole + 1 / 2)
            0).map
        (Rat.castHom ℝ)
    (249979212898005394200 : ℝ) / 10 ^ 15 ≤ M.eval 5 ∧ M.eval 0 ≤ 28393155821834 / 10 ^ 15 := by
  intro M
  have hd : 0 < forwardMomentRow.den := by decide +kernel
  have h₅ := forwardMomentRow.eval_interval_contains 83 5 1 hd (by decide)
  have h₀ := forwardMomentRow.eval_interval_contains 83 0 1 hd (by decide)
  rw [forward_moment_poly] at h₅ h₀
  simp only [Analysis.IntegerInterval.Contains, Int.cast_ofNat, Int.cast_one, Int.cast_zero,
    div_one] at h₅ h₀
  have hL :
    (249979212898005394200 : ℚ) / 10 ^ 15 ≤
      ((forwardMomentRow.evalInterval 83 5 1).lower : ℚ) / (forwardMomentRow.den : ℚ) := by
    decide +kernel
  have hU :
    ((forwardMomentRow.evalInterval 83 0 1).upper : ℚ) / (forwardMomentRow.den : ℚ) ≤
      (28393155821834 : ℚ) / 10 ^ 15 := by
    decide +kernel
  constructor
  · exact
      (by
            simpa only [Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_intCast] using
              (Rat.cast_le (K := ℝ)).mpr hL :
            (249979212898005394200 : ℝ) / 10 ^ 15 ≤
              ((forwardMomentRow.evalInterval 83 5 1).lower : ℝ) / (forwardMomentRow.den : ℝ)).trans
        h₅.1
  · exact
      h₀.2.trans
        (by
          simpa only [Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_intCast] using
            (Rat.cast_le (K := ℝ)).mpr hU)

/-- The existing profile row supplies a coarse upper bound at five by one
integer Horner evaluation. -/
public theorem k186_profile_five_le : HighGaussianKernel.k186.realProfile.eval 5 ≤ 100000 := by
  have h := baseRow.eval_interval_contains 83 5 1 (by decide +kernel) (by decide)
  rw [base_row_poly, high_comp_profile_map] at h
  simp only [Analysis.IntegerInterval.Contains, Int.cast_ofNat, Int.cast_one, div_one] at h
  have hU : ((baseRow.evalInterval 83 5 1).upper : ℚ) / (baseRow.den : ℚ) ≤ 100000 := by
    decide +kernel
  exact
    h.2.trans
      (by
        simpa only [Rat.cast_div, Rat.cast_intCast, Rat.cast_ofNat] using
          (Rat.cast_le (K := ℝ)).mpr hU)

/-- The first derivative at five has absolute value at most 400000.
The checker reads the existing integer profile row with derivative weights. -/
public theorem k186_profile_deriv_five_abs_le :
    |HighGaussianKernel.k186.realProfile.derivative.eval 5| ≤ 400000 := by
  have h := baseRow.deriv_interval_contains 82 5 1 (by decide +kernel) (by decide)
  norm_num only [Int.cast_ofNat, Int.cast_one, div_one, Nat.reduceAdd] at h
  rw [base_row_poly, high_comp_profile_map] at h
  simp only [Analysis.IntegerInterval.Contains] at h
  have hL :
    -(400000 : ℚ) ≤ (((baseRow.deriv 82).evalInterval 82 5 1).lower : ℚ) / (baseRow.den : ℚ) := by
    decide +kernel
  have hU : (((baseRow.deriv 82).evalInterval 82 5 1).upper : ℚ) / (baseRow.den : ℚ) ≤ 400000 := by
    decide +kernel
  refine abs_le.mpr ⟨?_, ?_⟩
  · exact
      (by
            simpa only [Rat.cast_div, Rat.cast_intCast, Rat.cast_neg, Rat.cast_ofNat] using
              (Rat.cast_le (K := ℝ)).mpr hL :
            -(400000 : ℝ) ≤
              (((baseRow.deriv 82).evalInterval 82 5 1).lower : ℝ) / (baseRow.den : ℝ)).trans
        h.1
  · exact
      h.2.trans
        (by
          simpa only [Rat.cast_div, Rat.cast_intCast, Rat.cast_ofNat] using
            (Rat.cast_le (K := ℝ)).mpr hU)

