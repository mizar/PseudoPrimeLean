public import PseudoPrime.PrimeTestBounds.MillerRabin.PrimeSeed61

/-! # Weighted prime supply through 89 -/

@[expose] public section

namespace PseudoPrime.PrimeTestBounds.MillerRabin

/-- The distinct prime labels through 89 extend the supply through 61. -/
def primeSeed89Primes : List ℕ :=
  primeSeed61Primes ++ [67, 71, 73, 79, 83, 89]

/-- Scaled logarithmic weights extend the previous supply through 89. -/
def primeSeed89Weight (p : ℕ) : ℕ :=
  if p ≤ 61 then primeSeed61Weight p else if p ≤ 73 then 43 else if p ≤ 79 then 44 else 45

/-- Ordered weights for the prime labels through 89. -/
def primeSeed89Weights : List ℕ :=
  [7, 11, 17, 20, 24, 26, 30, 30, 32, 35, 35, 38, 38, 38, 39, 40, 41, 42, 43, 43, 43, 44, 45, 45]

/-- The labels and positive weights agree with the ordered table. -/
theorem primeSeed89_labels :
    primeSeed89Primes.Nodup ∧
      primeSeed89Primes.map primeSeed89Weight = primeSeed89Weights ∧
      ∀ p ∈ primeSeed89Primes, 0 < primeSeed89Weight p := by
  decide +kernel

/-- Each listed label is prime and at most 89. -/
theorem primeSeed89_prime_supply : ∀ p ∈ primeSeed89Primes, p.Prime ∧ p ≤ 89 := by decide +kernel

/-- Certified scaled weights bound the logarithms of all listed primes. -/
theorem primeSeed89_weight_bounds :
    ∀ p ∈ primeSeed89Primes, Real.log p ≤ (primeSeed89Weight p : ℝ) / 10 := by
  have h73 :=
    (Analysis.rationalLogIntervalCheck_sound
        (show Analysis.rationalLogIntervalCheck 73 7 16 4 (43 / 10) = true from by
          decide +kernel)).2
  have h79 :=
    (Analysis.rationalLogIntervalCheck_sound
        (show Analysis.rationalLogIntervalCheck 79 7 16 4 (44 / 10) = true from by
          decide +kernel)).2
  have h89 :=
    (Analysis.rationalLogIntervalCheck_sound
        (show Analysis.rationalLogIntervalCheck 89 7 16 4 (45 / 10) = true from by
          decide +kernel)).2
  norm_num only [Rat.cast_ofNat, Rat.cast_div] at h73 h79 h89
  have h67 : Real.log (67 : ℝ) ≤ 43 / 10 :=
    (Real.log_le_log (by norm_num only) (by norm_num only : (67 : ℝ) ≤ 73)).trans h73
  have h71 : Real.log (71 : ℝ) ≤ 43 / 10 :=
    (Real.log_le_log (by norm_num only) (by norm_num only : (71 : ℝ) ≤ 73)).trans h73
  have h83 : Real.log (83 : ℝ) ≤ 9 / 2 :=
    (Real.log_le_log (by norm_num only) (by norm_num only : (83 : ℝ) ≤ 89)).trans h89
  intro p hp
  simp only [primeSeed89Primes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with hp | rfl | rfl | rfl | rfl | rfl | rfl
  · have hp61 := (primeSeed61_prime_supply p hp).2
    simpa only [primeSeed89Weight, ite_eq_left hp61] using primeSeed61_weight_bounds p hp
  all_goals norm_num only [primeSeed89Weight, Nat.reduceLeDiff, Nat.cast_ofNat, ite_true, ite_false]
  all_goals
    first
    | exact h67
    | exact h71
    | exact h73
    | exact h79
    | exact h83
    | exact h89

