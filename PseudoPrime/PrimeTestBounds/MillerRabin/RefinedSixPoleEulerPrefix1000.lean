set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
-- Kernel checking evaluates 193 rational certificate rows.
/-- Every listed prime-power row passes the exact logarithm, power and primality
checks. Kernel reduction verifies the complete finite certificate. -/
theorem refined_euler_prefix_check :
    ∀ n ∈ refinedEulerPrefixSet,
      IsPrimePow n → refinedEulerAtomCheck 24 n (refinedEulerData n) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
-- Kernel reduction evaluates the 193-term rational sum exactly.
/-- The checked rational row sum exceeds the paper's normalized threshold.
Kernel reduction verifies the exact rational comparison. -/
theorem refined_euler_prefix_rational_lower :
    (223 / 125 : ℚ) * (27 / 25 : ℚ) ^ 5 <
      ∑ n ∈ refinedEulerPrefixSet, refinedEulerAtomLower n (refinedEulerData n) := by
  decide +kernel

set_option maxRecDepth 1000000 in
/-- Every index in the finite certificate is at most one thousand. -/
theorem refinedEulerPrefixSet_le : ∀ n ∈ refinedEulerPrefixSet, n ≤ 1000 := by decide +kernel

/-- The normalized refined Euler sum over the certified finite set exceeds
`(223/125)(27/25)^5`. Row soundness transfers the exact rational inequality
to the real von Mangoldt sum. This discharges the finite-prefix hypothesis
in the three-character high-range zero-mass bound. -/
theorem refined_euler_prefix_1000_lower :
    (223 / 125 : ℝ) * (27 / 25 : ℝ) ^ 5 <
      ∑ n ∈ refinedEulerPrefixSet, ArithmeticFunction.vonMangoldt n * refinedSixEulerWeight n := by
  have hc :=
    refined_euler_prefix_sound refinedEulerPrefixSet refinedEulerData refined_euler_prefix_check
  have hl :
    ((223 / 125 : ℚ) * (27 / 25 : ℚ) ^ 5 : ℝ) <
      ((∑ n ∈ refinedEulerPrefixSet, refinedEulerAtomLower n (refinedEulerData n) : ℚ) : ℝ) := by
    exact_mod_cast refined_euler_prefix_rational_lower
  norm_num only [Rat.cast_mul, Rat.cast_div, Rat.cast_ofNat, Rat.cast_pow] at hl ⊢
  exact hl.trans_le hc

