/-- Integer row for the derivative profile in the RH contribution. -/
private def massRHRow : MiddleIntRow :=
  ((massRow.scale 13 4).add 41 ((massRow.deriv 40).scale (-1) 1)).mulX2 41

/-- The two extra powers arise from the square of the logarithmic weight. -/
private theorem mass_rh_poly :
    massRHRow.poly 43 =
      Polynomial.X ^ 2 *
        (Polynomial.C (13 / 4) * highGaussianMassPolynomial .k186 -
          (highGaussianMassPolynomial .k186).derivative) := by
  have hd : ((massRow.deriv 40).poly 41) = ((massRow.deriv 40).poly 40) :=
    (massRow.deriv 40).poly_eq_of_size_le (by decide +kernel) (by decide +kernel)
  unfold massRHRow
  rw [MiddleIntRow.poly_mulX2, MiddleIntRow.poly_add _ _ _ (by decide +kernel) (by decide +kernel),
    MiddleIntRow.poly_scale, MiddleIntRow.poly_scale, hd, MiddleIntRow.poly_deriv, mass_row_poly]
  simp only [Int.cast_ofNat, Int.cast_neg, Int.cast_one, div_one, Polynomial.C_neg, Polynomial.C_1,
    neg_one_mul, sub_eq_add_neg]

/-- One scalar lookup into the certified first Euler Laplace moment. -/
public def k186EulerNineCoeff (i : ℕ) : ℚ :=
  (eulerNineRow.num i : ℚ) / eulerNineRow.den

/-- One scalar lookup into the certified RH Euler Laplace moment. -/
public def k186EulerElevenCoeff (i : ℕ) : ℚ :=
  (eulerElevenRow.num i : ℚ) / eulerElevenRow.den

/-- The first cached Euler polynomial is certified by its integer recurrence. -/
private theorem euler_nine_poly :
    eulerNineRow.poly 41 = middleMomentPoly (highGaussianMassPolynomial .k186) (9 / 4) 0 := by
  have h :=
    MiddleIntRow.poly_of_momentMatches (N := 41) (a := 9) (b := 4) (p := massRow) (m :=
      eulerNineRow) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
      (by decide +kernel) (by decide +kernel)
  simpa only [mass_row_poly, Int.cast_ofNat] using h

/-- The second cached Euler polynomial is certified by its integer recurrence. -/
private theorem euler_eleven_poly :
    let q := highGaussianMassPolynomial .k186
    eulerElevenRow.poly 43 =
      middleMomentPoly (Polynomial.X ^ 2 * (Polynomial.C (13 / 4) * q - q.derivative)) (11 / 4)
        0 := by
  have h :=
    MiddleIntRow.poly_of_momentMatches (N := 43) (a := 11) (b := 4) (p := massRHRow) (m :=
      eulerElevenRow) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
      (by decide +kernel) (by decide +kernel)
  simpa only [mass_rh_poly, Int.cast_ofNat] using h

/-- The first Euler coefficient lookup uses the cached moment row. -/
public theorem k186_euler_nine_coeff_eq (i : ℕ) :
    (middleMomentPoly (highGaussianMassPolynomial .k186) (9 / 4) 0).coeff i =
      k186EulerNineCoeff i := by
  rw [← euler_nine_poly]
  exact eulerNineRow.poly_coeff_all 41 (by decide +kernel) i

/-- The RH Euler coefficient lookup uses the cached moment row. -/
public theorem k186_euler_eleven_coeff_eq (i : ℕ) :
    let q := highGaussianMassPolynomial .k186
    (middleMomentPoly (Polynomial.X ^ 2 * (Polynomial.C (13 / 4) * q - q.derivative)) (11 / 4)
            0).coeff
        i =
      k186EulerElevenCoeff i := by
  dsimp only
  rw [← euler_eleven_poly]
  exact eulerElevenRow.poly_coeff_all 43 (by decide +kernel) i

