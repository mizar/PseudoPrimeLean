/-- Check the cached mass coefficients once against the existing mass recurrence. -/
private theorem mass_row_check :
    Array.ofFn (fun i : Fin 42 ↦ (massRow.num i.val : ℚ) / massRow.den) =
      shiftedMassCoeffTable .k186 0 := by
  decide +kernel

/-- The fixed integer row represents the unshifted K186 mass polynomial. -/
private theorem mass_row_poly : massRow.poly 41 = highGaussianMassPolynomial .k186 := by
  have hd : (highGaussianMassPolynomial .k186).natDegree ≤ 41 := by
    simpa only [Polynomial.C_0, add_zero, Polynomial.comp_X, HighGaussianKernel.degree] using
      high_mass_shifted_degree .k186 0
  ext i
  by_cases hi : i < 42
  · have h := congrArg (fun a : Array ℚ ↦ a[i]?.getD 0) mass_row_check
    rw [shifted_mass_entry, Polynomial.C_0, add_zero, Polynomial.comp_X] at h
    simp only [Array.getElem?_ofFn, dite_eq_left hi, Option.getD_some] at h
    exact (massRow.poly_coeff (Nat.le_of_lt_succ hi)).trans h
  · have hs : (massRow.poly 41).natDegree ≤ 41 :=
      Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (Nat.succ_pos _) _)
    have hn := Nat.lt_of_succ_le (le_of_not_gt hi)
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hs.trans_lt hn),
      Polynomial.coeff_eq_zero_of_natDegree_lt (hd.trans_lt hn)]

/-- The fixed mass numerator at one index, with zeros beyond degree 41. -/
public def k186GapMassNum (i : ℕ) : ℤ :=
  massRow.num i

/-- The common denominator of the fixed mass coefficients. -/
public def k186GapMassDen : ℤ :=
  massRow.den

/-- A scalar coefficient lookup agrees with the analytic mass polynomial. -/
public theorem k186_gap_mass_coeff (i : ℕ) :
    (highGaussianMassPolynomial .k186).coeff i = (k186GapMassNum i : ℚ) / k186GapMassDen := by
  rw [← mass_row_poly]
  exact massRow.poly_coeff_all 41 (by decide +kernel) i

