/-- A rational lower cap for the finite main sum through 709. -/
def gammaFixed17Main39Lower : ℚ :=
  1020987 / 62500

set_option maxRecDepth 8192 in
/-- Every rounded endpoint is valid for its corresponding prime-power row.
The list checker also proves that the endpoint and support lengths agree. -/
theorem gammaFixed17Main39_exp_check :
    gammaMainListCheck gammaMainCell17Scale (centerRowsBelow 709) gammaFixed17Main39Exp = true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The rational weighted aggregate of the checked endpoints exceeds its cap.
Kernel reduction verifies the finite sum for cutoff 709. -/
theorem gammaFixed17Main39_sum_check :
    gammaFixed17Main39Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell17Radius) (centerRowsBelow 709)
          gammaFixed17Main39Exp).sum := by
  decide +kernel

/-- The actual normalized main sum exceeds the checked rational cap at the
fixed scale. The support and row soundness transfer each verified endpoint. -/
theorem gammaFixed17Main39_actual_lower :
    (gammaFixed17Main39Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 709,
        Real.exp (-(n : ℝ) / (gammaMainCell17Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell17Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 709 ≤ 50000) gammaFixed17Main39Exp
      gammaMainCell17_scale_check.1 gammaMainCell17_scale_check.2.1 gammaMainCell17_scale_check.2.2
      (gammaMainListCheck_sound gammaFixed17Main39_exp_check) gammaFixed17Main39_sum_check

