/-- Aligned endpoints at cutoff 2099 in support order. -/
def gammaFixed260Main238Exp : List ℚ :=
  List.flatten [gammaFixed260Main238Exp0, gammaFixed260Main238Exp128, gammaFixed260Main238Exp256]

/-- Rational lower cap for the main sum through 2099. -/
def gammaFixed260Main238Lower : ℚ :=
  (180729 / 6250)

set_option maxRecDepth 8192 in
/-- The rounded endpoints satisfy the exact Taylor checker. -/
theorem gammaFixed260Main238_exp_check :
    gammaMainListCheck gammaMainCell260Scale (centerRowsBelow 2099) gammaFixed260Main238Exp =
      true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The exact weighted endpoint sum exceeds the proposed cap. -/
theorem gammaFixed260Main238_sum_check :
    gammaFixed260Main238Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell260Radius) (centerRowsBelow 2099)
          gammaFixed260Main238Exp).sum := by
  decide +kernel

/-- The finite exponential Mangoldt sum exceeds its certified cap. -/
theorem gammaFixed260Main238_actual_lower :
    (gammaFixed260Main238Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2099,
        Real.exp (-(n : ℝ) / (gammaMainCell260Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell260Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 2099 ≤ 50000) gammaFixed260Main238Exp
      gammaMainCell260_scale_check.1 gammaMainCell260_scale_check.2.1
      gammaMainCell260_scale_check.2.2 (gammaMainListCheck_sound gammaFixed260Main238_exp_check)
      gammaFixed260Main238_sum_check

