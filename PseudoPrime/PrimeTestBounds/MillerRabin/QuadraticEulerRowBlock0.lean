/-- Check this group's integer root comparisons and the remaining row conditions. -/
private theorem center_ticks0_part12 : centerTicks0Part12.all eulerTickCheck = true := by
  decide +kernel

/-- Decode the fixed-grid data as the rational Euler-center rows used by consumers. -/
noncomputable def centerRows0 : List EulerCenterRow :=
  (centerTicks0Part0 ++ centerTicks0Part1 ++ centerTicks0Part2 ++ centerTicks0Part3 ++
        centerTicks0Part4 ++
        centerTicks0Part5 ++
        centerTicks0Part6 ++
        centerTicks0Part7 ++
        centerTicks0Part8 ++
        centerTicks0Part9 ++
        centerTicks0Part10 ++
        centerTicks0Part11 ++
        centerTicks0Part12).map
    EulerTickRow.toRow

/-- Integer root comparisons and the row checks certify all decoded rows. -/
theorem centerRows0_check : centerRows0.all eulerCenterRowCheck = true := by
  apply euler_tick_rows_sound
  simp only [List.all_append, center_ticks0_part0, center_ticks0_part1, center_ticks0_part2,
    center_ticks0_part3, center_ticks0_part4, center_ticks0_part5, center_ticks0_part6,
    center_ticks0_part7, center_ticks0_part8, center_ticks0_part9, center_ticks0_part10,
    center_ticks0_part11, center_ticks0_part12, Bool.and_self]

end PseudoPrime.PrimeTestBounds.MillerRabin
