set_option maxRecDepth 16384 in
/-- The semiprime cells cover `[8, 350]` and satisfy their `409/1000` coefficient budgets.
The finite check uses the certified candidates and exact rational local-scale estimates. -/
theorem semiprimeUniformCells_checked :
    semiprimeUniformCoverCheck 8 350 semiprimeUniformCells = true := by decide +kernel

/-- Under GRH, an odd product of distinct primes with logarithm in `[8, 350]` has a
rejecting prime at most `(409/1000) * (log n)²`. The checked cells cover the interval,
and each cell applies its certified local-or-counting candidate. -/
theorem exists_prime_reject_semiprime_409 {n p q : ℕ} (hn : 1 < n) (ho : Odd n) (hp : p.Prime)
    (hq : q.Prime) (hpq : p < q) (hprod : n = p * q)
    (hGRH : AnalyticNumberTheory.GRH.GeneralizedRiemannHypothesis) (hlo : (8 : ℝ) ≤ Real.log n)
    (hhi : Real.log n ≤ 350) :
    ∃ r : ℕ,
      r.Prime ∧
        (r : ℝ) ≤ (409 / 1000 : ℝ) * (Real.log n) ^ 2 ∧
        ¬PrimeTest.StrongMillerRabinPass n (r : ZMod n) := by
  exact
    semiprimeUniformCoverCheck_sound hn ho hp hq hpq hprod hGRH semiprimeUniformCells 8 350
      semiprimeUniformCells_checked hlo hhi

