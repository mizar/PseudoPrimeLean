/-- Recombine the existing two Laplace moment certificates through integer
scaling, differentiation, and addition before checking the common cache. -/
private def endpointComputed : MiddleIntRow :=
  (((finiteMomentRow.scale 13 4).add 83 (finiteMomentRow.deriv 82)).scale 6 1).add 83
    (forwardMomentRow.scale 3 1)

/-- Differentiation commutes with the rational unshifted Laplace moment. -/
private theorem moment_deriv (P : Polynomial ℚ) {r : ℚ} (hr : r ≠ 0) :
    (middleMomentPoly P r 0).derivative = middleMomentPoly P.derivative r 0 := by
  apply middle_moment_eq_of_ode hr
  simpa only [Polynomial.derivative_sub, Polynomial.derivative_C_mul] using
    congrArg Polynomial.derivative (middle_moment_ode P hr)

/-- The single integer cache represents the complete, untranslated endpoint polynomial. -/
private theorem endpoint_row_poly :
    let B := HighGaussianKernel.k186.ratProfile
    endpointRow.poly 83 =
      Polynomial.C 6 *
          (Polynomial.C (13 / 4) * middleMomentPoly B (9 / 4) 0 +
            middleMomentPoly B.derivative (9 / 4) 0) +
        Polynomial.C 3 * middleMomentPoly B (13 / 4) 0 := by
  dsimp only
  rw [MiddleIntRow.poly_eq_of_matches (s := endpointComputed) (by decide +kernel)
      (by decide +kernel) (by decide +kernel)]
  have hd : ((finiteMomentRow.deriv 82).poly 83) = ((finiteMomentRow.deriv 82).poly 82) :=
    (finiteMomentRow.deriv 82).poly_eq_of_size_le (by decide +kernel) (by decide +kernel)
  unfold endpointComputed
  rw [MiddleIntRow.poly_add _ _ _ (by decide +kernel) (by decide +kernel), MiddleIntRow.poly_scale,
    MiddleIntRow.poly_scale, MiddleIntRow.poly_add _ _ _ (by decide +kernel) (by decide +kernel),
    MiddleIntRow.poly_scale, hd, MiddleIntRow.poly_deriv, finite_moment_poly, forward_moment_poly,
    moment_deriv _ (by decide +kernel)]
  norm_num only [Int.cast_ofNat, Int.cast_one, div_one, HighGaussianKernel.pole]

/-- The unshifted physical profile numerator at a single coefficient index. -/
public def k186GapProfileNum (i : ℕ) : ℤ :=
  baseRow.num i

/-- The common denominator of the physical profile. -/
public def k186GapProfileDen : ℤ :=
  baseRow.den

/-- The coefficient lookup uses the certified physical profile row. -/
public theorem k186_gap_profile_coeff (i : ℕ) :
    HighGaussianKernel.k186.ratProfile.coeff i = (k186GapProfileNum i : ℚ) / k186GapProfileDen := by
  rw [← base_row_poly]
  exact baseRow.poly_coeff_all 83 (by decide +kernel) i

/-- The combined endpoint numerator at one coefficient index. -/
public def k186GapEndpointNum (i : ℕ) : ℤ :=
  endpointRow.num i

/-- The common denominator of the combined endpoint polynomial. -/
public def k186GapEndpointDen : ℤ :=
  endpointRow.den

/-- The fixed endpoint coefficient is supplied by the single integer cache. -/
public theorem k186_gap_endpoint_coeff (i : ℕ) :
    let B := HighGaussianKernel.k186.ratProfile
    (Polynomial.C 6 *
              (Polynomial.C (13 / 4) * middleMomentPoly B (9 / 4) 0 +
                middleMomentPoly B.derivative (9 / 4) 0) +
            Polynomial.C 3 * middleMomentPoly B (13 / 4) 0).coeff
        i =
      (k186GapEndpointNum i : ℚ) / k186GapEndpointDen := by
  dsimp only
  rw [← endpoint_row_poly]
  exact endpointRow.poly_coeff_all 83 (by decide +kernel) i

