/-- The checked translated coefficients certify the K196 H28 boundary. -/
public theorem k196_profile_grid_check : highIntProfileSignCheck .k196 80 = true := by
  apply high_profile_check_of_coeffs
  intro i hi
  change i < 116 at hi
  have hk := (Nat.mul_div_le i 8).trans_lt hi
  have hk' : i / 8 < 15 := Nat.lt_of_mul_lt_mul_left (hk.trans_le (by decide))
  have h :=
    of_decide_eq_true
      (List.all_eq_true.mp (k196_positive_blocks ⟨i / 8, hk'⟩) (i % 8)
        (List.mem_range.mpr (Nat.mod_lt i (by decide))))
  rw [Nat.add_comm, Nat.mod_add_div] at h
  rw [highShiftProfileCoeff, k196_shifted_ok]
  exact h

