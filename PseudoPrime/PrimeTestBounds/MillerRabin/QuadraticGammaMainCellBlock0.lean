/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell0_exp_check :
    gammaMainListCheck gammaMainCell0Scale (centerRowsBelow 477) gammaMainCell0Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell0Lower : ℚ :=
  (687381207 / 50000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell0_sum_check :
    gammaMainCell0Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell0Radius) (centerRowsBelow 477)
          gammaMainCell0Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell0_scale_check :
    0 < gammaMainCell0Scale ∧
      0 < gammaMainCell0Radius ∧ gammaMainCell0Scale ≤ gammaMainCell0Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell0_actual_lower :
    (gammaMainCell0Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 477,
        Real.exp (-(n : ℝ) / (gammaMainCell0Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell0Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 477 ≤ 50000) gammaMainCell0Exp
    gammaMainCell0_scale_check.1 gammaMainCell0_scale_check.2.1 gammaMainCell0_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell0_exp_check) gammaMainCell0_sum_check

