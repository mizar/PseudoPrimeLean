    (hd : s.den = r.den * f) (hn : s.nums = r.nums.map (fun z ↦ z * f)) : s.poly N = r.poly N := by
  apply AddMonoidAlgebra.ext
  apply Finsupp.ext
  intro i
  by_cases hi : i ≤ N
  · have hnum : s.num i = r.num i * f := by
      simp only [MiddleIntRow.num, hn, Array.getElem?_map]
      cases r.nums[i]? <;>
        simp only [Option.map_none, Option.map_some, Option.getD_none, Option.getD_some, zero_mul]
    rw [s.poly_coeff hi, r.poly_coeff hi, hnum, hd]
    simp only [Int.cast_mul, mul_div_mul_right _ _ (Int.cast_ne_zero.mpr hf : (f : ℚ) ≠ 0)]
  · have hlt := Nat.succ_le_of_lt (Nat.lt_of_not_ge hi)
    simp only [MiddleIntRow.poly, Polynomial.ofFn_coeff_eq_zero_of_ge _ hlt]

/-- The stored base row at the scale used by downstream K186 certificates. -/
private def k186BaseRow : MiddleIntRow :=
  ⟨k186GammaDen, k186GridBase⟩

/-- The factor from the stored scale to the generated profile scale. -/
private def multiplier : ℤ :=
  (highProfileIntRow .k186).den / k186BaseRow.den

/-- The generated integer coefficients are an exact rescaling of the stored row. -/
private theorem legacy_num_eq :
    (highProfileIntRow .k186).nums = k186BaseRow.nums.map (fun z ↦ z * multiplier) := by
  decide +kernel

/-- The two common denominators have the same rescaling factor. -/
private theorem legacy_den_eq : (highProfileIntRow .k186).den = k186BaseRow.den * multiplier := by
  decide +kernel

/-- The stored K186 row represents the physical profile by the integer generation theorem. -/
private theorem k186_cached_poly : k186BaseRow.poly 83 = HighGaussianKernel.k186.ratProfile := by
  have h :=
    poly_eq_of_rescale k186BaseRow (highProfileIntRow .k186) 83 multiplier (by decide) legacy_den_eq
      legacy_num_eq
  exact h.symm.trans (high_profile_int_poly .k186)

/-- The stored numerator is the corresponding physical coefficient times the common scale. -/
private theorem k186_cached_entry (i : ℕ) (hi : i < 84) :
    (k186GridBase[i]?.getD 0 : ℚ) =
      (k186GammaDen : ℚ) * HighGaussianKernel.k186.ratProfile.coeff i := by
  have h := congrArg (fun p : Polynomial ℚ ↦ p.coeff i) k186_cached_poly
  rw [k186BaseRow.poly_coeff (Nat.le_of_lt_succ hi)] at h
  change _ / (k186GammaDen : ℚ) = _ at h
  exact ((div_eq_iff (by decide : (k186GammaDen : ℚ) ≠ 0)).mp h).trans (mul_comm _ _)

/-- Translate the checked stored coefficients at an arbitrary integer origin. -/
private theorem k186_cached_shift (a : ℤ) {i : ℕ} (hi : i < 84) :
    ((highGammaShiftInt 84 a k186GridBase)[i]?.getD 0 : ℚ) =
      (k186GammaDen : ℚ) *
        (HighGaussianKernel.k186.ratProfile.comp (Polynomial.X + Polynomial.C (a : ℚ))).coeff i :=
  high_gamma_shift_int_cast 84 a k186GridBase k186GammaDen HighGaussianKernel.k186.ratProfile
    (Nat.succ_le_succ (high_rat_profile_degree .k186)) k186_cached_entry hi

