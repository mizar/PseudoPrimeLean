/-- Combine the entry checks for this stage into the complete row identity. -/
private theorem powers_ok :
    (Array.ofFn (fun i : Fin 84 ↦ (fun i ↦ (65 : ℤ) ^ i) i.val)) = k186GridPowers := by
  refine
    high_gamma_row_of_scalar_blocks 84 (fun i ↦ (65 : ℤ) ^ i) k186GridPowers (by decide : 0 < 8)
      (by rfl) ?_
  intro k hk
  have hbound : 8 * k < 8 * 11 := hk.trans_le (by decide)
  exact powCheck_family ⟨k, Nat.lt_of_mul_lt_mul_left hbound⟩

