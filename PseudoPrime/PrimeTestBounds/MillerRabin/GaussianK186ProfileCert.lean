/-- The checked translated coefficients certify the K186 H28 boundary. -/
public theorem k186_profile_grid_check : highIntProfileSignCheck .k186 65 = true := by
  apply high_profile_check_of_coeffs
  intro i hi
  change i < 84 at hi
  have hk := (Nat.mul_div_le i 8).trans_lt hi
  have hk' : i / 8 < 11 := Nat.lt_of_mul_lt_mul_left (hk.trans_le (by decide))
  have h :=
    of_decide_eq_true
      (List.all_eq_true.mp (k186_positive_blocks ⟨i / 8, hk'⟩) (i % 8)
        (List.mem_range.mpr (Nat.mod_lt i (by decide))))
  rw [Nat.add_comm, Nat.mod_add_div] at h
  have hp := k186_cached_shift 65 hi
  rw [k186_shifted_ok] at hp
  have hD : (0 : ℚ) < k186GammaDen := by norm_num only [k186GammaDen]
  have hcoeff :
    0 ≤ (HighGaussianKernel.k186.ratProfile.comp (Polynomial.X + Polynomial.C 65)).coeff i :=
    nonneg_of_mul_nonneg_right (hp ▸ Int.cast_nonneg h) hD
  apply (Int.cast_nonneg_iff (R := ℚ)).mp
  change 0 ≤ ((highGammaShiftedProfile .k186 65)[i]?.getD 0 : ℚ)
  rw [high_gamma_shifted_cast .k186 65 hi, high_cell_power_coeff .k186 ((65 : ℤ) : ℚ) 1 hi,
    Polynomial.C_1, one_mul]
  exact mul_nonneg (Nat.cast_nonneg _) (by simpa only [Int.cast_ofNat] using hcoeff)

