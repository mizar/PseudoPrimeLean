def gammaMainCell57Exp : List ℚ :=
  List.flatten [gammaMainCell57Exp0, gammaMainCell57Exp128]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell57_exp_check :
    gammaMainListCheck gammaMainCell57Scale (centerRowsBelow 827) gammaMainCell57Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell57Lower : ℚ :=
  (451489261 / 25000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell57_sum_check :
    gammaMainCell57Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell57Radius) (centerRowsBelow 827)
          gammaMainCell57Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell57_scale_check :
    0 < gammaMainCell57Scale ∧
      0 < gammaMainCell57Radius ∧ gammaMainCell57Scale ≤ gammaMainCell57Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell57_actual_lower :
    (gammaMainCell57Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 827,
        Real.exp (-(n : ℝ) / (gammaMainCell57Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell57Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 827 ≤ 50000) gammaMainCell57Exp
    gammaMainCell57_scale_check.1 gammaMainCell57_scale_check.2.1 gammaMainCell57_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell57_exp_check) gammaMainCell57_sum_check

