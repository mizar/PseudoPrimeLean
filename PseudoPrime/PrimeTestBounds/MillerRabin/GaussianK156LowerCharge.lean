public theorem middle_k156_comp_profile :
    middleK156Profile.natDegree ≤ 51 ∧ 0 ≤ middleK156Profile.eval₂ (Rat.castHom ℝ) (7 / 2) := by
  constructor
  · exact Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (Nat.succ_pos 51) _)
  · have hv : 0 ≤ middleK156Profile.eval (7 / 2) := by
      rw [cutoff_eq]
      decide +kernel
    have hm := Polynomial.eval_map_apply (p := middleK156Profile) (Rat.castHom ℝ) (7 / 2 : ℚ)
    rw [Polynomial.eval_map] at hm
    simp only [Rat.coe_castHom, Rat.cast_div, Rat.cast_ofNat] at hm
    exact hm.symm ▸ Rat.cast_nonneg.mpr hv

/-- The normalized K156 cutoff weight fits the common boundary budget. -/
public theorem middle_k156_cutoff_weight_le :
    (middleK156Norm : ℝ) * Real.exp (-(343 / 40 : ℝ)) *
        middleK156Profile.eval₂ (Rat.castHom ℝ) (7 / 2) ≤
      903 / 10000 := by
  have h := mul_le_mul_of_nonneg_right middle_k156_scale_le middle_k156_comp_profile.2
  refine h.trans ?_
  have hm := Polynomial.eval_map_apply (p := middleK156Profile) (Rat.castHom ℝ) (7 / 2 : ℚ)
  rw [Polynomial.eval_map] at hm
  simp only [Rat.coe_castHom, Rat.cast_div, Rat.cast_ofNat] at hm
  rw [hm]
  have hc : middleK156Scale * middleK156Profile.eval (7 / 2) ≤ (903 / 10000 : ℚ) := by
    rw [cutoff_eq]
    decide +kernel
  simpa only [Rat.cast_mul, Rat.cast_div, Rat.cast_ofNat] using (Rat.cast_le (K := ℝ)).mpr hc

/-- The integer cell widths for K156 compensation use a denominator of 128. -/
private def compWidths : List ℕ :=
  [28, 7, 7, 7, 7, 7, 7, 7, 49, 7, 7, 7, 7, 7, 7, 7, 273]

/-- The rational widths used by the analytic compensation formula. -/
private def compGrid : List ℚ :=
  compWidths.map (fun w : ℕ ↦ ((w : ℤ) : ℚ) / (128 : ℤ))

/-- Accumulate the outward-rounded charge pair before comparing with the two budgets. -/
private def compTotal : ℚ × ℚ :=
  middleCompTotal (BData.compGridCharge 51 128 (49 / 20) (39 / 20) (10 ^ 18)) compGrid 0

/-- Verify both rounded K156 charges against the analytic budgets. -/
private theorem comp_total_le :
    compTotal.1 ≤ (693849645969795 / 10 ^ 18 : ℚ) ∧
      compTotal.2 ≤ (12114503414883903 / 10 ^ 18 : ℚ) := by
  decide +kernel

/-- K156 admits a positive compensation partition with the two stated analytic budgets. -/
public theorem middle_k156_comp_budgets :
    ∃ hs : List ℚ,
      (∀ w ∈ hs, 0 < w) ∧
        hs.sum = 7 / 2 ∧
        (∫ v in (0 : ℝ)..(7 / 2 : ℝ),
            Real.exp (-(((49 / 20 : ℚ) : ℝ) + 1 / 2) * v) *
              middleCompOn middleK156Profile 51 hs 0 v) ≤
          693849645969795 / 10 ^ 18 ∧
        middleCompVariation middleK156Profile 51 (49 / 20) (39 / 20) hs 0 ≤
          12114503414883903 / 10 ^ 18 := by
  have hw : ∀ w ∈ compWidths, 0 < w := by decide +kernel
  have hsum : compGrid.sum = 7 / 2 := by decide +kernel
  have h :=
    BData.comp_grid_total_le 51 (b := 128) (a := 49 / 20) (d := 39 / 20) (S := 10 ^ 18) (I :=
      693849645969795 / 10 ^ 18) (V := 12114503414883903 / 10 ^ 18) (by decide +kernel) (by decide)
      (by norm_num only) (by norm_num only) compWidths hw comp_total_le.1 comp_total_le.2
  change
    (∫ v in (0 : ℝ)..(compGrid.sum : ℝ),
          Real.exp (-(((49 / 20) + 1 / 2 : ℚ) : ℝ) * v) *
            middleCompOn middleK156Profile 51 compGrid 0 v) ≤
        _ ∧
      middleCompVariation middleK156Profile 51 (49 / 20) (39 / 20) compGrid 0 ≤ _ at h
  refine ⟨compGrid, by decide +kernel, hsum, ?_⟩
  simpa only [hsum, Rat.cast_div, Rat.cast_ofNat, Rat.cast_pow, Rat.cast_add, Rat.cast_inv,
    Rat.cast_one] using h

/-- K156 has nonnegative derivatives beyond the checked reflection anchor. -/
public theorem middle_k156_tail_sign (j : ℕ) {t : ℝ} (ht : 25 ≤ t) :
    0 ≤ ((Polynomial.derivative^[j]) (middleK156Profile.map (Rat.castHom ℝ))).eval t := by
  exact
    BData.tail_signs 51 25 (by decide +kernel) (by decide +kernel) j
      (by simpa only [Int.cast_ofNat] using ht)

