    have ht :
      translated.poly 51 = middleK156Profile.comp (Polynomial.X + Polynomial.C (7 / 2)) := by
      simpa only [middleK156Profile, Int.cast_ofNat] using h
    rw [← ht] at hm
    simpa only [middleMomentPoly, Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_C, zero_add, Polynomial.C_0, add_zero, Polynomial.comp_X] using
      congrArg (fun P : Polynomial ℚ ↦ P.eval 0) hm
  dsimp only
  constructor
  · rw [he, ← show (((59 : ℤ) : ℚ) / (20 : ℤ)) = 59 / 20 from by simp only [Int.cast_ofNat],
      translated.moment_head 51 59 20 (by decide +kernel) (by decide) (by decide)]
    decide +kernel
  · change
      middleK156Norm * (middleMomentPoly (BData.poly 51) ((((59 : ℤ) : ℚ) / (20 : ℤ))) 0).eval 0 ≤ _
