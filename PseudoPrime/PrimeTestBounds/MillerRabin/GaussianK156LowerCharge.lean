/-- The rational polynomial in the numerator of the K156 contour kernel. -/
public noncomputable def middleK156Kernel : Polynomial ℚ :=
  poleData.poly 24

/-- The K156 contour numerator has degree at most `24`. -/
public theorem middle_k156_kernel_degree : middleK156Kernel.natDegree ≤ 24 := by
  exact Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (Nat.succ_pos 24) _)

/-- The K156 Euler profile is the inverse transform of its squared contour kernel. -/
public theorem middle_k156_profile_eq_pole :
    middleK156Profile = middlePoleProfile 51 middleK156Kernel := by
  have h :=
    BData.poly_eq_pole_profile poleData 51 (by decide +kernel) (by decide) (by decide +kernel)
  rw [poleData.poly_eq_of_size_le (M := 24) (by decide) (by decide)] at h
  exact h

