/-- The physical K156 principal zero series stays below its manuscript
budget for every positive cutoff under RH. -/
public theorem middle_k156_spectral_le (hRH : RiemannHypothesis) {X : ℝ} (hX : 0 < X) :
    |(middleK156Norm : ℝ) * Real.exp (-(343 / 40 : ℝ)) *
          ∑' ρ,
            principalCancelledTerm (middleK156Profile.map (Rat.castHom ℝ)) (39 / 20 : ℝ) (7 / 2) X
              ρ| ≤
      53703 / 10 ^ 6 := by
  have he :
    (middleK156Norm : ℝ) *
        Real.exp (-(((39 / 20 : ℚ) : ℝ) + 1 / 2) * (((7 : ℤ) / (2 : ℤ) : ℚ) : ℝ)) ≤
      (middleK156Scale : ℝ) := by
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_intCast, Int.cast_ofNat]
    exact middle_k156_scale_le
  have h :=
    middle_spectral_row_le BData translated 51 hRH (a := 7) (b := 2) (d := 39 / 20) (κ :=
      middleK156Norm) (E := middleK156Scale) hX (by decide +kernel) (by decide +kernel) (by decide)
      (by decide +kernel) (by decide +kernel) (by decide) (by decide) (by decide) translated_ok
      (by decide) (by decide) he
  have hc :
    (∑ j ∈ Finset.range (51 + 1),
        BData.spectralCharge translated (39 / 20) middleK156Norm middleK156Scale j) ≤
      (53703 / 10 ^ 6 : ℚ) := by
    decide +kernel
