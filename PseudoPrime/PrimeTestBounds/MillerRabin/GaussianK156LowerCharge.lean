/-- The rational K156 physical profile in the reflected logarithmic coordinate. -/
public noncomputable def middleK156Profile : Polynomial ℚ :=
  BData.poly 51

/-- The row used in the Laplace certificate is the twice-differentiated K156 profile
with the reflected rate `39/20`. -/
private theorem profile_second :
    let P := middleK156Profile.map (Rat.castHom ℝ)
    D =
      Polynomial.C ((39 / 20 : ℝ) ^ 2) * P - Polynomial.C (2 * (39 / 20 : ℝ)) * P.derivative +
        P.derivative.derivative := by
  dsimp only [D, middleK156Profile]
  have h :=
    MiddleIntRow.poly_of_secondMatches (N := 51) (a := 39) (b := 20) (p := BData) (q := row)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide +kernel)
  have hm := congrArg (Polynomial.map (Rat.castHom ℝ)) h
  simpa only [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C,
    ← Polynomial.derivative_map, Rat.coe_castHom, Rat.cast_mul, Rat.cast_pow, Rat.cast_div,
    Rat.cast_ofNat, Rat.cast_intCast, Int.cast_ofNat] using hm

/-- Beyond the lower cutoff, the physical K156 lower Laplace charge is at
most one millionth. The square-root factor cancels under physical rescaling. -/
public theorem middle_k156_lower_charge {x : ℝ} (hx : 24 ≤ x) :
    let P := middleK156Profile.map (Rat.castHom ℝ)
    let Q :=
      Polynomial.C ((39 / 20 : ℝ) ^ 2) * P - Polynomial.C (2 * (39 / 20 : ℝ)) * P.derivative +
        P.derivative.derivative
    (693 / 5000 : ℝ) *
        ((middleK156Norm : ℝ) * Real.exp (-(49 / 20 : ℝ) * (x + 7 / 2)) *
          Real.exp ((49 / 20 - 1 / 2 : ℝ) * x)) *
        Real.exp (x / 2) *
        (∫ t in Set.Ioi x, Real.exp (-(49 / 20 : ℝ) * t) * |Q.eval (7 / 2 + t)|) ≤
      1 / 10 ^ 6 := by
  intro P Q
  have hA :
    (∫ t in Set.Ioi (7 / 2 + 24 : ℝ), Real.exp (-(49 / 20 : ℝ) * t) * |D.eval t|) ≤
      ((ratio ^ 55 * 28408276617431238146724066 : ℚ) : ℝ) := by
    convert tail_mass_le using 2
    norm_num only
  have hc :
    (693 / 5000 : ℝ) * (middleK156Norm : ℝ) * ((ratio ^ 55 * 28408276617431238146724066 : ℚ) : ℝ) ≤
      1 / 10 ^ 6 := by
    have h :
      (693 / 5000 : ℚ) * middleK156Norm * (ratio ^ 55 * 28408276617431238146724066) ≤
        1 / 10 ^ 6 := by
      decide +kernel
    have hh := (Rat.cast_le (K := ℝ)).mpr h
    simpa only [Rat.cast_mul, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_one] using hh
  have h :=
    middle_low_physical_charge D (by norm_num only : (0 : ℝ) < 49 / 20)
      (by norm_num only : (0 : ℝ) ≤ 7 / 2 + 24) hx
      (Rat.cast_nonneg.mpr (by decide +kernel : 0 ≤ middleK156Norm)) hA hc
  rw [profile_second] at h
  exact h

/-- Bound the two finite K156 cell charges by an endpoint exponential and a
rounded integer Bernstein sum on each cell. -/
private theorem upper_cells (i : ℕ) (hi : i < 2) :
    Real.exp
          (max ((1 / 20 : ℝ) * (((135 * (i : ℤ) : ℤ) : ℚ) / 8 : ℚ))
            ((1 / 20 : ℝ) * (((135 * ((i + 1 : ℕ) : ℤ) : ℤ) : ℚ) / 8 : ℚ))) *
        (row.absCellCharge 51 (135 * i) 135 8 : ℝ) ≤
      (if i = 0 then (7 / 3 : ℚ) * 4138625568491063
        else (11 / 2 : ℚ) * 523973572741675160577327820581 :
        ℚ) := by
  interval_cases i
  · have he :=
      middle_exp_le_of_taylor (t := 27 / 32) (U := 7 / 3) 16 (by decide +kernel) (by decide +kernel)
        (by decide +kernel)
    have hc : row.absCellCharge 51 0 135 8 ≤ 4138625568491063 := by decide +kernel
    have hn := row.abs_cell_nonneg 51 0 135 8 (by decide +kernel)
    have hu :=
      mul_le_mul he ((Rat.cast_le (K := ℝ)).mpr hc) (Rat.cast_nonneg.mpr hn)
