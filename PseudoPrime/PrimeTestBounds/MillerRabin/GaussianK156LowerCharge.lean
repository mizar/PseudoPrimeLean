/-- The common half-step upper ratio for decay at rate 49/20. -/
private def ratio : ℚ :=
  293758 / 10 ^ 6

/-- The upper bound on the complete moment after translation to the left cutoff. -/
private theorem endpoint_factor :
    (∑ i ∈ Finset.range (51 + 1),
        |((row.shift 51 55 2).num i : ℚ) / (row.shift 51 55 2).den| *
          ((i.factorial : ℚ) / (49 / 20 : ℚ) ^ (i + 1))) ≤
      28408276617431238146724066 := by
  decide +kernel

/-- The real profile used by the checked second-derivative coefficient row. -/
private noncomputable def D : Polynomial ℝ :=
  (row.poly 51).map (Rat.castHom ℝ)

/-- The complete absolute tail is bounded at the left cutoff using one shift. -/
private theorem tail_mass_le :
    (∫ t in Set.Ioi (55 / 2 : ℝ), Real.exp (-(49 / 20 : ℝ) * t) * |D.eval t|) ≤
      ((ratio ^ 55 * 28408276617431238146724066 : ℚ) : ℝ) := by
  have hr : Real.exp (-((49 / 40 : ℚ) : ℝ)) ≤ (ratio : ℝ) :=
    middle_exp_neg_le_of_taylor 16 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hx := middle_exp_grid_le (a := 0) (by rw [Real.exp_zero]) hr 55
  have hE :
    Real.exp (-((49 / 20 : ℚ) : ℝ) * (((55 : ℚ) / (2 : ℤ) : ℚ) : ℝ)) ≤ ((ratio ^ 55 : ℚ) : ℝ) := by
    norm_num only [zero_add, one_mul, Rat.cast_div, Rat.cast_ofNat, Rat.cast_intCast,
      Int.cast_ofNat, Rat.cast_one, Rat.cast_pow] at hx ⊢
    exact hx
  have h :=
    row.abs_tail_le 51 55 2 (by decide) (by decide) (by decide +kernel : (0 : ℚ) < 49 / 20) hE
  dsimp only at h
  have hM :=
    h.trans
      (Rat.cast_le.mpr
        (mul_le_mul_of_nonneg_left endpoint_factor (pow_nonneg (by decide +kernel : 0 ≤ ratio) 55)))
  simpa only [D, Polynomial.eval_map, Rat.cast_div, Rat.cast_ofNat, Rat.cast_intCast,
    Int.cast_ofNat] using hM

