/-- The two certified cells cover the largest support of the K156 finite moment. -/
private theorem upper_moment_le :
    (∫ t in (0 : ℝ)..(135 / 4), Real.exp ((1 / 20 : ℝ) * t) * |D.eval t|) ≤
      (((7 / 3 : ℚ) * 4138625568491063 + (11 / 2 : ℚ) * 523973572741675160577327820581 : ℚ) :
        ℝ) := by
  let C : ℕ → ℚ := fun i ↦
    if i = 0 then (7 / 3 : ℚ) * 4138625568491063 else (11 / 2 : ℚ) * 523973572741675160577327820581
  have hp (i : ℕ) (_ : i < 2) : 0 < ((135 * ((i + 1 : ℕ) : ℤ) - 135 * i : ℤ) : ℚ) / 8 := by
    rw [show (135 * ((i + 1 : ℕ) : ℤ) - 135 * i : ℤ) = 135 by
        simp only [Int.natCast_succ]; ring]
    decide +kernel
  have h :=
    row.exp_abs_partition_le 51 2 (fun i ↦ 135 * i) 8 (1 / 20) C (by decide) (by decide) hp
      (fun i hi ↦ by
        have h := upper_cells i hi
        rw [show (135 * ((i + 1 : ℕ) : ℤ) - 135 * i : ℤ) = 135 by
            simp only [Int.natCast_succ]; ring]
        exact h)
  have hc :
    ∑ i ∈ Finset.range 2, C i =
      (7 / 3 : ℚ) * 4138625568491063 + (11 / 2 : ℚ) * 523973572741675160577327820581 := by
    decide +kernel
  rw [hc] at h
  convert h using 2 <;>
    norm_num only [D, Polynomial.eval_map, Rat.cast_div, Rat.cast_intCast, Int.cast_ofNat,
      Int.cast_zero]

/-- On the K156 cutoff interval, the inverse-square finite moment costs
at most one twenty-fifth in physical coordinates. -/
public theorem middle_k156_upper_charge {x : ℝ} (hl : 24 ≤ x) (hr : x ≤ 121 / 4) :
    let P := middleK156Profile.map (Rat.castHom ℝ)
    let Q :=
      Polynomial.C ((39 / 20 : ℝ) ^ 2) * P - Polynomial.C (2 * (39 / 20 : ℝ)) * P.derivative +
        P.derivative.derivative
    5 / 4 *
        ((middleK156Norm : ℝ) * Real.exp (-(49 / 20 : ℝ) * (x + 7 / 2)) *
          Real.exp ((49 / 20 - 1 / 2 : ℝ) * x)) *
        Real.exp (-2 * x) *
        Real.exp ((49 / 20 - 5 / 2 : ℝ) * (7 / 2)) *
        (∫ t in (0 : ℝ)..(7 / 2 + x), Real.exp ((5 / 2 - 49 / 20 : ℝ) * t) * |Q.eval t|) ≤
      1 / 25 := by
  intro P Q
  let A : ℚ := (7 / 3 : ℚ) * 4138625568491063 + (11 / 2 : ℚ) * 523973572741675160577327820581
  have hA :
    (∫ t in (0 : ℝ)..(7 / 2 + 121 / 4), Real.exp ((5 / 2 - 49 / 20 : ℝ) * t) * |D.eval t|) ≤
      (A : ℝ) := by
    convert upper_moment_le using 3 <;> norm_num only
  have he : Real.exp (-(5 / 2 : ℝ) * (7 / 2 + 24)) ≤ ((778801 / 10 ^ 6 : ℚ) ^ 275 : ℚ) := by
    convert middle_exp_neg_quarters_le 275 using 2
    norm_num only
  have hc : (5 / 4 : ℚ) * middleK156Norm * (778801 / 10 ^ 6) ^ 275 * A ≤ 1 / 25 := by decide +kernel
  have hκ : 0 ≤ (middleK156Norm : ℝ) := Rat.cast_nonneg.mpr (by decide +kernel)
  have h :=
    middle_upper_physical_charge D (C := 1 / 25) (by norm_num only : 0 ≤ (7 / 2 + 24 : ℝ)) hl hr hκ
      hA
      (by
        refine
          (mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left he (mul_nonneg (by norm_num only) hκ))
                (Rat.cast_nonneg.mpr (by decide +kernel))).trans
            ?_
        simpa only [Rat.cast_mul, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_one] using
          (Rat.cast_le (K := ℝ)).mpr hc)
  rw [profile_second] at h
  exact h

