    B.eval 0 = 0 ∧ B.derivative.eval 0 = 0 := by
  change
    ((BData.poly 51).map (Rat.castHom ℝ)).eval 0 = 0 ∧
      ((BData.poly 51).map (Rat.castHom ℝ)).derivative.eval 0 = 0
  have hs : BData.nums.size ≤ 51 + 1 := by decide
  have h0 : BData.num 0 = 0 := by decide
  have h1 : BData.num 1 = 0 := by decide
  constructor
  · rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_map, BData.poly_coeff_all 51 hs, h0,
      Int.cast_zero, zero_div, map_zero]
  · rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_derivative, zero_add,
      Polynomial.coeff_map, BData.poly_coeff_all 51 hs, h1, Int.cast_zero, zero_div, map_zero,
      zero_mul]

