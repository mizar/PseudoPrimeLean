/-- The aligned exponential endpoints for cutoff 1609. The lists are
concatenated in support order before the finite checker is applied. -/
def gammaFixed92Main172Exp : List ℚ :=
  List.flatten [gammaFixed92Main172Exp0, gammaFixed92Main172Exp128, gammaFixed92Main172Exp256]

/-- A rational lower cap for the finite main sum through 1609. -/
def gammaFixed92Main172Lower : ℚ :=
  23214417 / 1000000

set_option maxRecDepth 8192 in
/-- Every rounded endpoint is valid for its corresponding prime-power row.
The list checker also proves that the endpoint and support lengths agree. -/
theorem gammaFixed92Main172_exp_check :
    gammaMainListCheck gammaMainCell92Scale (centerRowsBelow 1609) gammaFixed92Main172Exp =
      true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The rational weighted aggregate of the checked endpoints exceeds its cap.
Kernel reduction verifies the finite sum for cutoff 1609. -/
theorem gammaFixed92Main172_sum_check :
    gammaFixed92Main172Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell92Radius) (centerRowsBelow 1609)
          gammaFixed92Main172Exp).sum := by
  decide +kernel

/-- The actual normalized main sum exceeds the checked rational cap at the
fixed scale. The support and row soundness transfer each verified endpoint. -/
theorem gammaFixed92Main172_actual_lower :
    (gammaFixed92Main172Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 1609,
        Real.exp (-(n : ℝ) / (gammaMainCell92Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell92Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 1609 ≤ 50000) gammaFixed92Main172Exp
      gammaMainCell92_scale_check.1 gammaMainCell92_scale_check.2.1 gammaMainCell92_scale_check.2.2
      (gammaMainListCheck_sound gammaFixed92Main172_exp_check) gammaFixed92Main172_sum_check

