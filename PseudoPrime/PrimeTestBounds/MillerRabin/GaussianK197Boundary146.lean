/-- The signed Chebyshev lower bound on the squared cutoffs of compressed cell 146. -/
public theorem psi_gaussian_k197_cell146 {x : ℝ} (hl : 1041561 ≤ x) (hu : x ≤ 1058398) :
    -440 ≤ Chebyshev.psi x - x := by
  by_cases h1047000 : x ≤ 1047000
  · exact floor_1041561 hl h1047000
  by_cases h1053000 : x ≤ 1053000
  · exact floor_1047000 (le_of_not_ge h1047000) h1053000
  exact floor_1053000 (le_of_not_ge h1053000) hu

