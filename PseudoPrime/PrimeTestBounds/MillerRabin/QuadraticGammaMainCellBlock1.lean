/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell8_exp_check :
    gammaMainListCheck gammaMainCell8Scale (centerRowsBelow 521) gammaMainCell8Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell8Lower : ℚ :=
  (359239259 / 25000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell8_sum_check :
    gammaMainCell8Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell8Radius) (centerRowsBelow 521)
          gammaMainCell8Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell8_scale_check :
    0 < gammaMainCell8Scale ∧
      0 < gammaMainCell8Radius ∧ gammaMainCell8Scale ≤ gammaMainCell8Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell8_actual_lower :
    (gammaMainCell8Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 521,
        Real.exp (-(n : ℝ) / (gammaMainCell8Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell8Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 521 ≤ 50000) gammaMainCell8Exp
    gammaMainCell8_scale_check.1 gammaMainCell8_scale_check.2.1 gammaMainCell8_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell8_exp_check) gammaMainCell8_sum_check

