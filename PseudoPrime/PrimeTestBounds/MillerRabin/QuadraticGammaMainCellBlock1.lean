/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell1_exp_check :
    gammaMainListCheck gammaMainCell1Scale (centerRowsBelow 479) gammaMainCell1Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell1Lower : ℚ :=
  (1382556531 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell1_sum_check :
    gammaMainCell1Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell1Radius) (centerRowsBelow 479)
          gammaMainCell1Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell1_scale_check :
    0 < gammaMainCell1Scale ∧
      0 < gammaMainCell1Radius ∧ gammaMainCell1Scale ≤ gammaMainCell1Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell1_actual_lower :
    (gammaMainCell1Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 479,
        Real.exp (-(n : ℝ) / (gammaMainCell1Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell1Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 479 ≤ 50000) gammaMainCell1Exp
    gammaMainCell1_scale_check.1 gammaMainCell1_scale_check.2.1 gammaMainCell1_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell1_exp_check) gammaMainCell1_sum_check

