set_option maxRecDepth 8192 in
/-- The rounded endpoints satisfy the exact Taylor checker. -/
theorem gammaFixed260Main215_exp_check :
    gammaMainListCheck gammaMainCell260Scale (centerRowsBelow 1933) gammaFixed260Main215Exp =
      true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The exact weighted endpoint sum exceeds the proposed cap. -/
theorem gammaFixed260Main215_sum_check :
    gammaFixed260Main215Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell260Radius) (centerRowsBelow 1933)
          gammaFixed260Main215Exp).sum := by
  decide +kernel

/-- The finite exponential Mangoldt sum exceeds its certified cap. -/
theorem gammaFixed260Main215_actual_lower :
    (gammaFixed260Main215Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 1933,
        Real.exp (-(n : ℝ) / (gammaMainCell260Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell260Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 1933 ≤ 50000) gammaFixed260Main215Exp
      gammaMainCell260_scale_check.1 gammaMainCell260_scale_check.2.1
      gammaMainCell260_scale_check.2.2 (gammaMainListCheck_sound gammaFixed260Main215_exp_check)
      gammaFixed260Main215_sum_check

