/-- Rational lower cap for the main sum through 1637. -/
def gammaFixed260Main177Lower : ℚ :=
  (25937093 / 1000000)

set_option maxRecDepth 8192 in
/-- The rounded endpoints satisfy the exact Taylor checker. -/
theorem gammaFixed260Main177_exp_check :
    gammaMainListCheck gammaMainCell260Scale (centerRowsBelow 1637) gammaFixed260Main177Exp =
      true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The exact weighted endpoint sum exceeds the proposed cap. -/
theorem gammaFixed260Main177_sum_check :
    gammaFixed260Main177Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell260Radius) (centerRowsBelow 1637)
          gammaFixed260Main177Exp).sum := by
  decide +kernel

/-- The finite exponential Mangoldt sum exceeds its certified cap. -/
theorem gammaFixed260Main177_actual_lower :
    (gammaFixed260Main177Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 1637,
        Real.exp (-(n : ℝ) / (gammaMainCell260Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell260Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 1637 ≤ 50000) gammaFixed260Main177Exp
      gammaMainCell260_scale_check.1 gammaMainCell260_scale_check.2.1
      gammaMainCell260_scale_check.2.2 (gammaMainListCheck_sound gammaFixed260Main177_exp_check)
      gammaFixed260Main177_sum_check

