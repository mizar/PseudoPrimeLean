def squareCoverages : List SquareCoverageData :=
  squareCoverage01 ++ squareCoverage02 ++ squareCoverage03 ++ squareCoverage04 ++
    squareCoverage05 ++
    squareCoverage06 ++
    squareCoverage07 ++
    squareCoverage08

/-- Every selected square coverage row passes its seed and chain checks. -/
theorem squareCoverages_checked : squareCoverages.all SquareCoverageData.check = true := by
  simp only [squareCoverages, List.all_append, squareCoverage01_checked, squareCoverage02_checked,
    squareCoverage03_checked, squareCoverage04_checked, squareCoverage05_checked,
    squareCoverage06_checked, squareCoverage07_checked, squareCoverage08_checked, Bool.true_and]

/-- Under RH, each selected square coverage row gives its stated witness cutoff through
its target. Extract the checked row and apply the seed-and-chain soundness theorem. -/
theorem squareCoverages_sound {n p : ℕ} (hn : 1 < n) (ho : Odd n) (hp : p.Prime) (hp2 : p ≠ 2)
    (hpow : n = p ^ 2) (hRH : RiemannHypothesis) (d : SquareCoverageData) (hd : d ∈ squareCoverages)
    (hlog : Real.log n ≤ (d.target : ℝ)) :
    ∃ r : ℕ, r.Prime ∧ r ≤ d.bound ∧ ¬PrimeTest.StrongMillerRabinPass n (r : ZMod n) := by
  exact d.sound hn ho hp hp2 hpow hRH (List.all_eq_true.mp squareCoverages_checked d hd) hlog

end PseudoPrime.PrimeTestBounds.MillerRabin
