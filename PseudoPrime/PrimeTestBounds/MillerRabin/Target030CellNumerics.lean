  simp only [target030CellData, List.all_append, target030CellRows01_checked,
    target030CellRows02_checked, target030CellRows03_checked, target030CellRows04_checked,
    target030CellRows05_checked, target030CellRows06_checked, target030CellRows07_checked,
    target030CellRows08_checked, target030CellRows09_checked]
  rfl

/-- The record endpoints agree with the prescribed 83 closed intervals. -/
theorem target030CellData_endpoints :
    target030CellData.map (fun c ↦ (c.lo, c.hi)) = target030Cells83 := by rfl

/-- A checked record satisfies each rational inequality used by the cell
criterion. This does not itself certify the claimed product count. -/
theorem target030CellCheck_sound (c : Target030CellData) (hc : target030CellCheck c = true) :
    8 ≤ c.lo ∧
      c.lo ≤ c.hi ∧
      0 < c.W ∧
      0 ≤ c.R ∧
      c.R ^ 2 ≤ (3 / 10 : ℚ) * c.lo ^ 2 ∧
      (c.B : ℚ) ≤ (3 / 10 : ℚ) * c.lo ^ 2 ∧
      (c.H : ℚ) / 10 ≤ c.S ∧ c.hi - c.D ≤ c.S ∧ c.b ≤ c.R ∧ c.S ≤ c.R + c.d :=
  of_decide_eq_true hc

end PseudoPrime.PrimeTestBounds.MillerRabin
