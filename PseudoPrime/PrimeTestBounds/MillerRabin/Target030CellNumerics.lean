/-! # Rational conditions for the 83 semiprime cells -/

@[expose] public section

namespace PseudoPrime.PrimeTestBounds.MillerRabin

/-- Rational and integer parameters recorded for one semiprime cell. The
checker enforces the interval and cutoff inequalities; separate theorems are
needed for the weighted count and logarithm represented by `W` and `D`. -/
structure Target030CellData where
  /-- Left logarithmic endpoint. -/
  lo : ℚ
  /-- Right logarithmic endpoint. -/
  hi : ℚ
  /-- Prime-label cutoff. -/
  B : ℕ
  /-- Integer logarithmic cost budget in tenths. -/
  H : ℕ
  /-- Claimed weighted product count. -/
  W : ℕ
  /-- Claimed lower bound for the logarithm of the count. -/
  D : ℚ
  /-- Certified lower approximation to the target radius at the left endpoint. -/
  R : ℚ
  /-- Local logarithmic threshold. -/
  S : ℚ
  /-- Radius of the chosen local anchor, or zero for the unshifted case. -/
  b : ℚ
  /-- Anchor correction, or zero for the unshifted case. -/
  d : ℚ

/-- Check the rational endpoint, radius, cutoff and local-level inequalities
for one cell. Count correctness and the logarithmic bound are separate. -/
def target030CellCheck (c : Target030CellData) : Bool :=
  decide
    (8 ≤ c.lo ∧
      c.lo ≤ c.hi ∧
      0 < c.W ∧
      0 ≤ c.R ∧
      c.R ^ 2 ≤ (3 / 10 : ℚ) * c.lo ^ 2 ∧
      (c.B : ℚ) ≤ (3 / 10 : ℚ) * c.lo ^ 2 ∧
      (c.H : ℚ) / 10 ≤ c.S ∧ c.hi - c.D ≤ c.S ∧ c.b ≤ c.R ∧ c.S ≤ c.R + c.d)

