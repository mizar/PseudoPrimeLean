private theorem row_length (i : Fin 5) : (upperRows i).length = k131BernsteinDegree i + 1 := by
  have h : ∀ j : Fin 5, (upperRows j).length = k131BernsteinDegree j + 1 := by decide +kernel
  exact h i

/-- The rational upper endpoint of one Bernstein coefficient of a K131
curvature certificate, indexed by its exponent row and Bernstein index. -/
def k131BernsteinUpper (i : Fin 5) (j : Fin (k131BernsteinDegree i + 1)) : ℚ :=
  (upperRows i).get ⟨j.val, j.isLt.trans_eq (row_length i).symm⟩

/-- All 83 Bernstein upper endpoints are at most minus one. -/
theorem k131_bernstein_upper_le (i : Fin 5) (j : Fin (k131BernsteinDegree i + 1)) :
    k131BernsteinUpper i j ≤ -1 := by
  have h : ∀ (k : Fin 5) (l : Fin (k131BernsteinDegree k + 1)), k131BernsteinUpper k l ≤ -1 := by
    decide +kernel
  exact h i j

/-- A K131 curvature polynomial with the certified Bernstein coefficient
bounds is strictly negative throughout its real interval. -/
theorem k131_bernstein_interval_neg (i : Fin 5) {a b x : ℝ} (hab : a < b) (hx : x ∈ Set.Icc a b)
    (f : ℝ → ℝ) (c : Fin (k131BernsteinDegree i + 1) → ℝ)
    (hc : ∀ j, c j ≤ (k131BernsteinUpper i j : ℝ))
    (hrep :
      ∀ t : Set.Icc (0 : ℝ) 1,
        f (a + (b - a) * (t : ℝ)) = ∑ j, c j * bernstein (k131BernsteinDegree i) j t) :
    f x < 0 := by
  have h :=
    Analysis.bernstein_interval_le hab hx.1 hx.2 f (k131BernsteinDegree i) c (-1)
      (fun j ↦ (hc j).trans (by exact_mod_cast k131_bernstein_upper_le i j)) hrep
  exact h.trans_lt (by norm_num only)

/-- Check a shifted and rescaled K131 power polynomial against the rational
table. The caller supplies upper bounds for the power-to-Bernstein transform. -/
theorem k131_power_interval_neg (i : Fin 5) {a b x : ℝ} (hab : a < b) (hx : x ∈ Set.Icc a b)
    (f : ℝ → ℝ) (A : Fin (k131BernsteinDegree i + 1) → ℝ)
    (hA :
      ∀ k : Fin (k131BernsteinDegree i + 1),
        (∑ j : Fin (k131BernsteinDegree i + 1),
            A j * ((k.val.choose j.val : ℝ) / ((k131BernsteinDegree i).choose j.val : ℝ))) ≤
          (k131BernsteinUpper i k : ℝ))
    (hrep : ∀ t : Set.Icc (0 : ℝ) 1, f (a + (b - a) * (t : ℝ)) = ∑ j, A j * (t : ℝ) ^ j.val) :
    f x < 0 := by
  apply k131_bernstein_interval_neg i hab hx f _ hA
  intro t
  exact (hrep t).trans (Analysis.bernstein_power_sum (k131BernsteinDegree i) A t).symm

