/-- Degrees of the five K131 sign certificates in the order of exponents
19/8, 27/8, 5, 23/4 and 27/4. The first includes the exponential majorant. -/
@[expose]
def k131BernsteinDegree : Fin 5 → ℕ :=
  ![19, 19, 0, 19, 21]

/-- The exponential majorant and the curvature for exponent 19/8 use degree 19. -/
theorem k131_bernstein_degree_zero : k131BernsteinDegree 0 = 19 :=
  rfl

/-- The curvature for exponent 27/8 uses degree 19. -/
theorem k131_bernstein_degree_one : k131BernsteinDegree 1 = 19 :=
  rfl

