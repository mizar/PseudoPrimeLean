/-- A rational lower cap for the finite main sum through 587. -/
def gammaFixed17Main18Lower : ℚ :=
  7574851 / 500000

set_option maxRecDepth 8192 in
/-- Every rounded endpoint is valid for its corresponding prime-power row.
The list checker also proves that the endpoint and support lengths agree. -/
theorem gammaFixed17Main18_exp_check :
    gammaMainListCheck gammaMainCell17Scale (centerRowsBelow 587) gammaFixed17Main18Exp = true := by
  decide +kernel

set_option maxRecDepth 8192 in
/-- The rational weighted aggregate of the checked endpoints exceeds its cap.
Kernel reduction verifies the finite sum for cutoff 587. -/
theorem gammaFixed17Main18_sum_check :
    gammaFixed17Main18Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell17Radius) (centerRowsBelow 587)
          gammaFixed17Main18Exp).sum := by
  decide +kernel

/-- The actual normalized main sum exceeds the checked rational cap at the
fixed scale. The support and row soundness transfer each verified endpoint. -/
theorem gammaFixed17Main18_actual_lower :
    (gammaFixed17Main18Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 587,
        Real.exp (-(n : ℝ) / (gammaMainCell17Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell17Scale : ℝ) := by
  exact
    gamma_main_prefix_approx_lower (by norm_num only : 587 ≤ 50000) gammaFixed17Main18Exp
      gammaMainCell17_scale_check.1 gammaMainCell17_scale_check.2.1 gammaMainCell17_scale_check.2.2
      (gammaMainListCheck_sound gammaFixed17Main18_exp_check) gammaFixed17Main18_sum_check

