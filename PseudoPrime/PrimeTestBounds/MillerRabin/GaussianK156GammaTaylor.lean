/-- The stored weighted input numerators agree with the existing K156
profile on all stored entries. -/
private theorem input_check :
    (List.range 52).all
        (fun k ↦ input[k]?.getD 0 == BData.num k * (k.factorial : ℤ) * (20 : ℤ) ^ k) =
      true := by
  decide +kernel

/-- The stored output satisfies the initial condition and all 79 steps. -/
private theorem output_check : gammaTaylorRowCheck 28 79 input output = true := by decide +kernel

/-- The weighted input row, including its zero padding, has the same
coefficients as the Lean K156 profile. -/
private theorem input_coeff (k : ℕ) :
    middleK156Profile.coeff k * (k.factorial : ℚ) =
      (input[k]?.getD 0 : ℚ) / ((BData.den : ℚ) * (20 : ℚ) ^ k) := by
  have hsize : BData.nums.size ≤ 52 := by decide
  rw [middleK156Profile, BData.poly_coeff_all 51 hsize]
  by_cases hk : k < 52
  · have h := input_check
    simp only [List.all_eq_true, beq_iff_eq, List.mem_range] at h
    rw [h k hk]
    simp only [Int.cast_mul, Int.cast_pow, Int.cast_natCast, Int.cast_ofNat]
    field_simp [pow_ne_zero k (by norm_num only : (20 : ℚ) ≠ 0)]
  · have hi : input[k]? = none :=
      Array.getElem?_eq_none ((by decide : input.size ≤ 52).trans (le_of_not_gt hk))
    have hb : BData.nums[k]? = none := Array.getElem?_eq_none (hsize.trans (le_of_not_gt hk))
    simp only [hi, hb, MiddleIntRow.num, Option.getD_none, Int.cast_zero, zero_div, zero_mul]

/-- The concrete integer certificate gives the nonconstant coefficients
of the degree-28 Taylor convolution of the K156 profile through degree 80. -/
private theorem middle_k156_taylor_coeff {k : ℕ} (hk : k ≤ 79) :
    (gammaTaylorConvolution middleK156Profile (1 / 20) 28).coeff (k + 1) =
      (output[k]?.getD 0 : ℚ) / ((BData.den : ℚ) * (20 : ℚ) ^ k) / ((k + 1).factorial : ℚ) := by
  apply gamma_taylor_int_row_eq middleK156Profile 28 79 input output output_check _ k hk
  intro i _
  rw [gamma_factorial_input_coeff]
  exact input_coeff i

/-- The rational polynomial for the second K156 pole, reconstructed
from the checked, factorial-scaled integer coefficients. -/
public noncomputable def middleK156SecondPole : Polynomial ℚ :=
  Polynomial.ofFn 81 fun i ↦
    if i.val = 0 then 0
    else
      (output[i.val - 1]?.getD 0 : ℚ) / ((BData.den : ℚ) * (20 : ℚ) ^ (i.val - 1)) /
        (i.val.factorial : ℚ)

/-- The degree bound follows from the profile degree and the Taylor order. -/
private theorem taylor_degree :
    (gammaTaylorConvolution middleK156Profile (1 / 20) 28).natDegree ≤ 80 := by
  have hP : middleK156Profile.natDegree ≤ 51 := by
    exact Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (by decide) _)
  unfold gammaTaylorConvolution
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro j hj
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro i hi
  refine Polynomial.natDegree_mul_le.trans ?_
  rw [Polynomial.natDegree_C, Polynomial.natDegree_X_pow, zero_add]
  have h₁ := (Nat.le_of_lt_succ (Finset.mem_range.mp hi)).trans hP
  have h₂ := Nat.le_of_lt_succ (Finset.mem_range.mp hj)
  exact Nat.add_le_add_right (Nat.add_le_add h₁ h₂) 1

/-- The checked polynomial is exactly the rational Taylor convolution. -/
public theorem middle_k156_second_pole_eq :
    middleK156SecondPole = gammaTaylorConvolution middleK156Profile (1 / 20) 28 := by
  ext k
  by_cases hk : k < 81
  · rw [middleK156SecondPole, Polynomial.ofFn_coeff_eq_val_of_lt _ hk]
    cases k with
    | zero =>
      unfold gammaTaylorConvolution
      simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow, Nat.zero_ne_add_one,
        ite_false, Finset.sum_const_zero, ite_true]
    | succ k =>
      have hn : k ≤ 79 := Nat.le_of_lt_succ (Nat.lt_of_succ_lt_succ hk)
      simpa only [Nat.succ_ne_zero, ite_false, Nat.succ_sub_one] using
        (middle_k156_taylor_coeff hn).symm
  · rw [middleK156SecondPole, Polynomial.ofFn_coeff_eq_zero_of_ge _ (le_of_not_gt hk),
      Polynomial.coeff_eq_zero_of_natDegree_lt (taylor_degree.trans_lt (le_of_not_gt hk))]

/-- The actual second K156 pole differs from the checked polynomial by
the uniform Taylor error on the middle physical height range. -/
public theorem middle_k156_second_pole_le {z M : ℝ} (hz : 0 < z) (hz' : z ≤ 135 / 4)
    (hM : ∀ v ∈ Set.Icc 0 z, |(middleK156Profile.map (Rat.castHom ℝ)).eval v| ≤ M) :
    |(∫ v in (0 : ℝ)..z,
            Real.exp (-(1 / 20 : ℝ) * (z - v)) * (middleK156Profile.map (Rat.castHom ℝ)).eval v) -
          (middleK156SecondPole.map (Rat.castHom ℝ)).eval z| ≤
      ((27 / 16 : ℝ) ^ 29 / (Nat.factorial 29 : ℝ)) * M * (135 / 4) := by
  rw [middle_k156_second_pole_eq]
  exact middle_k156_second_pole_poly middleK156Profile hz hz' 28 hM

/-- One integer comparison bounds the absolute coefficient sum at the
largest physical height. The powers of four clear the evaluation denominator. -/
private theorem profile_cap_check :
    (∑ k ∈ Finset.range 52, |BData.num k| * (135 : ℤ) ^ k * 4 ^ (51 - k)) ≤
      (73 * 10 ^ 46 : ℤ) * (BData.den * 4 ^ 51) := by
  decide +kernel

/-- The integer certificate bounds the K156 profile throughout the full
integration interval used for the second forward pole. -/
private theorem profile_cap {v : ℝ} (hv : 0 ≤ v) (hv' : v ≤ 135 / 4) :
    |(middleK156Profile.map (Rat.castHom ℝ)).eval v| ≤ (73 * 10 ^ 46 : ℝ) := by
  let S : ℝ := (BData.den : ℝ) * (4 : ℝ) ^ 51
  have hD : 0 < (BData.den : ℝ) := Int.cast_pos.mpr (by decide)
  have hS : 0 < S := mul_pos hD (pow_pos (by norm_num only) _)
  have hdeg : (middleK156Profile.map (Rat.castHom ℝ)).natDegree < 52 :=
    Polynomial.natDegree_map_le.trans_lt (Polynomial.ofFn_natDegree_lt (by decide) _)
  rw [Polynomial.eval_eq_sum_range' hdeg]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  have hcheck :
    (∑ k ∈ Finset.range 52, |(BData.num k : ℝ)| * (135 : ℝ) ^ k * 4 ^ (51 - k)) ≤
      (73 * 10 ^ 46 : ℝ) * S := by
    dsimp only [S]
    exact_mod_cast profile_cap_check
  refine
    (Finset.sum_le_sum (g := fun k ↦ (|(BData.num k : ℝ)| * (135 : ℝ) ^ k * 4 ^ (51 - k)) / S)
          ?_).trans
      ?_
  · intro k hk
    have h₅₁ : k ≤ 51 := Nat.le_of_lt_succ (Finset.mem_range.mp hk)
    rw [Polynomial.coeff_map, Rat.coe_castHom, middleK156Profile, BData.poly_coeff h₅₁,
      Rat.cast_div, Rat.cast_intCast, Rat.cast_intCast, abs_mul, abs_pow, abs_of_nonneg hv, abs_div,
      abs_of_pos hD]
    refine
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hv hv' k)
            (div_nonneg (abs_nonneg (BData.num k : ℝ)) hD.le)).trans_eq
        ?_
    dsimp only [S]
    have hp : (4 : ℝ) ^ 51 = 4 ^ k * 4 ^ (51 - k) := by rw [← pow_add, Nat.add_sub_of_le h₅₁]
    rw [div_pow, hp]
    field_simp [hD.ne', pow_ne_zero _ (by norm_num only : (4 : ℝ) ≠ 0)]
  · rw [← Finset.sum_div]
    exact (div_le_iff₀ hS).mpr hcheck

/-- At the lower K156 height, the physical exponential factor is below
`2⁻⁹⁶`, using the degree-three Taylor lower bound at seven tenths. -/
private theorem physical_exp_le {z : ℝ} (hz : 55 / 2 ≤ z) :
    Real.exp (-(49 / 20 : ℝ) * z) ≤ (2 : ℝ)⁻¹ ^ 96 := by
  have ht := Real.sum_le_exp_of_nonneg (by norm_num only : (0 : ℝ) ≤ 7 / 10) 4
  have h₂ : (2 : ℝ) ≤ Real.exp (7 / 10) := by
    refine le_trans ?_ ht
    norm_num only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial_succ,
      Nat.factorial_zero, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one, pow_zero, pow_succ]
  have hE : Real.exp (-(7 / 10 : ℝ)) ≤ (2 : ℝ)⁻¹ := by
    rw [Real.exp_neg]
    exact inv_anti₀ (by norm_num only) h₂
  calc
    Real.exp (-(49 / 20 : ℝ) * z) ≤ Real.exp ((96 : ℝ) * -(7 / 10)) :=
      Real.exp_le_exp.mpr (by linarith only [hz])
    _ ≤ (2 : ℝ)⁻¹ ^ 96 := by
      rw [← show ((96 : ℕ) : ℝ) = 96 by norm_num only, Real.exp_natCast_mul]
      exact pow_le_pow_left₀ (Real.exp_pos _).le hE _

/-- On the K156 middle interval, replacing the second forward pole by
the certified Taylor polynomial costs at most one millionth after physical scaling. -/
public theorem middle_k156_pole_error_scaled {z : ℝ} (hz : 55 / 2 ≤ z) (hz' : z ≤ 135 / 4) :
    (middleK156Norm : ℝ) * Real.exp (-(49 / 20 : ℝ) * z) *
        |(∫ v in (0 : ℝ)..z,
              Real.exp (-(1 / 20 : ℝ) * (z - v)) * (middleK156Profile.map (Rat.castHom ℝ)).eval v) -
            (middleK156SecondPole.map (Rat.castHom ℝ)).eval z| ≤
      1 / 10 ^ 6 := by
  have hn : 0 ≤ (middleK156Norm : ℝ) := Rat.cast_nonneg.mpr (by decide +kernel)
  have hz₀ : 0 < z := (by norm_num only : (0 : ℝ) < 55 / 2).trans_le hz
  have h := middle_k156_second_pole_le hz₀ hz' (fun v hv ↦ profile_cap hv.1 (hv.2.trans hz'))
  refine
    (mul_le_mul (mul_le_mul_of_nonneg_left (physical_exp_le hz) hn) h (abs_nonneg _)
          (mul_nonneg hn (pow_nonneg (by norm_num only) _))).trans
      ?_
  have hnum :
    middleK156Norm * ((2 : ℚ)⁻¹ ^ 96) *
        ((27 / 16 : ℚ) ^ 29 / (Nat.factorial 29 : ℚ) * (73 * 10 ^ 46) * (135 / 4)) ≤
      1 / 10 ^ 6 := by
    decide +kernel
  simpa only [Rat.cast_mul, Rat.cast_div, Rat.cast_inv, Rat.cast_pow, Rat.cast_natCast,
    Rat.cast_one, Rat.cast_ofNat] using (Rat.cast_le (K := ℝ)).mpr hnum

/-- For an upper bound on the forward Gamma contour, replace its
negative second-pole charge by the checked polynomial plus the error allowance. -/
public theorem middle_k156_neg_pole_le {z : ℝ} (hz : 55 / 2 ≤ z) (hz' : z ≤ 135 / 4) :
    let W := (middleK156Norm : ℝ) * Real.exp (-(49 / 20 : ℝ) * z)
    (-W) *
        (∫ v in (0 : ℝ)..z,
          Real.exp (-(1 / 20 : ℝ) * (z - v)) * (middleK156Profile.map (Rat.castHom ℝ)).eval v) ≤
      (-W) * (middleK156SecondPole.map (Rat.castHom ℝ)).eval z + 1 / 10 ^ 6 := by
  intro W
  have hW : 0 ≤ W := mul_nonneg (Rat.cast_nonneg.mpr (by decide +kernel)) (Real.exp_pos _).le
  have h := middle_k156_pole_error_scaled hz hz'
  let E :=
    (∫ v in (0 : ℝ)..z,
        Real.exp (-(1 / 20 : ℝ) * (z - v)) * (middleK156Profile.map (Rat.castHom ℝ)).eval v) -
      (middleK156SecondPole.map (Rat.castHom ℝ)).eval z
  have h₀ := mul_le_mul_of_nonneg_left (neg_le_abs E) hW
  dsimp only [W, E] at h₀ ⊢
  linarith only [h₀, h]

/-- Combine the two isolated forward poles for K156. The first is evaluated
exactly, and the checked second-pole polynomial contributes one error allowance. -/
public theorem middle_k156_gamma_head_le {z : ℝ} (hz : 55 / 2 ≤ z) (hz' : z ≤ 135 / 4) :
    let P := middleK156Profile.map (Rat.castHom ℝ)
    let a : ℝ := 49 / 20
    let κ := (middleK156Norm : ℝ)
    let W := κ * Real.exp (-a * z)
    let M := fun y : ℝ ↦
      ∑ j ∈ Finset.range (P.natDegree + 1),
        ((Polynomial.derivative^[j]) P).eval y / (a - 1 / 2) ^ (j + 1)
    (-W) * (∫ v in (0 : ℝ)..z, Real.exp ((a - 1 / 2) * (z - v)) * P.eval v) -
        W * (∫ v in (0 : ℝ)..z, Real.exp (-(1 / 20 : ℝ) * (z - v)) * P.eval v) ≤
      W * (M z - (middleK156SecondPole.map (Rat.castHom ℝ)).eval z) -
          κ * (Real.exp (-(1 / 2) * z) * M 0) +
        1 / 10 ^ 6 := by
  intro P a κ W M
  have hz₀ : 0 ≤ z := (by norm_num only : (0 : ℝ) ≤ 55 / 2).trans hz
  have h₁ := gamma_growing_moment (P := P) (a := a) (q := 1 / 2) (by norm_num only [a]) hz₀
  have h₂ := middle_k156_neg_pole_le hz hz'
  change
    Real.exp (-a * z) * (∫ v in (0 : ℝ)..z, Real.exp ((a - 1 / 2) * (z - v)) * P.eval v) =
      Real.exp (-(1 / 2) * z) * M 0 - Real.exp (-a * z) * M z at h₁
  have h₃ := congrArg (κ * ·) h₁
  dsimp only [P, a, W, κ] at h₂ h₃ ⊢
  linarith only [h₂, h₃]

/-- Bound both K156 Gamma contours throughout the middle range. The second
pole uses the checked polynomial with a one-millionth physical error. -/
public theorem middle_k156_gamma_contour_le {x : ℝ} (hx : 24 ≤ x) (hx' : x ≤ 121 / 4) :
    let a : ℝ := 49 / 20
    let b : ℝ := 7 / 2
    let ha : 1 / 2 < a := by norm_num only [a]
    let r := fun t : ℝ ↦ ((9 / 16 : ℝ) : ℂ) + Complex.I * t
    let l := fun t : ℝ ↦ ((-(9 / 16) : ℝ) : ℂ) + Complex.I * t
    let F := fun s ↦
      ∑ i ∈ Finset.Ico 3 52,
        ((middleK156Kernel ^ 2).coeff (51 - i) : ℂ) *
          (LLS.PaperStatements.shiftedPoleKernel (max 1 i) a b (le_max_left _ _) ha).function s
    let W := fun s : ℂ ↦ F s * Complex.exp (s * (x : ℂ))
    let P := middleK156Profile.map (Rat.castHom ℝ)
    let z := b + x
    let D := ((1 / (2 * Real.pi) : ℝ) : ℂ)
    let κ := (middleK156Norm : ℝ)
    κ *
        ((D * (∫ t : ℝ, logDeriv Complex.Gammaℝ (r t + 1 / 2) * W (r t))).re +
          (D * (∫ t : ℝ, logDeriv Complex.Gammaℝ (1 / 2 - l t) * W (l t))).re) ≤
      κ * Real.exp (-a * z) *
            ((∑ j ∈ Finset.range (P.natDegree + 1),
                middleGammaDerivCoeff (49 / 20 : ℚ) false j *
                  ((Polynomial.derivative^[j]) P).eval z) -
              (middleK156SecondPole.map (Rat.castHom ℝ)).eval z) -
          κ *
            (Real.exp (-(1 / 2) * z) * (middleK156Kernel.eval₂ (Rat.castHom ℝ) (a - 1 / 2)) ^ 2 /
              (a - 1 / 2) ^ 52) +
        1 / 10 ^ 6 := by
  intro a b ha r l F W P z D κ
  have hdeg : 2 * middleK156Kernel.natDegree + 3 ≤ 51 :=
    Nat.add_le_add_right (Nat.mul_le_mul_left 2 middle_k156_kernel_degree) 3
  have hz₀ : 55 / 2 ≤ z := by
    dsimp only [z, b]; linarith only [hx]
  have hz₁ : z ≤ 135 / 4 := by
    dsimp only [z, b]; linarith only [hx']
  have hzpos : 0 < b + x := (by norm_num only : (0 : ℝ) < 55 / 2).trans_le hz₀
  have h :=
    middle_gamma_contour_le middleK156Kernel hdeg (a := a) (by decide) (by norm_num only [a])
      (by norm_num only [a]) hzpos
  dsimp only at h
  rw [← middle_k156_profile_eq_pole] at h
  have hκ : 0 ≤ κ := Rat.cast_nonneg.mpr (by decide +kernel)
  have hmain := mul_le_mul_of_nonneg_left h hκ
  have hp := middle_k156_neg_pole_le hz₀ hz₁
  have hr : a - 5 / 2 = -(1 / 20 : ℝ) := by norm_num only [a]
  rw [hr] at hmain
  have hcoeff := middle_gamma_deriv_sum_real P (49 / 20 : ℚ) false z
  dsimp only at hcoeff
  norm_num only [Rat.cast_div, Rat.cast_ofNat, Bool.false_eq_true, ite_false, sub_zero] at hcoeff
  rw [hcoeff]
  dsimp only [r, l, F, W, P, z, D, κ] at hmain hp ⊢
  norm_num only [a] at hmain hp ⊢
  linear_combination hmain + hp

end PseudoPrime.PrimeTestBounds.MillerRabin
