/-- The initial row repeats the last exact count above budget 358. -/
theorem target030Seed163_base_eq :
    ∀ h ≤ 450, target030Seed163Row0.getD h 0 = target030Seed113Row6.getD (min h 358) 0 := by
  decide +kernel

/-- Count monotonicity makes the extended initial row a lower bound. -/
theorem target030Seed163_base_lower :
    ∀ h ≤ 450, target030Seed163Row0.getD h 0 ≤ weightedPrimeCount id target030Seed113Weights h := by
  intro h hh
  have hv := target030Seed113_count_correct (min h 358) (Nat.min_le_right h 358)
  have hm := weightedPrimeCount_mono id target030Seed113Weights (Nat.min_le_left h 358)
  rw [← hv] at hm
  exact (target030Seed163_base_eq h hh).le.trans hm

/-- The kernel verifies update row 1 through budget 450. -/
