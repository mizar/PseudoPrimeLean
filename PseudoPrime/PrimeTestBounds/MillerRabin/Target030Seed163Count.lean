/-- Eight checked updates give a weighted-count lower bound through 450.
The proof propagates the existing lower bound through every new prime label. -/
theorem target030Seed163_lower :
    ∀ h ≤ 450,
      target030Seed163Row8.getD h 0 ≤
        weightedPrimeCount id ([51, 51, 51, 51, 50, 50, 49, 49] ++ target030Seed113Weights) h := by
  have h0 := target030Seed163_base_lower
  have h1 :=
    weightedPrimeRow_lower 49 450 (target030Seed113Weights) target030Seed163Row0
      target030Seed163Row1 target030Seed163Check1 h0
  have h2 :=
    weightedPrimeRow_lower 49 450 (49 :: target030Seed113Weights) target030Seed163Row1
      target030Seed163Row2 target030Seed163Check2 h1
  have h3 :=
    weightedPrimeRow_lower 50 450 (49 :: 49 :: target030Seed113Weights) target030Seed163Row2
      target030Seed163Row3 target030Seed163Check3 h2
  have h4 :=
    weightedPrimeRow_lower 50 450 (50 :: 49 :: 49 :: target030Seed113Weights) target030Seed163Row3
      target030Seed163Row4 target030Seed163Check4 h3
  have h5 :=
    weightedPrimeRow_lower 51 450 (50 :: 50 :: 49 :: 49 :: target030Seed113Weights)
      target030Seed163Row4 target030Seed163Row5 target030Seed163Check5 h4
  have h6 :=
    weightedPrimeRow_lower 51 450 (51 :: 50 :: 50 :: 49 :: 49 :: target030Seed113Weights)
      target030Seed163Row5 target030Seed163Row6 target030Seed163Check6 h5
  have h7 :=
    weightedPrimeRow_lower 51 450 (51 :: 51 :: 50 :: 50 :: 49 :: 49 :: target030Seed113Weights)
      target030Seed163Row6 target030Seed163Row7 target030Seed163Check7 h6
  have h8 :=
    weightedPrimeRow_lower 51 450
      (51 :: 51 :: 51 :: 50 :: 50 :: 49 :: 49 :: target030Seed113Weights) target030Seed163Row7
      target030Seed163Row8 target030Seed163Check8 h7
  exact h8

