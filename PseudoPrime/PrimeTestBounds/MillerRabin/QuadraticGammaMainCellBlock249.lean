/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell272_exp_check :
    gammaMainListCheck gammaMainCell272Scale (centerRowsBelow 2347) gammaMainCell272Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell272Lower : ℚ :=
  (1515586799 / 50000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell272_sum_check :
    gammaMainCell272Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell272Radius) (centerRowsBelow 2347)
          gammaMainCell272Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell272_scale_check :
    0 < gammaMainCell272Scale ∧
      0 < gammaMainCell272Radius ∧ gammaMainCell272Scale ≤ gammaMainCell272Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell272_actual_lower :
    (gammaMainCell272Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2347,
        Real.exp (-(n : ℝ) / (gammaMainCell272Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell272Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2347 ≤ 50000) gammaMainCell272Exp
    gammaMainCell272_scale_check.1 gammaMainCell272_scale_check.2.1 gammaMainCell272_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell272_exp_check) gammaMainCell272_sum_check

