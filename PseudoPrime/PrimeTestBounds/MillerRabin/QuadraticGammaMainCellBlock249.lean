          Real.sqrt (gammaMainCell277Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2381 ≤ 50000) gammaMainCell277Exp
    gammaMainCell277_scale_check.1 gammaMainCell277_scale_check.2.1 gammaMainCell277_scale_check.2.2
