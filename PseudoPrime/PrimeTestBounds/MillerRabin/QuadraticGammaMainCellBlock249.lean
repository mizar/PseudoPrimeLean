    (gammaMainCell290Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2467,
        Real.exp (-(n : ℝ) / (gammaMainCell290Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell290Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2467 ≤ 50000) gammaMainCell290Exp
    gammaMainCell290_scale_check.1 gammaMainCell290_scale_check.2.1 gammaMainCell290_scale_check.2.2
