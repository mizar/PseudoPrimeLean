/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell289_exp_check :
    gammaMainListCheck gammaMainCell289Scale (centerRowsBelow 2459) gammaMainCell289Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell289Lower : ℚ :=
  (3109396291 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell289_sum_check :
    gammaMainCell289Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell289Radius) (centerRowsBelow 2459)
          gammaMainCell289Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell289_scale_check :
    0 < gammaMainCell289Scale ∧
      0 < gammaMainCell289Radius ∧ gammaMainCell289Scale ≤ gammaMainCell289Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell289_actual_lower :
    (gammaMainCell289Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2459,
        Real.exp (-(n : ℝ) / (gammaMainCell289Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell289Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2459 ≤ 50000) gammaMainCell289Exp
    gammaMainCell289_scale_check.1 gammaMainCell289_scale_check.2.1 gammaMainCell289_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell289_exp_check) gammaMainCell289_sum_check

