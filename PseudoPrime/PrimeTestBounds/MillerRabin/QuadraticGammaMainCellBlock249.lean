/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell264Exp : List ℚ :=
  List.flatten [gammaMainCell264Exp0, gammaMainCell264Exp128, gammaMainCell264Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell264_exp_check :
    gammaMainListCheck gammaMainCell264Scale (centerRowsBelow 2287) gammaMainCell264Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell264Lower : ℚ :=
  (2991526981 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell264_sum_check :
    gammaMainCell264Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell264Radius) (centerRowsBelow 2287)
          gammaMainCell264Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell264_scale_check :
    0 < gammaMainCell264Scale ∧
      0 < gammaMainCell264Radius ∧ gammaMainCell264Scale ≤ gammaMainCell264Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell264_actual_lower :
    (gammaMainCell264Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2287,
        Real.exp (-(n : ℝ) / (gammaMainCell264Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell264Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2287 ≤ 50000) gammaMainCell264Exp
    gammaMainCell264_scale_check.1 gammaMainCell264_scale_check.2.1 gammaMainCell264_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell264_exp_check) gammaMainCell264_sum_check

