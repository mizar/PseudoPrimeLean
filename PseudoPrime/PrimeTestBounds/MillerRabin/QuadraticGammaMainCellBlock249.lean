/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell300_exp_check :
    gammaMainListCheck gammaMainCell300Scale (centerRowsBelow 2557) gammaMainCell300Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell300Lower : ℚ :=
  (3164443297 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell300_sum_check :
    gammaMainCell300Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell300Radius) (centerRowsBelow 2557)
          gammaMainCell300Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell300_scale_check :
    0 < gammaMainCell300Scale ∧
      0 < gammaMainCell300Radius ∧ gammaMainCell300Scale ≤ gammaMainCell300Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell300_actual_lower :
    (gammaMainCell300Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2557,
        Real.exp (-(n : ℝ) / (gammaMainCell300Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell300Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2557 ≤ 50000) gammaMainCell300Exp
    gammaMainCell300_scale_check.1 gammaMainCell300_scale_check.2.1 gammaMainCell300_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell300_exp_check) gammaMainCell300_sum_check

