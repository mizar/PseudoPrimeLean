/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell257Exp : List ℚ :=
  List.flatten [gammaMainCell257Exp0, gammaMainCell257Exp128, gammaMainCell257Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell257_exp_check :
    gammaMainListCheck gammaMainCell257Scale (centerRowsBelow 2239) gammaMainCell257Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell257Lower : ℚ :=
  (1478639047 / 50000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell257_sum_check :
    gammaMainCell257Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell257Radius) (centerRowsBelow 2239)
          gammaMainCell257Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell257_scale_check :
    0 < gammaMainCell257Scale ∧
      0 < gammaMainCell257Radius ∧ gammaMainCell257Scale ≤ gammaMainCell257Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell257_actual_lower :
    (gammaMainCell257Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2239,
        Real.exp (-(n : ℝ) / (gammaMainCell257Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell257Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2239 ≤ 50000) gammaMainCell257Exp
    gammaMainCell257_scale_check.1 gammaMainCell257_scale_check.2.1 gammaMainCell257_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell257_exp_check) gammaMainCell257_sum_check

