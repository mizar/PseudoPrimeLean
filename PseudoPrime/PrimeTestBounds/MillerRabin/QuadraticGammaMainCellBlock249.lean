/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell249Exp : List ℚ :=
  List.flatten [gammaMainCell249Exp0, gammaMainCell249Exp128, gammaMainCell249Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell249_exp_check :
    gammaMainListCheck gammaMainCell249Scale (centerRowsBelow 2187) gammaMainCell249Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell249Lower : ℚ :=
  (58455019 / 2000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell249_sum_check :
    gammaMainCell249Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell249Radius) (centerRowsBelow 2187)
          gammaMainCell249Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell249_scale_check :
    0 < gammaMainCell249Scale ∧
      0 < gammaMainCell249Radius ∧ gammaMainCell249Scale ≤ gammaMainCell249Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell249_actual_lower :
    (gammaMainCell249Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2187,
        Real.exp (-(n : ℝ) / (gammaMainCell249Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell249Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2187 ≤ 50000) gammaMainCell249Exp
    gammaMainCell249_scale_check.1 gammaMainCell249_scale_check.2.1 gammaMainCell249_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell249_exp_check) gammaMainCell249_sum_check

