          Real.sqrt (gammaMainCell298Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2549 ≤ 50000) gammaMainCell298Exp
    gammaMainCell298_scale_check.1 gammaMainCell298_scale_check.2.1 gammaMainCell298_scale_check.2.2
