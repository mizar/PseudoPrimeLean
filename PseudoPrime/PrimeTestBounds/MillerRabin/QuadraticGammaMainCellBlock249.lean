/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell250Exp : List ℚ :=
  List.flatten [gammaMainCell250Exp0, gammaMainCell250Exp128, gammaMainCell250Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell250_exp_check :
    gammaMainListCheck gammaMainCell250Scale (centerRowsBelow 2197) gammaMainCell250Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell250Lower : ℚ :=
  (585122287 / 20000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell250_sum_check :
    gammaMainCell250Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell250Radius) (centerRowsBelow 2197)
          gammaMainCell250Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell250_scale_check :
    0 < gammaMainCell250Scale ∧
      0 < gammaMainCell250Radius ∧ gammaMainCell250Scale ≤ gammaMainCell250Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell250_actual_lower :
    (gammaMainCell250Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2197,
        Real.exp (-(n : ℝ) / (gammaMainCell250Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell250Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2197 ≤ 50000) gammaMainCell250Exp
    gammaMainCell250_scale_check.1 gammaMainCell250_scale_check.2.1 gammaMainCell250_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell250_exp_check) gammaMainCell250_sum_check

