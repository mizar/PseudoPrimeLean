    (gammaMainCell281Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2399,
        Real.exp (-(n : ℝ) / (gammaMainCell281Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell281Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2399 ≤ 50000) gammaMainCell281Exp
    gammaMainCell281_scale_check.1 gammaMainCell281_scale_check.2.1 gammaMainCell281_scale_check.2.2
