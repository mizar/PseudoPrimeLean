/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell310_exp_check :
    gammaMainListCheck gammaMainCell310Scale (centerRowsBelow 2659) gammaMainCell310Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell310Lower : ℚ :=
  (3215409163 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell310_sum_check :
    gammaMainCell310Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell310Radius) (centerRowsBelow 2659)
          gammaMainCell310Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell310_scale_check :
    0 < gammaMainCell310Scale ∧
      0 < gammaMainCell310Radius ∧ gammaMainCell310Scale ≤ gammaMainCell310Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell310_actual_lower :
    (gammaMainCell310Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2659,
        Real.exp (-(n : ℝ) / (gammaMainCell310Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell310Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2659 ≤ 50000) gammaMainCell310Exp
    gammaMainCell310_scale_check.1 gammaMainCell310_scale_check.2.1 gammaMainCell310_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell310_exp_check) gammaMainCell310_sum_check

