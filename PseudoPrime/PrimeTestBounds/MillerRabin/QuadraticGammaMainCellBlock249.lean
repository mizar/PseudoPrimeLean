theorem gammaMainCell303_exp_check :
    gammaMainListCheck gammaMainCell303Scale (centerRowsBelow 2593) gammaMainCell303Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell303Lower : ℚ :=
  (3180646141 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell303_sum_check :
    gammaMainCell303Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell303Radius) (centerRowsBelow 2593)
          gammaMainCell303Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
