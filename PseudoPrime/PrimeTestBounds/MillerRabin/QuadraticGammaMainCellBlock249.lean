/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell304Exp : List ℚ :=
  List.flatten
    [gammaMainCell304Exp0, gammaMainCell304Exp128, gammaMainCell304Exp256, gammaMainCell304Exp384]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell304_exp_check :
    gammaMainListCheck gammaMainCell304Scale (centerRowsBelow 2609) gammaMainCell304Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell304Lower : ℚ :=
  (318662423 / 10000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell304_sum_check :
    gammaMainCell304Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell304Radius) (centerRowsBelow 2609)
          gammaMainCell304Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell304_scale_check :
    0 < gammaMainCell304Scale ∧
      0 < gammaMainCell304Radius ∧ gammaMainCell304Scale ≤ gammaMainCell304Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell304_actual_lower :
    (gammaMainCell304Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2609,
        Real.exp (-(n : ℝ) / (gammaMainCell304Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell304Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2609 ≤ 50000) gammaMainCell304Exp
    gammaMainCell304_scale_check.1 gammaMainCell304_scale_check.2.1 gammaMainCell304_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell304_exp_check) gammaMainCell304_sum_check

