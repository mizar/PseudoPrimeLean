/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell294_exp_check :
    gammaMainListCheck gammaMainCell294Scale (centerRowsBelow 2521) gammaMainCell294Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell294Lower : ℚ :=
  (3137246179 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell294_sum_check :
    gammaMainCell294Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell294Radius) (centerRowsBelow 2521)
          gammaMainCell294Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell294_scale_check :
    0 < gammaMainCell294Scale ∧
      0 < gammaMainCell294Radius ∧ gammaMainCell294Scale ≤ gammaMainCell294Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell294_actual_lower :
    (gammaMainCell294Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2521,
        Real.exp (-(n : ℝ) / (gammaMainCell294Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell294Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2521 ≤ 50000) gammaMainCell294Exp
    gammaMainCell294_scale_check.1 gammaMainCell294_scale_check.2.1 gammaMainCell294_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell294_exp_check) gammaMainCell294_sum_check

