/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell308_exp_check :
    gammaMainListCheck gammaMainCell308Scale (centerRowsBelow 2647) gammaMainCell308Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell308Lower : ℚ :=
  (1603244557 / 50000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell308_sum_check :
    gammaMainCell308Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell308Radius) (centerRowsBelow 2647)
          gammaMainCell308Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell308_scale_check :
    0 < gammaMainCell308Scale ∧
      0 < gammaMainCell308Radius ∧ gammaMainCell308Scale ≤ gammaMainCell308Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell308_actual_lower :
    (gammaMainCell308Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2647,
        Real.exp (-(n : ℝ) / (gammaMainCell308Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell308Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2647 ≤ 50000) gammaMainCell308Exp
    gammaMainCell308_scale_check.1 gammaMainCell308_scale_check.2.1 gammaMainCell308_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell308_exp_check) gammaMainCell308_sum_check

