    (gammaMainCell276Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2377,
        Real.exp (-(n : ℝ) / (gammaMainCell276Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell276Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2377 ≤ 50000) gammaMainCell276Exp
    gammaMainCell276_scale_check.1 gammaMainCell276_scale_check.2.1 gammaMainCell276_scale_check.2.2
