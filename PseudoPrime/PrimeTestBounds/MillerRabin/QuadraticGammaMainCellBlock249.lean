/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell299_exp_check :
    gammaMainListCheck gammaMainCell299Scale (centerRowsBelow 2551) gammaMainCell299Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell299Lower : ℚ :=
  (315999373 / 10000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell299_sum_check :
    gammaMainCell299Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell299Radius) (centerRowsBelow 2551)
          gammaMainCell299Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell299_scale_check :
    0 < gammaMainCell299Scale ∧
      0 < gammaMainCell299Radius ∧ gammaMainCell299Scale ≤ gammaMainCell299Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell299_actual_lower :
    (gammaMainCell299Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2551,
        Real.exp (-(n : ℝ) / (gammaMainCell299Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell299Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2551 ≤ 50000) gammaMainCell299Exp
    gammaMainCell299_scale_check.1 gammaMainCell299_scale_check.2.1 gammaMainCell299_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell299_exp_check) gammaMainCell299_sum_check

