        Real.exp (-(n : ℝ) / (gammaMainCell305Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell305Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2617 ≤ 50000) gammaMainCell305Exp
    gammaMainCell305_scale_check.1 gammaMainCell305_scale_check.2.1 gammaMainCell305_scale_check.2.2
