/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell309Exp : List ℚ :=
  List.flatten
    [gammaMainCell309Exp0, gammaMainCell309Exp128, gammaMainCell309Exp256, gammaMainCell309Exp384]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell309_exp_check :
    gammaMainListCheck gammaMainCell309Scale (centerRowsBelow 2657) gammaMainCell309Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell309Lower : ℚ :=
  (1605770233 / 50000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell309_sum_check :
    gammaMainCell309Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell309Radius) (centerRowsBelow 2657)
          gammaMainCell309Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell309_scale_check :
    0 < gammaMainCell309Scale ∧
      0 < gammaMainCell309Radius ∧ gammaMainCell309Scale ≤ gammaMainCell309Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell309_actual_lower :
    (gammaMainCell309Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2657,
        Real.exp (-(n : ℝ) / (gammaMainCell309Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell309Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2657 ≤ 50000) gammaMainCell309Exp
    gammaMainCell309_scale_check.1 gammaMainCell309_scale_check.2.1 gammaMainCell309_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell309_exp_check) gammaMainCell309_sum_check

