/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell261Exp : List ℚ :=
  List.flatten [gammaMainCell261Exp0, gammaMainCell261Exp128, gammaMainCell261Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell261_exp_check :
    gammaMainListCheck gammaMainCell261Scale (centerRowsBelow 2269) gammaMainCell261Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell261Lower : ℚ :=
  (2977272929 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell261_sum_check :
    gammaMainCell261Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell261Radius) (centerRowsBelow 2269)
          gammaMainCell261Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell261_scale_check :
    0 < gammaMainCell261Scale ∧
      0 < gammaMainCell261Radius ∧ gammaMainCell261Scale ≤ gammaMainCell261Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell261_actual_lower :
    (gammaMainCell261Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2269,
        Real.exp (-(n : ℝ) / (gammaMainCell261Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell261Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2269 ≤ 50000) gammaMainCell261Exp
    gammaMainCell261_scale_check.1 gammaMainCell261_scale_check.2.1 gammaMainCell261_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell261_exp_check) gammaMainCell261_sum_check

