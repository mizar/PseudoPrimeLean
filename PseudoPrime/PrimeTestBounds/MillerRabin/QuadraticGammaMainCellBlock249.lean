/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell268Exp : List ℚ :=
  List.flatten [gammaMainCell268Exp0, gammaMainCell268Exp128, gammaMainCell268Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell268_exp_check :
    gammaMainListCheck gammaMainCell268Scale (centerRowsBelow 2311) gammaMainCell268Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell268Lower : ℚ :=
  (3010396613 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell268_sum_check :
    gammaMainCell268Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell268Radius) (centerRowsBelow 2311)
          gammaMainCell268Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell268_scale_check :
    0 < gammaMainCell268Scale ∧
      0 < gammaMainCell268Radius ∧ gammaMainCell268Scale ≤ gammaMainCell268Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell268_actual_lower :
    (gammaMainCell268Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2311,
        Real.exp (-(n : ℝ) / (gammaMainCell268Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell268Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2311 ≤ 50000) gammaMainCell268Exp
    gammaMainCell268_scale_check.1 gammaMainCell268_scale_check.2.1 gammaMainCell268_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell268_exp_check) gammaMainCell268_sum_check

