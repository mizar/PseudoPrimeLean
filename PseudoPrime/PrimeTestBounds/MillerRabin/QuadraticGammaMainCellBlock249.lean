/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell260Exp : List ℚ :=
  List.flatten [gammaMainCell260Exp0, gammaMainCell260Exp128, gammaMainCell260Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell260_exp_check :
    gammaMainListCheck gammaMainCell260Scale (centerRowsBelow 2267) gammaMainCell260Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell260Lower : ℚ :=
  (594627347 / 20000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell260_sum_check :
    gammaMainCell260Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell260Radius) (centerRowsBelow 2267)
          gammaMainCell260Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell260_scale_check :
    0 < gammaMainCell260Scale ∧
      0 < gammaMainCell260Radius ∧ gammaMainCell260Scale ≤ gammaMainCell260Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell260_actual_lower :
    (gammaMainCell260Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2267,
        Real.exp (-(n : ℝ) / (gammaMainCell260Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell260Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2267 ≤ 50000) gammaMainCell260Exp
    gammaMainCell260_scale_check.1 gammaMainCell260_scale_check.2.1 gammaMainCell260_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell260_exp_check) gammaMainCell260_sum_check

