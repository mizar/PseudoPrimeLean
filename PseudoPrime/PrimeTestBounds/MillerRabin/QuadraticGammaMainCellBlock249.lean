    (gammaMainCell303Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2593,
        Real.exp (-(n : ℝ) / (gammaMainCell303Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell303Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2593 ≤ 50000) gammaMainCell303Exp
    gammaMainCell303_scale_check.1 gammaMainCell303_scale_check.2.1 gammaMainCell303_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell303_exp_check) gammaMainCell303_sum_check

