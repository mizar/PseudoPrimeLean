theorem gammaMainCell276_exp_check :
    gammaMainListCheck gammaMainCell276Scale (centerRowsBelow 2377) gammaMainCell276Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell276Lower : ℚ :=
  (3050870581 / 100000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell276_sum_check :
    gammaMainCell276Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell276Radius) (centerRowsBelow 2377)
          gammaMainCell276Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
