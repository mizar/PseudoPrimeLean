/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell253Exp : List ℚ :=
  List.flatten [gammaMainCell253Exp0, gammaMainCell253Exp128, gammaMainCell253Exp256]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell253_exp_check :
    gammaMainListCheck gammaMainCell253Scale (centerRowsBelow 2209) gammaMainCell253Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell253Lower : ℚ :=
  (587436457 / 20000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell253_sum_check :
    gammaMainCell253Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell253Radius) (centerRowsBelow 2209)
          gammaMainCell253Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell253_scale_check :
    0 < gammaMainCell253Scale ∧
      0 < gammaMainCell253Radius ∧ gammaMainCell253Scale ≤ gammaMainCell253Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell253_actual_lower :
    (gammaMainCell253Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2209,
        Real.exp (-(n : ℝ) / (gammaMainCell253Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell253Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2209 ≤ 50000) gammaMainCell253Exp
    gammaMainCell253_scale_check.1 gammaMainCell253_scale_check.2.1 gammaMainCell253_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell253_exp_check) gammaMainCell253_sum_check

