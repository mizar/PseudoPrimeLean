/-- All rounded exponential lower endpoints in exact support order.
Their Taylor comparisons and equal lengths are kernel checked below. -/
def gammaMainCell280Exp : List ℚ :=
  List.flatten
    [gammaMainCell280Exp0, gammaMainCell280Exp128, gammaMainCell280Exp256, gammaMainCell280Exp384]

/-- The aligned exponential endpoints satisfy every row's Taylor conditions.
Kernel checking verifies the rational comparisons; arithmetic row soundness
is inherited from the independently checked center payload. -/
theorem gammaMainCell280_exp_check :
    gammaMainListCheck gammaMainCell280Scale (centerRowsBelow 2393) gammaMainCell280Exp = true := by
  decide +kernel

/-- Outward lower cap for the actual finite main sum in this fixed cell. -/
def gammaMainCell280Lower : ℚ :=
  (767094557 / 25000000)

/-- Exact rational aggregation certifies the proposed main lower cap. -/
theorem gammaMainCell280_sum_check :
    gammaMainCell280Lower ≤
      (List.zipWith (fun r e ↦ r.lo * e / gammaMainCell280Radius) (centerRowsBelow 2393)
          gammaMainCell280Exp).sum := by
  decide +kernel

/-- The positive scale and radius satisfy the outward square-root check. -/
theorem gammaMainCell280_scale_check :
    0 < gammaMainCell280Scale ∧
      0 < gammaMainCell280Radius ∧ gammaMainCell280Scale ≤ gammaMainCell280Radius ^ 2 := by
  decide +kernel

/-- The actual finite exponential Mangoldt sum exceeds the certified lower cap.
Apply the exact-support interface and rounded endpoint soundness theorem.
This is the finite main lower input of the signed Gamma cell comparison. -/
theorem gammaMainCell280_actual_lower :
    (gammaMainCell280Lower : ℝ) ≤
      ∑ n ∈ Finset.Ioc (0 : ℕ) 2393,
        Real.exp (-(n : ℝ) / (gammaMainCell280Scale : ℝ)) * ArithmeticFunction.vonMangoldt n /
          Real.sqrt (gammaMainCell280Scale : ℝ) :=
  gamma_main_prefix_approx_lower (by norm_num only : 2393 ≤ 50000) gammaMainCell280Exp
    gammaMainCell280_scale_check.1 gammaMainCell280_scale_check.2.1 gammaMainCell280_scale_check.2.2
    (gammaMainListCheck_sound gammaMainCell280_exp_check) gammaMainCell280_sum_check

