/--
For odd nonsquare `n < 1000000`, some stage `p` in `qNeOneMillionPrimes` satisfies
`jacobiSym n p ≠ 1`. If every stage passed, the odd-residue coverage theorem would make
`n` a square, contradicting nonsquareness. This is the finite witness-existence interface;
the stage set supplies the concrete candidate primes.
-/
theorem qNeOneMillion_exists {n : ℕ} (hn : Odd n) (hns : ¬IsSquare n) (hB : n < 1000000) :
    ∃ p ∈ qNeOneMillionPrimes, jacobiSym n p ≠ 1 := by
  by_contra h
  push Not at h
  exact hns (qNeOneMillion_wheel_2_1 hB (Nat.odd_iff.mp hn) h)

/--
Every member of `qNeOneMillionPrimes` is an odd prime at most `47`.
The proof expands finite-set membership and checks each listed prime by decision.
Together with `qNeOneMillion_exists`, this bounds the least mathematical witness.
-/
theorem qNeOneMillionPrimes_spec {p : ℕ} (hp : p ∈ qNeOneMillionPrimes) :
    Nat.Prime p ∧ Odd p ∧ p ≤ 47 := by
  norm_num only [qNeOneMillionPrimes, Finset.mem_insert, Finset.mem_singleton, List.mem_cons,
    List.not_mem_nil] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

