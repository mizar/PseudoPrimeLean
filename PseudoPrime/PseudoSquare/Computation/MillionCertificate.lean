/-- An odd nonsquare below 1000000 fails a concrete wheel stage. -/
theorem qNeOneMillion_exists {n : ℕ} (hn : Odd n) (hns : ¬IsSquare n) (hB : n < 1000000) :
    ∃ p ∈ qNeOneMillionPrimes, jacobiSym n p ≠ 1 := by
  by_contra h
  push Not at h
  exact hns (qNeOneMillion_wheel_2_1 hB (Nat.odd_iff.mp hn) h)

/-- Every wheel stage is an odd prime bounded by 47. -/
theorem qNeOneMillionPrimes_spec {p : ℕ} (hp : p ∈ qNeOneMillionPrimes) :
    Nat.Prime p ∧ Odd p ∧ p ≤ 47 := by
  norm_num [qNeOneMillionPrimes] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

