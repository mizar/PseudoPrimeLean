      (bitmapResidueCoverageEntryCheck Corollary12PrimeBitmap.primeBits) _
      (fun _ hc ↦
        bitmapResidueCoverageEntryCheck_bounded
          (fun _ hp ↦ Corollary12PrimeBitmap.primeBits_prime hp) hc)
      coverageData_checked

