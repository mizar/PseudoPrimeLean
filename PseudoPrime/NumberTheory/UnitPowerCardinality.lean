module

public import Mathlib.RingTheory.ZMod.UnitsCyclic
public import Mathlib.NumberTheory.Padics.PadicVal.Basic
public import Mathlib.Data.Nat.Factorization.Induction

/-! # Cardinalities and negative fibers of power maps on modular units -/

@[expose] public section

namespace PseudoPrime.NumberTheory

/-- For an odd prime p and positive exponent a, the E-power kernel on units modulo p^a
has cardinality gcd(p^(a-1)*(p-1), E). Cyclicity of the unit group reduces the count to
its totient. This supplies the local kernel factors in Miller–Rabin subgroup counts. -/
theorem card_unitPowerKernel_prime_pow {p a E : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (ha : 0 < a) :
    Nat.card (powMonoidHom E : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).ker =
      (p ^ (a - 1) * (p - 1)).gcd E := by
  let : NeZero (p ^ a) := ⟨pow_ne_zero a hp.ne_zero⟩
  let : IsCyclic (ZMod (p ^ a))ˣ := ZMod.isCyclic_units_of_prime_pow p hp hp2 a
  rw [IsCyclic.card_powMonoidHom_ker, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
    Nat.totient_prime_pow hp ha]

/-- In a cyclic modular unit group with distinct signs, an even cardinality of the
E-power image guarantees an E-power preimage of -1. The subgroup generated by -1 has
order two and lies in that image by the divisibility criterion for cyclic subgroups.
This certifies the negative fiber needed when counting a common sign across CRT factors. -/
theorem exists_unit_pow_eq_neg_one_of_even_image {n E : ℕ} [NeZero n] [IsCyclic (ZMod n)ˣ]
    (hne : (-1 : (ZMod n)ˣ) ≠ 1) (heven : 2 ∣ n.totient / n.totient.gcd E) :
    ∃ u : (ZMod n)ˣ, u ^ E = -1 := by
  have ho : orderOf (-1 : (ZMod n)ˣ) = 2 := by
    apply orderOf_eq_prime
    · simp only [pow_two, neg_mul_neg, one_mul]
    · exact hne
  have hle :
    Subgroup.zpowers (-1 : (ZMod n)ˣ) ≤ (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range := by
    apply IsCyclic.subgroup_le_iff_card_dvd.mpr
    rw [Nat.card_zpowers, ho, IsCyclic.card_powMonoidHom_range, Nat.card_eq_fintype_card,
      ZMod.card_units_eq_totient]
    exact heven
  exact MonoidHom.mem_range.mp (hle (Subgroup.mem_zpowers (-1)))

/-- For a prime p and a positive exponent a, the totient factor p^(a-1)*(p-1) has
gcd p-1 with p^a-1. The p-power factor is coprime to the preceding integer, while
p-1 divides p^a-1. This computes the Fermat power kernel at a prime-power modulus. -/
theorem gcd_totient_prime_pow_sub_one {p a : ℕ} (hp : p.Prime) (ha : 0 < a) :
    (p ^ (a - 1) * (p - 1)).gcd (p ^ a - 1) = p - 1 := by
  have hpos : 1 ≤ p ^ a := Nat.one_le_pow a p hp.pos
  have hcop : (p ^ a).Coprime (p ^ a - 1) :=
    (Nat.coprime_self_sub_right hpos).mpr (Nat.coprime_one_right _)
  exact
    Nat.gcd_mul_of_coprime_of_dvd ((hcop.of_dvd_left (dvd_pow_self p ha.ne')).pow_left (a - 1))
      (Nat.sub_one_dvd_pow_sub_one p a)

/-- For coprime moduli m and n, the E-power kernel modulo m*n has cardinality
equal to the product of the two local kernel cardinalities. The CRT equivalence
on units preserves powers and identifies the kernel with the product of local kernels.
Iteration assembles the prime-power factors in a Miller–Rabin subgroup count. -/
theorem card_unitPowerKernel_coprime_mul {m n E : ℕ} (hc : m.Coprime n) :
    Nat.card (powMonoidHom E : (ZMod (m * n))ˣ →* (ZMod (m * n))ˣ).ker =
      Nat.card (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).ker *
        Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker := by
  let e := (Units.mapEquiv (ZMod.chineseRemainder hc).toMulEquiv).trans .prodUnits
  have hpred :
    ∀ u : (ZMod (m * n))ˣ,
      u ∈ (powMonoidHom E : (ZMod (m * n))ˣ →* (ZMod (m * n))ˣ).ker ↔
        (e u).1 ∈ (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).ker ∧
          (e u).2 ∈ (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker := by
    intro u
    simp only [MonoidHom.mem_ker, powMonoidHom_apply]
    change
      u ^ E = 1 ↔
        ((e u) ^ E).1 = (1 : (ZMod m)ˣ × (ZMod n)ˣ).1 ∧
          ((e u) ^ E).2 = (1 : (ZMod m)ˣ × (ZMod n)ˣ).2
    rw [← Prod.ext_iff]
    rw [← map_pow, ← map_one e]
    exact e.injective.eq_iff.symm
  have hcard :=
    Nat.card_congr ((Equiv.subtypeEquiv e.toEquiv hpred).trans Equiv.subtypeProdEquivProd)
  exact hcard.trans (Nat.card_prod _ _)

/-- For coprime moduli, local E-power preimages of -1 lift to one global preimage
of -1. The CRT equivalence preserves the same negative sign in both coordinates.
This supplies the single negative fiber for the global sign-subgroup cardinality. -/
theorem exists_unit_pow_eq_neg_one_coprime_mul {m n E : ℕ} (hc : m.Coprime n)
    (hm : ∃ u : (ZMod m)ˣ, u ^ E = -1) (hn : ∃ v : (ZMod n)ˣ, v ^ E = -1) :
    ∃ w : (ZMod (m * n))ˣ, w ^ E = -1 := by
  obtain ⟨u, hu⟩ := hm
  obtain ⟨v, hv⟩ := hn
  let e := (Units.mapEquiv (ZMod.chineseRemainder hc).toMulEquiv).trans .prodUnits
  have he : e (-1) = (-1, -1) := by
    apply Prod.ext
    · apply Units.ext
      change ((ZMod.chineseRemainder hc) (-1)).1 = -1
      simp only [map_neg, map_one, Prod.fst_neg, Prod.fst_one]
    · apply Units.ext
      change ((ZMod.chineseRemainder hc) (-1)).2 = -1
      simp only [map_neg, map_one, Prod.snd_neg, Prod.snd_one]
  refine ⟨e.symm (u, v), ?_⟩
  apply e.injective
  rw [map_pow, e.apply_symm_apply, he]
  apply Prod.ext
  · change u ^ E = -1
    exact hu
  · change v ^ E = -1
    exact hv

/-- For a cyclic modular unit group, phi(n) divides E times the cardinality of
the E-power image. A generator maps into that image and is killed by its cardinality;
its original order is phi(n). This excludes a two-element image when the resulting
Fermat divisibility is impossible for a larger prime factor. -/
theorem totient_dvd_exponent_mul_card_unitPowerImage {n E : ℕ} [NeZero n] [IsCyclic (ZMod n)ˣ] :
    n.totient ∣ E * Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (ZMod n)ˣ)
  let v : (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range := ⟨g ^ E, ⟨g, rfl⟩⟩
  have hpow := congrArg Subtype.val (pow_card_eq_one' (x := v))
  change (g ^ E) ^ Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range = 1 at hpow
  rw [← pow_mul] at hpow
  have hd := orderOf_dvd_of_pow_eq_one hpow
  rw [hg, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient] at hd
  exact hd

/-- If p and q are primes with p<q, q-1 cannot divide p*q-1. Subtract the multiple
p*(q-1) to obtain divisibility of p-1, which is positive and smaller than q-1.
This excludes the minimal local power-image size in the two-prime MR branch. -/
theorem not_sub_one_dvd_prime_mul_sub_one_of_lt {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p < q) (hd : q - 1 ∣ p * q - 1) : False := by
  have hn1 : 1 ≤ p * q := Nat.mul_pos hp.pos hq.pos
  have heq : p * q - 1 = p * (q - 1) + (p - 1) := by
    nlinarith only [Nat.sub_add_cancel hp.one_lt.le, Nat.sub_add_cancel hq.one_lt.le,
      Nat.sub_add_cancel hn1]
  have hmul : q - 1 ∣ p * (q - 1) := dvd_mul_left _ _
  rw [heq] at hd
  have hsmall := (Nat.dvd_add_iff_right hmul).mpr hd
  have hle := Nat.le_of_dvd (Nat.sub_pos_of_lt hp.one_lt) hsmall
  have hlt : p - 1 < q - 1 := Nat.sub_lt_sub_right hp.one_lt.le hpq
  exact (not_lt_of_ge hle) hlt

/-- If a nonzero exponent E has smaller 2-adic valuation than N, then N/gcd(N,E)
is even. The gcd valuation is bounded by that of E, and the quotient retains a
positive 2-adic valuation. This certifies an even image for a cyclic power map. -/
theorem two_dvd_div_gcd_of_twoAdic_lt {N E : ℕ} (hE : E ≠ 0)
    (hv : padicValNat 2 E < padicValNat 2 N) : 2 ∣ N / N.gcd E := by
  have hg : padicValNat 2 (N.gcd E) ≤ padicValNat 2 E :=
    (padicValNat_dvd_iff_le hE).mp (pow_padicValNat_dvd.trans (Nat.gcd_dvd_right N E))
  apply dvd_of_one_le_padicValNat
  rw [padicValNat.div_of_dvd (Nat.gcd_dvd_left N E)]
  exact Nat.sub_pos_of_lt (lt_of_le_of_lt hg hv)

/-- For coprime nonzero moduli, the E-power image on units modulo the product
has cardinality equal to the product of local image cardinalities. Multiply
the local kernel-image identities, use the CRT kernel count, and cancel its
positive cardinality. This iterates the local image bounds over prime factors. -/
theorem card_unitPowerImage_coprime_mul {m n E : ℕ} [NeZero m] [NeZero n] (hc : m.Coprime n) :
    Nat.card (powMonoidHom E : (ZMod (m * n))ˣ →* (ZMod (m * n))ˣ).range =
      Nat.card (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).range *
        Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range := by
  let : NeZero (m * n) := ⟨mul_ne_zero (NeZero.ne m) (NeZero.ne n)⟩
  let K := Nat.card (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).ker
  let L := Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker
  let A := Nat.card (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).range
  let B := Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range
  have hcard :=
    Subgroup.card_ker_mul_card_range (powMonoidHom E : (ZMod (m * n))ˣ →* (ZMod (m * n))ˣ)
  rw [card_unitPowerKernel_coprime_mul hc, Nat.card_eq_fintype_card (α := (ZMod (m * n))ˣ),
    ZMod.card_units_eq_totient, Nat.totient_mul hc] at hcard
  have hmcard := Subgroup.card_ker_mul_card_range (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ)
  have hncard := Subgroup.card_ker_mul_card_range (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ)
  rw [Nat.card_eq_fintype_card (α := (ZMod m)ˣ), ZMod.card_units_eq_totient] at hmcard
  rw [Nat.card_eq_fintype_card (α := (ZMod n)ˣ), ZMod.card_units_eq_totient] at hncard
  have heq :
    (K * L) * Nat.card (powMonoidHom E : (ZMod (m * n))ˣ →* (ZMod (m * n))ˣ).range =
      (K * L) * (A * B) := by
    calc
      _ = m.totient * n.totient := hcard
      _ = (K * A) * (L * B) := congrArg₂ (· * ·) hmcard.symm hncard.symm
      _ = _ := by ring
  exact
    Nat.eq_of_mul_eq_mul_left
      (Nat.mul_pos (Nat.card_pos (α := (powMonoidHom E : (ZMod m)ˣ →* (ZMod m)ˣ).ker))
        (Nat.card_pos (α := (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker)))
      heq

/-- For an odd prime p not dividing E and a positive exponent a, the E-power
image modulo p^a has cardinality p^(a-1)*(p-1)/gcd(p-1,E). The p-power factor
is coprime to E and cancels from the kernel gcd. This retains the multiplicity
factor needed to exclude small global MR subgroup indices. -/
theorem card_unitPowerImage_prime_pow_of_not_dvd {p a E : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ha : 0 < a) (hpE : ¬p ∣ E) :
    Nat.card (powMonoidHom E : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).range =
      p ^ (a - 1) * ((p - 1) / (p - 1).gcd E) := by
  let : NeZero (p ^ a) := ⟨pow_ne_zero a hp.ne_zero⟩
  let : IsCyclic (ZMod (p ^ a))ˣ := ZMod.isCyclic_units_of_prime_pow p hp hp2 a
  rw [IsCyclic.card_powMonoidHom_range, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
    Nat.totient_prime_pow hp ha,
    Nat.Coprime.gcd_mul_left_cancel (p - 1) ((hp.coprime_iff_not_dvd.mpr hpE).pow_left _),
    Nat.mul_div_assoc _ (Nat.gcd_dvd_left (p - 1) E)]

/-- For nonzero n, the E-power kernel cardinality is the product of the local
kernel cardinalities over its prime-power factorization. The kernel count is
multiplicative under CRT and equals one at modulus one, so the multiplicative
factorization theorem applies. This supplies exact global MR subgroup counts. -/
theorem card_unitPowerKernel_factorization {n E : ℕ} (hn : n ≠ 0) :
    Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker =
      n.factorization.prod fun p a ↦
        Nat.card (powMonoidHom E : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).ker := by
  exact
    Nat.multiplicative_factorization
      (fun n ↦ Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).ker)
      (fun _ _ hc ↦ card_unitPowerKernel_coprime_mul hc) Nat.card_unique hn

/-- For an odd prime power, let E=2^(t-1)*d with odd d and t no larger than
the two-adic valuation of p-1. If p is coprime to E, its E-power kernel has
cardinality 2^(t-1)*gcd(d,oddPart(p-1)). Cancel the p-power factor and the
coprime residual power of two from the totient gcd. This is the exact local
factor in the common-sign subgroup cardinality formula. -/
theorem card_unitPowerKernel_prime_pow_twoAdic {p a t d : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ha : 0 < a) (htp : t ≤ padicValNat 2 (p - 1)) (hd : Odd d)
    (hpc : p.Coprime (2 ^ (t - 1) * d)) :
    Nat.card (powMonoidHom (2 ^ (t - 1) * d) : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).ker =
      2 ^ (t - 1) * d.gcd (Nat.divMaxPow (p - 1) 2) := by
  rw [card_unitPowerKernel_prime_pow hp hp2 ha,
    Nat.Coprime.gcd_mul_left_cancel (p - 1) (hpc.pow_left (a - 1))]
  have hbase : t - 1 ≤ padicValNat 2 (p - 1) := (Nat.sub_le t 1).trans htp
  conv_lhs => rw [← Nat.pow_padicValNat_mul_divMaxPow 2 (p - 1), ← Nat.pow_sub_mul_pow 2 hbase]
  rw [Nat.mul_comm (2 ^ (padicValNat 2 (p - 1) - (t - 1))) (2 ^ (t - 1)), Nat.mul_assoc,
    Nat.gcd_mul_left]
  rw [Nat.Coprime.gcd_mul_left_cancel (Nat.divMaxPow (p - 1) 2)
      ((Nat.coprime_two_left.mpr hd).pow_left _),
    Nat.gcd_comm]

/-- For a nonzero odd modulus with odd d, set E=2^(t-1)*d. If t is at most
every local two-adic valuation and every prime divisor is coprime to E, the
global kernel cardinality is 2^(r*(t-1)) times the product of gcd(d,oddPart(p-1)),
where r counts distinct prime divisors. Combine the local formula with CRT
multiplicativity. This is the kernel factor in the exact common-sign index formula. -/
theorem card_unitPowerKernel_factorization_twoAdic {n t d : ℕ} (hn : n ≠ 0) (hnOdd : Odd n)
    (hd : Odd d) (ht : ∀ p : ℕ, p.Prime → p ∣ n → t ≤ padicValNat 2 (p - 1))
    (hpE : ∀ p : ℕ, p.Prime → p ∣ n → p.Coprime (2 ^ (t - 1) * d)) :
    Nat.card (powMonoidHom (2 ^ (t - 1) * d) : (ZMod n)ˣ →* (ZMod n)ˣ).ker =
      2 ^ (n.primeFactors.card * (t - 1)) *
        ∏ p ∈ n.primeFactors, d.gcd (Nat.divMaxPow (p - 1) 2) := by
  have hfac := card_unitPowerKernel_factorization (E := 2 ^ (t - 1) * d) hn
  rw [Finsupp.prod, Nat.support_factorization] at hfac
  calc
    _ =
        ∏ p ∈ n.primeFactors,
          Nat.card
            (powMonoidHom (2 ^ (t - 1) * d) :
                (ZMod (p ^ n.factorization p))ˣ →* (ZMod (p ^ n.factorization p))ˣ).ker :=
      hfac
    _ = ∏ p ∈ n.primeFactors, 2 ^ (t - 1) * d.gcd (Nat.divMaxPow (p - 1) 2) := by
      apply Finset.prod_congr rfl
      intro p hpm
      obtain ⟨hp, hpd, _⟩ := Nat.mem_primeFactors.mp hpm
      exact
        card_unitPowerKernel_prime_pow_twoAdic hp (hnOdd.ne_two_of_dvd_nat hpd)
          (hp.factorization_pos_of_dvd hn hpd) (ht p hp hpd) hd (hpE p hp hpd)
    _ = _ := by
      rw [Finset.prod_mul_distrib, Finset.prod_const, ← pow_mul,
        Nat.mul_comm (t - 1) n.primeFactors.card]

/-- For nonzero n, the E-power image cardinality factors over its prime powers.
CRT gives multiplicativity at nonzero coprime factors; a zero coprime factor
forces the other modulus to one. The multiplicative factorization theorem then
gives the product. This assembles exact local image counts into subgroup indices. -/
theorem card_unitPowerImage_factorization {n E : ℕ} (hn : n ≠ 0) :
    Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range =
      n.factorization.prod fun p a ↦
        Nat.card (powMonoidHom E : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).range := by
  let f := fun n ↦ Nat.card (powMonoidHom E : (ZMod n)ˣ →* (ZMod n)ˣ).range
  have hf1 : f 1 = 1 := Nat.card_unique
  have hmul : ∀ x y : ℕ, x.Coprime y → f (x * y) = f x * f y := by
    intro x y hc
    by_cases hx : x = 0
    · subst x
      have hy := (Nat.coprime_zero_left y).mp hc
      subst y
      simp only [hf1, mul_one]
    by_cases hy : y = 0
    · subst y
      have hx := (Nat.coprime_zero_right x).mp hc
      subst x
      simp only [hf1, one_mul]
    let : NeZero x := ⟨hx⟩
    let : NeZero y := ⟨hy⟩
    exact card_unitPowerImage_coprime_mul hc
  exact Nat.multiplicative_factorization f hmul hf1 hn

/-- For E=2^(t-1)*d with odd d, positive t at most the valuation of p-1, and
p coprime to E, the power image modulo p^a has cardinality
2^(valuation(p-1)-t+1)*p^(a-1)*oddPart(p-1)/gcd(d,oddPart(p-1)).
Divide the totient by the exact kernel count, cancel the common power of two,
and retain the integer gcd quotient. This is the local factor of the MR index formula. -/
theorem card_unitPowerImage_prime_pow_twoAdic {p a t d : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ha : 0 < a) (ht0 : 0 < t) (htp : t ≤ padicValNat 2 (p - 1)) (hd : Odd d)
    (hpc : p.Coprime (2 ^ (t - 1) * d)) :
    Nat.card (powMonoidHom (2 ^ (t - 1) * d) : (ZMod (p ^ a))ˣ →* (ZMod (p ^ a))ˣ).range =
      2 ^ (padicValNat 2 (p - 1) - t + 1) *
        (p ^ (a - 1) * (Nat.divMaxPow (p - 1) 2 / d.gcd (Nat.divMaxPow (p - 1) 2))) := by
  let : NeZero (p ^ a) := ⟨pow_ne_zero a hp.ne_zero⟩
  rw [← Subgroup.index_ker, Subgroup.index_eq_card_div,
    card_unitPowerKernel_prime_pow_twoAdic hp hp2 ha htp hd hpc, Nat.card_eq_fintype_card,
    ZMod.card_units_eq_totient, Nat.totient_prime_pow hp ha]
  have hbase : t - 1 ≤ padicValNat 2 (p - 1) := (Nat.sub_le t 1).trans htp
  have hpdec :
    p - 1 = 2 ^ (t - 1) * (2 ^ (padicValNat 2 (p - 1) - (t - 1)) * Nat.divMaxPow (p - 1) 2) := by
    calc
      _ = 2 ^ padicValNat 2 (p - 1) * Nat.divMaxPow (p - 1) 2 :=
        (Nat.pow_padicValNat_mul_divMaxPow 2 (p - 1)).symm
      _ = _ := by
        rw [← Nat.pow_sub_mul_pow 2 hbase]
        ring
  have hnum :
    p ^ (a - 1) * (p - 1) =
      2 ^ (t - 1) *
        ((p ^ (a - 1) * 2 ^ (padicValNat 2 (p - 1) - (t - 1))) * Nat.divMaxPow (p - 1) 2) := by
    conv_lhs => rw [hpdec]
    ring
  rw [hnum, Nat.mul_div_mul_left _ _ (pow_pos (by decide : 0 < 2) _),
    Nat.mul_div_assoc _ (Nat.gcd_dvd_right d (Nat.divMaxPow (p - 1) 2))]
  have he : padicValNat 2 (p - 1) - (t - 1) = padicValNat 2 (p - 1) - t + 1 := by
    linarith only [Nat.sub_add_cancel htp, Nat.sub_add_cancel ht0, Nat.sub_add_cancel hbase]
  rw [he]
  ring

/-- For odd nonzero n, odd d, and positive t at most every local valuation,
with all prime factors coprime to E=2^(t-1)*d, the global image cardinality is
2^(sum(valuation(p-1)-t)+r) times the product of p^(a-1)*oddPart(p-1)/gcd(d,oddPart(p-1)).
Multiply the exact local counts through the prime factorization and collect
the powers of two. Dividing by two gives the common-sign subgroup index. -/
theorem card_unitPowerImage_factorization_twoAdic {n t d : ℕ} (hn : n ≠ 0) (hnOdd : Odd n)
    (ht0 : 0 < t) (hd : Odd d) (ht : ∀ p : ℕ, p.Prime → p ∣ n → t ≤ padicValNat 2 (p - 1))
    (hpE : ∀ p : ℕ, p.Prime → p ∣ n → p.Coprime (2 ^ (t - 1) * d)) :
    Nat.card (powMonoidHom (2 ^ (t - 1) * d) : (ZMod n)ˣ →* (ZMod n)ˣ).range =
      2 ^ ((∑ p ∈ n.primeFactors, (padicValNat 2 (p - 1) - t)) + n.primeFactors.card) *
        ∏ p ∈ n.primeFactors,
          p ^ (n.factorization p - 1) *
            (Nat.divMaxPow (p - 1) 2 / d.gcd (Nat.divMaxPow (p - 1) 2)) := by
  have hfac := card_unitPowerImage_factorization (E := 2 ^ (t - 1) * d) hn
  rw [Finsupp.prod, Nat.support_factorization] at hfac
  calc
    _ =
        ∏ p ∈ n.primeFactors,
          Nat.card
            (powMonoidHom (2 ^ (t - 1) * d) :
                (ZMod (p ^ n.factorization p))ˣ →* (ZMod (p ^ n.factorization p))ˣ).range :=
      hfac
    _ =
        ∏ p ∈ n.primeFactors,
          2 ^ (padicValNat 2 (p - 1) - t + 1) *
            (p ^ (n.factorization p - 1) *
              (Nat.divMaxPow (p - 1) 2 / d.gcd (Nat.divMaxPow (p - 1) 2))) :=
      by
      apply Finset.prod_congr rfl
      intro p hpm
      obtain ⟨hp, hpd, _⟩ := Nat.mem_primeFactors.mp hpm
      exact
        card_unitPowerImage_prime_pow_twoAdic hp (hnOdd.ne_two_of_dvd_nat hpd)
          (hp.factorization_pos_of_dvd hn hpd) ht0 (ht p hp hpd) hd (hpE p hp hpd)
    _ = _ := by
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, Finset.sum_add_distrib,
        Finset.sum_const, nsmul_eq_mul, Nat.cast_id, mul_one]

end PseudoPrime.NumberTheory
