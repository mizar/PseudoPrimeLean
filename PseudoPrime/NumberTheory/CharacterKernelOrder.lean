module

public import PseudoPrime.NumberTheory.SubgroupAnnihilator
public import PseudoPrime.NumberTheory.DirichletCharacter

/-! # The annihilator and index of a character unit kernel -/

@[expose] public section
namespace PseudoPrime.NumberTheory
/-- For a complex Dirichlet character at nonzero level, the annihilator of its
unit kernel is exactly the cyclic subgroup generated by the character. Use finite
character duality in both directions: vanishing on all powers is equivalent to
vanishing on the generator. This supplies exact finite kernel enumerations. -/
theorem kernel_annihilator_zpowers {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) :
    subgroupAnnihilator χ.toUnitHom.ker = Subgroup.zpowers χ := by
  have hc : χ ∈ subgroupAnnihilator χ.toUnitHom.ker := by
    apply (mem_subgroupAnnihilator_iff _ _).mpr
    intro u hu
    have h := congrArg Units.val (MonoidHom.mem_ker.mp hu)
    simpa only [MulChar.coe_toUnitHom,Units.val_one] using h
  have hsub : Subgroup.zpowers χ ≤ subgroupAnnihilator χ.toUnitHom.ker :=
    Subgroup.zpowers_le.mpr hc
  have hi : (MulChar.subgroupOrderIsoSubgroupMulChar (ZMod q) ℂ).symm
      (OrderDual.toDual (Subgroup.zpowers χ)) = χ.toUnitHom.ker := by
    ext u
    rw [MulChar.mem_subgroupOrderIsoSubgroupMulChar_symm_iff,MonoidHom.mem_ker]
    constructor
    · intro h
      apply Units.ext
      simpa only [MulChar.coe_toUnitHom,Units.val_one] using h χ (Subgroup.mem_zpowers χ)
    · intro h ψ hψ
      exact (mem_subgroupAnnihilator_iff _ _).mp (hsub hψ) u (MonoidHom.mem_ker.mpr h)
  unfold subgroupAnnihilator
  rw [← hi,OrderIso.apply_symm_apply]
  rfl
/-- The unit kernel of a complex character has index equal to the character's order.
Count its annihilator using finite duality, identify that annihilator with the cyclic
subgroup of powers, and use the cyclic subgroup cardinality theorem. -/
theorem index_kernel_eq_order {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) :
    χ.toUnitHom.ker.index = orderOf χ := by
  rw [← card_subgroupAnnihilator, ← Nat.card_eq_fintype_card, kernel_annihilator_zpowers,
    Nat.card_zpowers]
/-- For a complex character at nonzero level, enumerate its kernel annihilator by
exponents below its order. Compose the finite cyclic-power equivalence with the
proved annihilator equality. This is the finite sum and product indexing map. -/
noncomputable def kernelCharacterEquiv {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) :
    Fin (orderOf χ) ≃ subgroupAnnihilator χ.toUnitHom.ker :=
  (finEquivZPowers (isOfFinOrder_of_finite χ)).trans
    (Equiv.subtypeEquivRight (fun ψ ↦ by rw [kernel_annihilator_zpowers χ]))
/-- The kernel-annihilator enumeration sends exponent i to chi^i.
The subtype equivalence preserves the underlying character by definition.
This computes all terms in conductor sums and products. -/
theorem kernelCharacterEquiv_val {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (i : Fin (orderOf χ)) : ((kernelCharacterEquiv χ) i).val = χ^(i:ℕ) := by
  rfl
/-- An additive sum over the character-kernel annihilator equals the sum over
natural powers below the character order. Transport the sum through the explicit
finite equivalence. No separate classification assumption is needed. -/
theorem sum_kernel_characters {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {A : Type*} [AddCommMonoid A] (f : DirichletCharacter ℂ q → A) :
    (∑ ψ : subgroupAnnihilator χ.toUnitHom.ker, f ψ.val) =
      ∑ i : Fin (orderOf χ), f (χ^(i:ℕ)) := by
  have h := (kernelCharacterEquiv χ).sum_comp
    (fun ψ : subgroupAnnihilator χ.toUnitHom.ker ↦ f ψ.val)
  change (∑ i : Fin (orderOf χ), f (χ^(i:ℕ))) = _ at h
  exact h.symm
/-- A multiplicative product over the character-kernel annihilator equals the
product over powers below its order. Transport through the finite equivalence.
This gives the exact nonprincipal conductor product after removing the unit. -/
theorem prod_kernel_characters {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {A : Type*} [CommMonoid A] (f : DirichletCharacter ℂ q → A) :
    (∏ ψ : subgroupAnnihilator χ.toUnitHom.ker, f ψ.val) =
      ∏ i : Fin (orderOf χ), f (χ^(i:ℕ)) := by
  have h := (kernelCharacterEquiv χ).prod_comp
    (fun ψ : subgroupAnnihilator χ.toUnitHom.ker ↦ f ψ.val)
  change (∏ i : Fin (orderOf χ), f (χ^(i:ℕ))) = _ at h
  exact h.symm

end PseudoPrime.NumberTheory
