-- Combining 72 exact rational coefficient certificates requires additional elaboration steps.
/-- All coefficients in the finite weight sum have been kernel checked. -/
theorem coefficients_spec :
    ∀ j ∈ Finset.range (Analysis.rationalGaussianOrder 0 + 1),
      coefficients j =
        ((1 + (0 : ℚ) / 16) ^ j)⁻¹ *
          (∑ l ∈ Finset.Icc j (Analysis.rationalGaussianOrder 0),
            ((l.factorial : ℚ)⁻¹ *
                (((1 + ((0 + 1 : ℕ) : ℚ) / 16) - (1 + (0 : ℚ) / 16)) ^ (l + 1) / (l + 1))) *
              (l.choose j : ℚ) *
              (-(314159265358979323846264338327950288419716939937510 / 10 ^ 50 : ℚ) *
                  ((0 : ℚ) + 1) ^ 2) ^
                (l - j)) := by
  have h (i : Fin 72) :
    coefficients i.val =
      ((1 + (0 : ℚ) / 16) ^ i.val)⁻¹ *
        (∑ l ∈ Finset.Icc i.val (Analysis.rationalGaussianOrder 0),
          ((l.factorial : ℚ)⁻¹ *
              (((1 + ((0 + 1 : ℕ) : ℚ) / 16) - (1 + (0 : ℚ) / 16)) ^ (l + 1) / (l + 1))) *
            (l.choose i.val : ℚ) *
            (-(314159265358979323846264338327950288419716939937510 / 10 ^ 50 : ℚ) *
                ((0 : ℚ) + 1) ^ 2) ^
              (l - i.val)) := by
    fin_cases i
    · simpa only [coefficients, Fin.val_mk, Analysis.rationalGaussianOrder, ite_true] using
