/-- The certified coefficients evaluate the weight at every rational height. -/
theorem weight (t : ℚ) :
    certificateWeight t (1 + (0 : ℚ) / 16) (1 + ((0 + 1 : ℕ) : ℚ) / 16) 0 =
      Analysis.rationalComplexScale 2
        (∑ j ∈ Finset.range (Analysis.rationalGaussianOrder 0 + 1),
          Analysis.rationalComplexScale (coefficients j) (Analysis.rationalMellinFalling t j)) := by
  exact certificate_weight_coeffs t _ _ _ coefficients coefficients_spec

