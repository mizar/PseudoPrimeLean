        ⟨6539, 8785538969612, 8785792076558, 6525361788337810, 6526166471599467⟩ blocks =
      true := by
  decide +kernel

/-- A valid initial state gives the four-fifths psi bound on `[6539, 11539)`. -/
theorem psi_four_fifths_6539_11539
    (hs :
      PsiWalkValid 1000000000000
        ⟨6539, 8785538969612, 8785792076558, 6525361788337810, 6526166471599467⟩)
    {x : ℝ} (ha : 6539 ≤ x) (hb : x < 11539) :
    |Chebyshev.psi x - x| ≤ (4 / 5 : ℝ) * Real.sqrt x := by
  exact (psi_walk_blocks_sound hs valid checked).2 x ha hb

/-- The checked walk carries a valid state at 6539 to a valid state at 11539. -/
theorem psi_walk_11539_valid
    (hs :
      PsiWalkValid 1000000000000
        ⟨6539, 8785538969612, 8785792076558, 6525361788337810, 6526166471599467⟩) :
    PsiWalkValid 1000000000000
      ⟨11539, 9353487320088, 9353773567045, 11521522569542300, 11522476236702929⟩ := by
  exact (psi_walk_blocks_sound hs valid checked).1

end PseudoPrime.AnalyticNumberTheory.Arithmetic
