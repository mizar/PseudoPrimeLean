/-- A valid fixed-point starting state at 1539 yields the valid state at 6539
and the four-fifths square-root psi bound throughout `[1539, 6539)`. The
integer certificate is checked independently of other interval files. -/
theorem psi_walk_1539_6539
    (hs :
      PsiWalkValid 1000000000000
        ⟨1539, 7338887595015, 7338892225039, 1530963112671469, 1531658116819066⟩) :
    PsiWalkValid 1000000000000
        ⟨6539, 8785538969612, 8785792076558, 6525361788337810, 6526166471599467⟩ ∧
      ∀ x : ℝ, 1539 ≤ x → x < 6539 → |Chebyshev.psi x - x| ≤ (4 / 5 : ℝ) * Real.sqrt x := by
  exact psi_walk_blocks_sound hs valid checked

