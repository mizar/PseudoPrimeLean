/-- The sum of the signed ordinate bounds and curvature costs fits inside 2513/5000. -/
private theorem phaseThirdBlock_budgets :
    ∀ j : ℕ,
      j ≤ 31 →
        rationalOrdinateBudgetCheck (2513 / 5000) 21 phase1381Lower phase1381Upper
            (phaseThirdBlockLower j) (phaseThirdBlockUpper j) =
