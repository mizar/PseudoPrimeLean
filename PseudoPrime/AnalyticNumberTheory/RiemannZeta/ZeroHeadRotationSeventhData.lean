/-- The sum of the signed ordinate bounds and curvature costs fits inside 1/2. -/
private theorem phaseSeventhBlock_budgets :
    ∀ j : ℕ,
      j ≤ 31 →
        rationalOrdinateBudgetCheck (1 / 2) 21 phase1381Lower phase1381Upper
            (phaseSeventhBlockLower j) (phaseSeventhBlockUpper j) =
          true := by
  intro j hj
  interval_cases j <;> decide +kernel

