/-- All 145 sequential walks pass the first eight logarithmic nodes. -/
private theorem phaseFirstBlock_walks :
    ∀ (i : Fin 29) (k : ℕ),
      k ≤ 4 →
        rotationOrdinateGridCheck (1381 / 100)
            (phase1381Lower i + (k : ℚ) * (phase1381Upper i - phase1381Lower i) / 4)
            (fun j ↦ phaseFirstBlockLower j i) (fun j ↦ phaseFirstBlockUpper j i) 7 =
          true := by
  intro i k hk
  fin_cases i <;> interval_cases k <;> decide +kernel

/-- The sum of the signed ordinate bounds and curvature costs fits inside 1/2. -/
private theorem phaseFirstBlock_budgets :
    ∀ j : ℕ,
      j ≤ 7 →
        rationalOrdinateBudgetCheck (1 / 2) 21 phase1381Lower phase1381Upper
            (phaseFirstBlockLower j) (phaseFirstBlockUpper j) =
          true := by
  intro j hj
  interval_cases j <;> decide +kernel

