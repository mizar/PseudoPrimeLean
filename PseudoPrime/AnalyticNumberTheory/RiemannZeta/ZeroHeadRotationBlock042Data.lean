/-- The sum of the signed ordinate bounds and curvature costs fits inside 3/5. -/
private theorem phaseBlock042Block_budgets :
    ∀ j : ℕ,
      j ≤ 31 →
        rationalOrdinateBudgetCheck (3 / 5) 21 phase1381Lower phase1381Upper
            (phaseBlock042BlockLower j) (phaseBlock042BlockUpper j) =
          true := by
  intro j hj
  interval_cases j <;> decide +kernel

