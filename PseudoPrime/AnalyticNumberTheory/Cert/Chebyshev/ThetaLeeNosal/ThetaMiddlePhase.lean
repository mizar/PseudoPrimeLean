/-- The lower phase bound on the full integer-endpoint band. -/
public theorem theta_lower_middle_phase (hRH : RiemannHypothesis) {x : ℝ} (hx : 3593341184 ≤ x)
    (hy : x ≤ 7657341184) :
    (x - Chebyshev.theta x) / Real.sqrt x ≤
      Real.log x * (Real.log x - Real.log (Real.log x)) / (8 * Real.pi) := by
  have hp : 0 < x := lt_of_lt_of_le (by norm_num only) hx
  have hl :=
    PseudoPrime.Analysis.rationalLogIntervalCheck_sound
      (show
        PseudoPrime.Analysis.rationalLogIntervalCheck 3593341184 32 20 (220023481 / 10000000)
            (55005871 / 2500000) =
          true
        from by decide +kernel)
  have hr :=
    PseudoPrime.Analysis.rationalLogIntervalCheck_sound
      (show
        PseudoPrime.Analysis.rationalLogIntervalCheck 7657341184 33 20 (45517861 / 2000000)
            (56897327 / 2500000) =
          true
        from by decide +kernel)
  have hle : ((220023481 / 10000000) : ℚ) ≤ (Real.log 3593341184 : ℝ) := by
    simpa only [Rat.cast_ofNat] using hl.1
  have hre : Real.log 7657341184 ≤ (((56897327 / 2500000) : ℚ) : ℝ) := by
    simpa only [Rat.cast_ofNat] using hr.2
  have h :=
    lowerBand hRH (Real.log x)
      ⟨hle.trans (Real.log_le_log (by norm_num only) hx), (Real.log_le_log hp hy).trans hre⟩
  simpa only [Real.exp_log hp] using h

/-- The signed phase estimate supplies the numeric entrance bound for a direct restart. -/
public theorem theta_middle_restart (hRH : RiemannHypothesis) :
    7400892300 ≤ Chebyshev.theta 7402389760 := by
  have hlog :=
    PseudoPrime.Analysis.rationalLogIntervalCheck_sound
      (show
        PseudoPrime.Analysis.rationalLogIntervalCheck 7402389760 33 20 (113625343 / 5000000)
            (227250689 / 10000000) =
          true
        from by decide +kernel)
  have hp : (0 : ℝ) < 7402389760 := by norm_num only
  have hle : (((113625343 / 5000000) : ℚ) : ℝ) ≤ Real.log 7402389760 := by
    simpa only [Rat.cast_ofNat] using hlog.1
  have hre : Real.log 7402389760 ≤ (((227250689 / 10000000) : ℚ) : ℝ) := by
    simpa only [Rat.cast_ofNat] using hlog.2
  have h := restartCap hRH (Real.log 7402389760) ⟨hle, hre⟩
  rw [Real.exp_log hp, div_le_iff₀ (Real.sqrt_pos.mpr hp)] at h
  have hs : Real.sqrt 7402389760 ≤ (43018571 / 500) := by
    apply Real.sqrt_le_iff.mpr
    constructor <;> norm_num only
  have hn : (0 : ℝ) ≤ (8701861 / 500000) := by norm_num only
  have hb : (7400892300 : ℝ) + (8701861 / 500000) * (43018571 / 500) ≤ 7402389760 := by
    norm_num only
  linarith only [h, mul_le_mul_of_nonneg_left hs hn, hb]

