  have hb : (right48 : ℝ) ≤ 27 := by exact_mod_cast (by decide +kernel : right48 ≤ (27 : ℚ))
  have hg :=
    AnalyticNumberTheory.RiemannZeta.theta_phase_error hRH ha hb hL (ledger48 hRH L hL)
      (defect48 L hL.1)
  dsimp only [heights] at hg
  let c :=
    (right48 : ℝ) / 2 - (0.6931471803 + 2 * 1.0986122885 + 1 - 18 / ((left48 : ℝ) * (6283 / 8000)))
  have hc :
    (right48 : ℝ) / 8 + 7 / 50000 + 529495 / 1000000 + 3640 * (1 / 999) ^ 2 / 24 +
        ((c ^ 2 + 2 * c + 2) / (6283 / 1000) - 143 / 125) ≤
      (17775999 / 1000000) - (10268427247 / 10000000000) := by
    norm_num only [c, right48, left48, Rat.cast_div, Rat.cast_ofNat]
  dsimp only [c] at hc
  linarith only [hg, hm, hc, coefficient48 L hL.1]

/-- Join the adjacent lower bounds on their closed logarithmic interval. -/
private theorem lowerBand (hRH : RiemannHypothesis) (L : ℝ)
