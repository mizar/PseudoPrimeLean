private theorem caps_size : endpointCaps.size = 320 := by decide +kernel

/-- Outward upper bounds in millionths for the shifted left and right phase samples. -/
public def phaseCaps (i : Fin 320) : ℚ × ℚ :=
  let p := endpointCaps[i.val]'(caps_size.symm ▸ i.isLt)
  ((p.1 : ℚ) / 1000000, (p.2 : ℚ) / 1000000)

/-- All generated cells have residual slack at least 9/1000 after rounding. -/
public theorem phaseCells_slack (i : Fin 320) :
    (9 / 1000 : ℚ) ≤
      phaseCellSlack (phaseTick i.castSucc / 512) (phaseTick i.succ / 512) (phaseCaps i).1
        (phaseCaps i).2 := by
  exact
    (show
        ∀ j : Fin 320,
          (9 / 1000 : ℚ) ≤
            phaseCellSlack (phaseTick j.castSucc / 512) (phaseTick j.succ / 512) (phaseCaps j).1
              (phaseCaps j).2
        from by decide +kernel)
      i

