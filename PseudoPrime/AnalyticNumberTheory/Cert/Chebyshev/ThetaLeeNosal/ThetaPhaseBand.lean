private theorem smoothed46 (L : ℝ) (hL : L ∈ Set.Icc (left46 : ℝ) (right46 : ℝ)) :
    let D : ℝ := delta46;
    -moments heights (L + Real.log (1 - L / Real.exp (L / 2) / 4 / 2)) 0 ≤
      107 / 256 + heights.sum * ((right46 : ℝ) - left46) ^ 2 / 4 + 58 * (D / (2 - D)) := by
  have ha : (2 : ℚ) ≤ left46 := by decide +kernel
  have hd : 0 ≤ delta46 := by decide +kernel
  have hd1 : delta46 < 1 := by decide +kernel
  have cap := cap_of_ticks left46 delta46 (by decide +kernel) hd (by decide +kernel)
  have hx := smooth_mem (by exact_mod_cast ha) hL cap (by exact_mod_cast hd1)
  have h : (delta46 : ℝ) < 1 := by exact_mod_cast hd1
  exact shifted46 _ _ (div_nonneg (by exact_mod_cast hd) (by linarith only [h])) hx

private theorem boxed46 (gs : List ℝ) (hg : List.Forall₂ inside gs heights) (L : ℝ)
    (hL : L ∈ Set.Icc (left46 : ℝ) (right46 : ℝ)) :
    let D : ℝ := delta46;
    let t := L + Real.log (1 - L / Real.exp (L / 2) / 4 / 2);
    -moments gs t 0 ≤
      107 / 256 + heights.sum * ((right46 : ℝ) - left46) ^ 2 / 4 + 58 * (D / (2 - D)) +
        boxCost heights right46 := by
  have ha : (2 : ℝ) ≤ left46 := by exact_mod_cast (by decide +kernel : (2 : ℚ) ≤ left46)
  have hd : (delta46 : ℝ) < 1 := by exact_mod_cast (by decide +kernel : delta46 < 1)
  have cap :=
    cap_of_ticks left46 delta46 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hx := smooth_mem ha hL cap hd
  have hfrac : (delta46 : ℝ) / (2 - delta46) ≤ 1 :=
    (div_le_one (by linarith only [hd])).mpr (by linarith only [hd])
  have ht := abs_le.mpr ⟨by linarith only [hx.1, hx.2, ha, hfrac], hx.2⟩
  exact (boxed_moments hg ht).trans (add_le_add (smoothed46 L hL) (le_refl _))

private theorem midpoint46 (g : Fin 29 → ℝ) (hg : List.Forall₂ inside (List.ofFn g) heights) (L : ℝ)
    (hL : L ∈ Set.Icc (left46 : ℝ) (right46 : ℝ)) :
    let x := Real.exp L
    let u := L / Real.exp (L / 2) / 4
    let t := (x - x * u + x) / 2
    let D : ℝ := delta46;
    0 < t ∧
      AnalyticNumberTheory.RiemannZeta.zeroHeadPhase g (Real.log t) ≤
        107 / 256 + heights.sum * ((right46 : ℝ) - left46) ^ 2 / 4 + 58 * (D / (2 - D)) +
          boxCost heights right46 := by
  have ha : (2 : ℝ) ≤ left46 := by exact_mod_cast (by decide +kernel : (2 : ℚ) ≤ left46)
  have hd : (delta46 : ℝ) < 1 := by exact_mod_cast (by decide +kernel : delta46 < 1)
  have cap :=
    cap_of_ticks left46 delta46 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hu :=
    (div_le_div_of_nonneg_right (ratio_le_left ha hL.1) (by norm_num only : (0 : ℝ) ≤ 4)).trans cap
