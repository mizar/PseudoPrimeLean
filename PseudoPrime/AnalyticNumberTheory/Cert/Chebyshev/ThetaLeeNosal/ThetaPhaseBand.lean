private theorem lowerCell0 (hRH : RiemannHypothesis) (L : ℝ)
    (hL : L ∈ Set.Icc (left0 : ℝ) (right0 : ℝ)) :
    (Real.exp L - Chebyshev.theta (Real.exp L)) / Real.sqrt (Real.exp L) ≤
      L * (L - Real.log L) / (8 * Real.pi) := by
