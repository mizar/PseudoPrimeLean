/-- The lower phase bound on the full integer-endpoint band. -/
public theorem theta_lower_phase_band (hRH : RiemannHypothesis) {x : ℝ} (hx : 8000000000 ≤ x)
    (hy : x ≤ 279000000000) :
    (x - Chebyshev.theta x) / Real.sqrt x ≤
      Real.log x * (Real.log x - Real.log (Real.log x)) / (8 * Real.pi) :=
  theta_lower_phase_interval (lowerBand hRH) hx hy

