/-! # Indexed endpoint certificates for the entire phase grid -/

namespace PseudoPrime.AnalyticNumberTheory.Cert.Chebyshev.ThetaLeeNosal

private theorem transportNodes {a b c d a' b' c' d' : ℚ}
    (h : RiemannZeta.sincPhaseUpper a ≤ c ∧ RiemannZeta.sincPhaseUpper b ≤ d)
    (e : (a, b, c, d) = (a', b', c', d')) :
    RiemannZeta.sincPhaseUpper a' ≤ c' ∧ RiemannZeta.sincPhaseUpper b' ≤ d' := by
  cases e
  exact h

/-- Both shifted endpoint certificates for any cell of the generated grid. -/
public theorem phaseNodes_bounds (i : Fin 320) :
    RiemannZeta.sincPhaseUpper (phaseTick i.castSucc / 512 - 1 / 2800) ≤ (phaseCaps i).1 ∧
