/-! # Rational polynomial majorant for the inverse square root

Generated by `PseudoPrimeWork/tools/gamma_mass_polynomial_certificate.py`.
Exact rational identities and nonnegative Bernstein coefficients prove the
inverse-square-root majorant used in the gamma mass integral.
-/

@[expose] public section

namespace PseudoPrime.Analysis

/-- Rational polynomial majorant for the inverse square root on `[0,1]`.
Expand a degree-ten half-power approximation about the midpoint and add
a rational slack. Bernstein certificates below verify the majorant.
It gives a finite exponential majorant for gamma-kernel mass. -/
noncomputable def invSqrtOneAddPolynomial (z : ℝ) : ℝ :=
  (9674845406880264809 / 9674588160000000000) * z ^ 0 +
    (-1934817422464003 / 3869835264000000) * z ^ 1 +
    (161124788430529 / 429981696000000) * z ^ 2 +
    (-5010400364123 / 16124313600000) * z ^ 3 +
    (8570206442567 / 32248627200000) * z ^ 4 +
    (-2982834188873 / 13436928000000) * z ^ 5 +
    (6816834656863 / 40310784000000) * z ^ 6 +
    (-543746993647 / 5038848000000) * z ^ 7 +
    (69938683529 / 1343692800000) * z ^ 8 +
    (-1984904207 / 120932352000) * z ^ 9 +
    (37713179933 / 15116544000000) * z ^ 10

/-- Signed rational monomial coefficients of the same polynomial.
These coefficients evaluate the finite exponential integral term by term.
Their agreement with the polynomial is certified below. -/
def invSqrtOneAddMonomialCoefficients : List ℚ :=
